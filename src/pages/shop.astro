      <div class="grid tier-grid">
        <article class="tier-card">
          <h3 class="tier-name">Essentials</h3>
          <p class="tier-price">Est. $20-$45</p>
          <ul class="tier-list list-clean">
            <li>Tees and caps</li>
            <li>Everyday colorways</li>
            <li>Fast restocks</li>
          </ul>
        </article>
        <article class="tier-card">
          <h3 class="tier-name">Premium</h3>
          <p class="tier-price">Est. $50-$85</p>
          <ul class="tier-list list-clean">
            <li>Hoodies and jackets</li>
            <li>Custom trims</li>
            <li>Limited runs</li>
          </ul>
        </article>
        <article class="tier-card">
          <h3 class="tier-name">Limited</h3>
          <p class="tier-price">Est. $90+</p>
          <ul class="tier-list list-clean">
            <li>Numbered drops</li>
            <li>Signed inserts</li>
            <li>Collector extras</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Community Section -->
    <section class="shop-section community-strip" data-animate="fade-up">
      <div class="community-content">
        <div class="community-avatars" aria-hidden="true">
          <span class="social-avatar-gradient"></span>
          <span class="social-avatar-gradient"></span>
          <span class="social-avatar-gradient"></span>
          <span class="social-avatar-gradient"></span>
        </div>
        <div class="community-text">
          <h2 class="shop-section-title">Join the Beam</h2>
          <p class="shop-section-subtitle">Early access, behind-the-scenes drops, and fan-only bundles.</p>
        </div>
      </div>
      <div class="community-stats">
        <div class="community-stat">
          <span class="community-stat-number">32k</span>
          <span class="community-stat-label">Listeners</span>
        </div>
        <div class="community-stat">
          <span class="community-stat-number">8k</span>
          <span class="community-stat-label">Followers</span>
        </div>
        <div class="community-stat">
          <span class="community-stat-number">120+</span>
          <span class="community-stat-label">Cities</span>
        </div>
      </div>
      <a class="cta-button" href="#shop-updates" aria-label="Get shop alert notifications">Get shop alerts</a>
    </section>

    <!-- FAQ -->
    <section class="shop-section" data-animate="fade-up">
      <div class="shop-section-header">
        <h2 class="shop-section-title">FAQ</h2>
        <p class="shop-section-subtitle">Quick answers before the store opens.</p>
      </div>
      <div class="faq-list">
        <details class="faq-item">
          <summary>When does the store open?</summary>
          <p>The first drop is planned for sometime in 2026. Join the email list to be the first to know when we have an exact date.</p>
        </details>
        <details class="faq-item">
          <summary>Will there be international shipping?</summary>
          <p>Yes. The first wave will focus on North America with expanded regions after.</p>
        </details>
        <details class="faq-item">
          <summary>How do I pick my size?</summary>
          <p>Each drop includes a size guide. Most fits run true to size.</p>
        </details>
        <details class="faq-item">
          <summary>Can I bundle items?</summary>
          <p>Bundles are planned for select drops and include exclusive add-ons.</p>
        </details>
      </div>
    </section>

    <!-- Product Filter Tabs -->
    <section class="shop-section" data-animate="fade-up">
      <div class="shop-section-header">
        <h2 class="shop-section-title">Browse by Category</h2>
        <p class="shop-section-subtitle">Filter products by type.</p>
      </div>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; margin-top: 2rem;">
        {productCategories.map((cat) => (
          <button class="filter-tab" style="padding: 1rem 2rem; background: rgba(0,0,0,0.3); border: 2px solid transparent; border-radius: 12px; cursor: pointer; transition: all 0.3s ease; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;" data-filter={cat.filter}>
            <span style="font-size: 1.5rem;">{cat.icon}</span>
            <span style="font-weight: 600; font-size: 0.875rem;">{cat.name}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Size Guide Section -->
    <section class="shop-section" data-animate="fade-up">
      <div class="shop-section-header">
        <h2 class="shop-section-title">Size Guide</h2>
        <p class="shop-section-subtitle">Find your perfect fit.</p>
      </div>
      <div class="premium-glass-card" style="max-width: 700px; margin: 2rem auto; padding: 2rem; overflow-x: auto;">
        <h3 style="text-align: center; margin-bottom: 1.5rem; font-weight: 600;">T-Shirts (Unisex)</h3>
        <table style="width: 100%; border-collapse: collapse; text-align: center;">
          <thead>
            <tr style="border-bottom: 2px solid rgba(255,255,255,0.2);">
              <th style="padding: 1rem; font-weight: 700;">Size</th>
              <th style="padding: 1rem; font-weight: 700;">Chest</th>
              <th style="padding: 1rem; font-weight: 700;">Length</th>
              <th style="padding: 1rem; font-weight: 700;">Shoulder</th>
            </tr>
          </thead>
          <tbody>
            {sizeGuide.tees.map((row, i) => (
              <tr style={`border-bottom: 1px solid rgba(255,255,255,0.1); ${i % 2 === 0 ? 'background: rgba(0,0,0,0.2);' : ''}`}>
                <td style="padding: 0.75rem; font-weight: 600; color: var(--jazer-cyan);">{row.size}</td>
                <td style="padding: 0.75rem;">{row.chest}</td>
                <td style="padding: 0.75rem;">{row.length}</td>
                <td style="padding: 0.75rem;">{row.shoulder}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p style="text-align: center; margin-top: 1.5rem; font-size: 0.875rem; color: var(--text-muted);">💡 Tip: For oversized fit, size up. For fitted look, go true to size.</p>
      </div>
    </section>

    <!-- Customer Reviews -->
    <section class="shop-section" data-animate="fade-up">
      <div class="shop-section-header">
        <h2 class="shop-section-title">Community Hype</h2>
        <p class="shop-section-subtitle">What fans are saying about the upcoming drop.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2rem;">
        {reviews.map((review, index) => (
          <div class="premium-card" style="padding: 2rem;" data-animate="fade-up" data-animate-delay={index * 100}>
            <div style="display: flex; gap: 0.25rem; margin-bottom: 1rem;">
              {[...Array(review.rating)].map(() => (
                <span style="color: #f59e0b;">⭐</span>
              ))}
            </div>
            <p style="font-style: italic; line-height: 1.6; margin-bottom: 1rem;">"{review.text}"</p>
            <div style="display: flex; justify-content: space-between; font-size: 0.875rem;">
              <span style="font-weight: 600;">{review.name}</span>
              <span style="color: var(--text-muted);">{review.date}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Shipping Information -->
    <section class="shop-section" data-animate="fade-up">
      <div class="shop-section-header">
        <h2 class="shop-section-title">Shipping Info</h2>
        <p class="shop-section-subtitle">Worldwide delivery planned for launch.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 2rem;">
        {shippingInfo.map((info, index) => (
          <div class="premium-card" style="padding: 1.5rem; text-align: center;" data-animate="fade-up" data-animate-delay={index * 100}>
            <h4 style="font-weight: 700; margin-bottom: 0.5rem;">{info.region}</h4>
            <p style="font-size: 0.875rem; color: var(--jazer-cyan); margin-bottom: 0.25rem;">{info.time}</p>
            <p style="font-size: 0.813rem; color: var(--text-muted);">{info.cost}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Wishlist Feature -->
    <section class="shop-section" data-animate="fade-up">
      <div class="premium-glass-card" style="max-width: 600px; margin: 0 auto; padding: 3rem; text-align: center;">
        <div style="font-size: 3rem; margin-bottom: 1rem;">💜</div>
        <h2 class="shop-section-title">Create Your Wishlist</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">Save items you want and get notified when they drop.</p>
        <button class="cta-button" style="margin: 0 auto;">
          <span>📋</span>
          <span>Start Wishlist</span>
        </button>
        <p style="font-size: 0.813rem; color: var(--text-muted); margin-top: 1rem;">Feature available at shop launch</p>
      </div>
    </section>

  </div>

  <!-- Email Signup CTA -->
  <JoinBeamCTA
    sectionStyle="padding: 6rem 0; background: rgba(0,0,0,0.2);"
    captureStyle="max-width: 700px; margin: 0 auto;"
    subtitleStyle="font-size: 1.125rem; max-width: 500px; margin: 1.5rem auto;"
    subject="New subscriber from JaZeR Shop page"
    buttonLabel="Get Shop Alerts"
    proofText="Join <strong>500+</strong> fans waiting for the drop"
  >
    <Fragment slot="subtitle">
      Be the first to hear about new merch drops, exclusive bundles, and <strong>early access</strong>.
    </Fragment>
  </JoinBeamCTA>

</BaseLayout>
