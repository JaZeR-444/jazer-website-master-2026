---
<BaseLayout
  bodyClass="has-announcement music-page"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/music-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Music - JaZeR</title>
    <meta name="title" content="Music - JaZeR" />
    <meta
      name="description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links. Listen now on Spotify, Apple Music, and all major platforms."
    />
    <meta
      name="keywords"
      content="JaZeR, music, releases, discography, electronic music, streaming, Spotify, Apple Music, hip-hop, rap, melodic"
    />
    <meta name="author" content="JaZeR" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Music - JaZeR" />
    <meta
      property="og:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="og:image"
      content={ogImage}
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content="Music - JaZeR" />
    <meta
      property="twitter:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="twitter:image"
      content={ogImage}
    />

    <link rel="canonical" href={canonical} />
    
    <style>
      .music-hero-section {
          min-height: 85vh;
          display: flex;
          align-items: center;
          position: relative;
          background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.1), transparent 60%),
                      radial-gradient(circle at bottom left, rgba(6, 182, 212, 0.1), transparent 60%);
          overflow: hidden;
      }

      /* Sonic Waveform Background */
      .sonic-waveform-bg {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0.1;
          pointer-events: none;
          z-index: 0;
      }
      .waveform-line {
          width: 4px;
          height: 100px;
          margin: 0 2px;
          background: var(--jazer-cyan);
          border-radius: 2px;
          animation: sonicPulse 2s ease-in-out infinite;
          animation-delay: calc(var(--i) * 0.05s);
      }
      @keyframes sonicPulse {
          0%, 100% { height: 10%; opacity: 0.2; }
          50% { height: 80%; opacity: 0.8; }
      }

      .music-hero-content {
          z-index: 2;
          max-width: 600px;
      }

      .hero-eyebrow {
          font-family: 'Courier New', monospace;
          color: var(--jazer-cyan);
          font-size: 0.875rem;
          margin-bottom: 1rem;
          letter-spacing: 0.05em;
          display: flex;
          align-items: center;
          gap: 0.5rem;
      }
      .eyebrow-dot {
          width: 8px; height: 8px;
          background: var(--jazer-cyan);
          box-shadow: 0 0 8px var(--jazer-cyan);
          border-radius: 50%;
      }

      .music-hero-title-graphic {
          margin-bottom: 1.5rem;
          display: flex;
      }
      .music-hero-title-graphic img {
          width: 100%;
          max-width: 450px;
          height: auto;
          display: block;
          filter: drop-shadow(0 0 20px rgba(6, 182, 212, 0.3));
      }

      /* Holographic Disc */
      .holographic-disc-container {
          perspective: 1000px;
          display: flex;
          justify-content: center;
          align-items: center;
      }
      .holographic-disc {
          width: 400px;
          height: 400px;
          border-radius: 50%;
          background: 
              conic-gradient(from 0deg, transparent 0%, rgba(255,255,255,0.1) 20%, transparent 40%),
              radial-gradient(circle at center, #000 25%, #111 26%, #222 65%, rgba(6,182,212,0.2) 66%, transparent 70%);
          position: relative;
          box-shadow: 0 0 50px rgba(139, 92, 246, 0.2);
          animation: discSpin 20s linear infinite;
          transform-style: preserve-3d;
          border: 1px solid rgba(255,255,255,0.1);
      }
      .disc-reflection {
          position: absolute;
          inset: 0;
          border-radius: 50%;
          background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
          animation: reflectionMove 5s ease-in-out infinite;
      }
      .disc-art {
          position: absolute;
          top: 50%; left: 50%;
          transform: translate(-50%, -50%);
          width: 250px; height: 250px;
          border-radius: 50%;
          object-fit: cover;
          box-shadow: 0 0 30px rgba(0,0,0,0.8);
          z-index: 2;
      }
      @keyframes discSpin { from { transform: rotate(0deg) rotateX(10deg); } to { transform: rotate(360deg) rotateX(10deg); } }
      @keyframes reflectionMove { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.7; } }

      /* Portal Cards (Streaming) */
      .portal-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
          gap: 1.5rem;
          margin-top: 3rem;
      }
      .portal-card {
          position: relative;
          padding: 1.5rem;
          background: rgba(10, 10, 20, 0.8);
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 12px;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 1rem;
          overflow: hidden;
          transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
          text-decoration: none;
      }
      .portal-card::before {
          content: '';
          position: absolute;
          inset: 0;
          background: radial-gradient(circle at center, var(--hover-color), transparent 70%);
          opacity: 0;
          transition: opacity 0.3s ease;
      }
      .portal-card:hover {
          transform: translateY(-5px) scale(1.02);
          border-color: rgba(255,255,255,0.3);
      }
      .portal-card:hover::before { opacity: 0.15; }
      
      .portal-icon { width: 40px; height: 40px; z-index: 1; filter: invert(1); }
      .portal-name { font-size: 0.875rem; font-weight: 600; color: white; z-index: 1; }

      /* Featured Track Section */
      .featured-track-container {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 3rem;
        align-items: center;
        padding: 3rem;
      }
      .featured-track-visual {
        display: flex;
        justify-content: center;
      }
      .featured-track-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .featured-meta-row {
        display: flex;
        gap: 1rem;
        margin: 1rem 0;
        flex-wrap: wrap;
      }

      /* Responsive */
      @media (max-width: 992px) {
          .music-hero-container { grid-template-columns: 1fr; text-align: center; }
          .music-hero-content { margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
          .hero-eyebrow { justify-content: center; }
          .music-hero-title-graphic { justify-content: center; }
          .holographic-disc { width: 300px; height: 300px; margin: 3rem auto; }
          .disc-art { width: 180px; height: 180px; }
          
          .featured-track-container {
            grid-template-columns: 1fr;
            gap: 2rem;
            text-align: center;
            padding: 2rem;
          }
          .featured-track-info {
            align-items: center;
          }
          .featured-meta-row {
            justify-content: center;
          }
           .music-hero-section { min-height: auto; padding: 6rem 0 4rem; }
      }

      @media (max-width: 768px) {
          .music-hero-section { min-height: auto; padding: 4rem 0 3rem; }
          .music-hero-title-graphic img { max-width: 280px; }
          .portal-grid { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); width: 100%; }
          .holographic-disc { width: 220px; height: 220px; margin: 2rem auto; }
          .disc-art { width: 130px; height: 130px; }
          .music-hero-description { font-size: 1rem; padding: 0 1rem; }
          
          .featured-track-container {
            padding: 1.5rem;
          }
          .featured-header {
             display: flex;
             justify-content: center;
          }
      }

      /* System Button */
      .system-button {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.75rem 1.5rem;
          background: rgba(6, 182, 212, 0.1);
          border: 1px solid var(--jazer-cyan);
          color: var(--jazer-cyan);
          font-weight: 600;
          font-size: 0.875rem;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          border-radius: 4px;
          cursor: pointer;
          transition: all 0.3s ease;
      }
      .system-button:hover {
          background: var(--jazer-cyan);
          color: #000;
          box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
      }
      .system-button img {
          filter: invert(36%) sepia(93%) saturate(1836%) hue-rotate(162deg) brightness(94%) contrast(101%); /* cyan filter equivalent or use mask */
          transition: filter 0.3s ease;
      }
      .system-button:hover img {
          filter: invert(0);
      }

      /* Transmission End Divider */
      .transmission-end {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 1rem;
          padding: 2rem 0 4rem;
          color: rgba(255, 255, 255, 0.3);
          font-family: 'Courier New', monospace;
          letter-spacing: 0.2em;
          font-size: 0.75rem;
          text-transform: uppercase;
      }
      .transmission-line {
          height: 1px;
          width: 100px;
          background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      }
    </style>
  </Fragment>

  <!-- Hero Section -->
  <section class="music-hero-section">
    <div class="sonic-waveform-bg" aria-hidden="true">
      {[...Array(10)].map((_, i) => (
        <div class="waveform-line" style={`--i: ${i + 1}`}></div>
      ))}
    </div>

    <div class="container music-hero-container">
      <div class="music-hero-content" data-animate="fade-right">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>SONIC DATABANK // V.2026</span>
        </div>
        <div class="music-hero-title-graphic">
          <img 
            src={`${base}assets/images/Transmission Incoming (429 x 150 px).svg`} 
            alt="Transmission Incoming" 
            width="429" 
            height="150"
            loading="eager"
            decoding="async"
          />
        </div>
        <p class="music-hero-description">
          The first wave of the JaZeR sound arrives in 2026. Join the beam to be the first to know.
        </p>
        
        <!-- Quick Navigation -->
        <div class="hero-nav-links" style="display: flex; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap;">
          <a href="#coming-2026" class="system-button">Coming 2026</a>
          <a href="#platforms" class="system-button" style="background: transparent;">Platforms</a>
          <a href="#join-beam" class="system-button" style="background: transparent;">Get Notified</a>
        </div>
      </div>

      <div class="music-hero-visual" data-animate="fade-left">
        <div class="holographic-disc-container">
          <div class="holographic-disc">
            <div class="disc-reflection"></div>
            <img src={`${base}assets/images/jazer-cosmic-soundbirth.png`} alt="JaZeR Cosmic Soundbirth artwork" class="disc-art" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Currently Available Section (Empty State) -->
  <section class="section" style="padding: 4rem 0;">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Currently Available</h2>
      </div>
      
      <div class="premium-glass-card" style="max-width: 600px; margin: 2rem auto; padding: 3rem; text-align: center;" data-animate="fade-up">
        <div style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.6;">🎵</div>
        <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem;">No Public Releases Yet</h3>
        <p style="color: var(--text-muted); margin-bottom: 1.5rem; max-width: 400px; margin-left: auto; margin-right: auto;">
          The catalog is being built. First releases expected in 2026.
        </p>
        <a href="#join-beam" class="cta-button" style="display: inline-flex;">
          <span>Get Notified When Music Drops</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Coming in 2026 Section -->
  <section id="coming-2026" class="discography-section section" style="scroll-margin-top: 100px;">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Coming in 2026</h2>
        <p class="section-subtitle">The transmission log — releases in development</p>
      </div>
      
      <div class="discography-grid">
        {upcomingReleases.map((release, index) => (
          <article class="release-card" data-animate="fade-up" style={`--delay: ${index * 0.1}s`}>
            <div class="release-cover">
              <div class={`cover-placeholder ${release.gradient}`} aria-hidden="true"></div>
              <div class="status-overlay" aria-hidden="true">
                <span class="status-badge">{release.status}</span>
              </div>
            </div>
            <div class="release-details">
              <h3 class="release-title">{release.title}</h3>
              <p class="release-meta">{release.type} • 2026</p>
              <a href="#join-beam" class="release-link">
                Get Notified <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      
      <div style="text-align: center; margin-top: 2rem;" data-animate="fade-up">
        <p style="color: var(--text-muted); font-size: 0.875rem;">
          Release schedule: TBD — Updates will be shared when available
        </p>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Streaming Platforms -->
  <section id="platforms" class="streaming-section section-sm" style="scroll-margin-top: 100px;">
    <div class="container">
      <div class="streaming-platforms" data-animate="fade-up">
        <h2 class="streaming-platforms-title text-center">Streaming Platforms</h2>
        <p style="text-align: center; color: var(--text-muted); margin-bottom: 2rem;">
          Music will be available on all major platforms when released
        </p>
        <div class="portal-grid">
          {streamingPlatforms.map((platform) => (
            <a 
              href={platform.href} 
              class="portal-card" 
              style={`--hover-color: ${platform.color};`}
              aria-label={`${platform.name} - Coming soon`}
            >
              <img 
                src={`${base}assets/images/icons/${platform.isRound ? 'social' : 'music'}/${platform.icon}`} 
                alt="" 
                class="portal-icon" 
                loading="lazy" 
              />
              <span class="portal-name">{platform.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- FAQ Section -->
  <section class="section" style="padding: 4rem 0; background: rgba(0,0,0,0.2);">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Frequently Asked Questions</h2>
      </div>
      
      <div style="max-width: 700px; margin: 2rem auto;">
        {faqItems.map((item, index) => (
          <div class="premium-card" style="padding: 1.5rem 2rem; margin-bottom: 1rem;" data-animate="fade-up" data-animate-delay={index * 100}>
            <h3 style="font-weight: 700; font-size: 1rem; margin-bottom: 0.75rem; color: var(--jazer-cyan);">
              {item.question}
            </h3>
            <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.938rem;">
              {item.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
