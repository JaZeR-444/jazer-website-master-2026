---
const { base = import.meta.env.BASE_URL } = Astro.props;
---

<section class="videos-hero relative overflow-hidden py-32 min-h-[60vh] flex items-center justify-center">
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--jazer-purple-dark)_0%,_var(--bg-dark)_70%)] opacity-40"></div>
    <div class="noise-overlay opacity-30"></div>
  </div>

  <div class="container relative z-10 text-center px-4">
    <div class="hero-eyebrow mb-6 animate-fade-up" style="animation-delay: 0.1s;">
      <span class="inline-block px-3 py-1 rounded-full border border-[rgba(255,255,255,0.1)] bg-[rgba(0,0,0,0.3)] text-xs tracking-[0.2em] uppercase text-[var(--jazer-cyan)] backdrop-blur-md">
        Official Channel
      </span>
    </div>

    <h1 class="hero-title text-5xl md:text-7xl font-black mb-6 tracking-tight animate-fade-up" style="animation-delay: 0.2s;">
      <span class="block bg-clip-text text-transparent bg-gradient-to-r from-white via-[var(--jazer-cyan)] to-[var(--jazer-purple)]">
        VISUALS & MOTION
      </span>
    </h1>

    <p class="hero-subtitle text-lg md:text-xl text-[var(--text-muted)] max-w-2xl mx-auto leading-relaxed mb-10 animate-fade-up" style="animation-delay: 0.3s;">
      Music videos, behind-the-scenes studio sessions, and creative vlogs.<br class="hidden md:block" />
      The complete visual experience is coming in 2026.
    </p>

    <div class="flex flex-wrap justify-center gap-4 animate-fade-up" style="animation-delay: 0.4s;">
      <a href="#updates" class="cta-button group">
        <span class="cta-icon group-hover:scale-110 transition-transform duration-300">🔔</span>
        <span>Get Premiere Alerts</span>
      </a>
      <a href="https://youtube.com/@jazer" target="_blank" rel="noopener" class="cta-secondary group">
        <span class="cta-icon group-hover:scale-110 transition-transform duration-300">📺</span>
        <span>Subscribe on YouTube</span>
      </a>
    </div>
  </div>
  
  <!-- Decorative film strip effect at bottom -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-[var(--bg-dark)] to-transparent z-20"></div>
</section>

<style>
  .hero-title {
    font-family: var(--font-primary, sans-serif);
    text-shadow: 0 0 40px rgba(6, 182, 212, 0.2);
  }
  
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--gradient-primary);
    color: white;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(6, 182, 212, 0.25);
  }
  
  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(6, 182, 212, 0.4);
  }
  
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    color: white;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }
  
  .cta-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: white;
    transform: translateY(-2px);
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-fade-up {
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }
</style>
