    <script>
        // Countdown Timer
        function updateCountdown() {
            const premiereDate = new Date('2026-03-15T00:00:00Z').getTime();
            const now = new Date().getTime();
            const distance = premiereDate - now;
            
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            
            const daysEl = document.getElementById('days');
            const hoursEl = document.getElementById('hours');
            const minutesEl = document.getElementById('minutes');
            const secondsEl = document.getElementById('seconds');
            
            if (daysEl) daysEl.textContent = distance > 0 ? days : '00';
            if (hoursEl) hoursEl.textContent = distance > 0 ? hours.toString().padStart(2, '0') : '00';
            if (minutesEl) minutesEl.textContent = distance > 0 ? minutes.toString().padStart(2, '0') : '00';
            if (secondsEl) secondsEl.textContent = distance > 0 ? seconds.toString().padStart(2, '0') : '00';
        }
        
        updateCountdown();
        setInterval(updateCountdown, 1000);

        // Premiere Modal
        const modal = document.getElementById('premiereModal');
        const openBtn = document.getElementById('openReminderModal');
        const closeBtn = document.getElementById('closeModal');
        const emailReminder = document.getElementById('emailReminder');

        if (openBtn) {
            openBtn.addEventListener('click', () => {
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            });
        }

        if (emailReminder) {
            emailReminder.addEventListener('click', () => {
                modal.classList.remove('active');
                document.body.style.overflow = '';
            });
        }

        // Close modal on background click
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });
        }

        // Calendar Reminder
        const calendarBtn = document.getElementById('calendarReminder');
        if (calendarBtn) {
            calendarBtn.addEventListener('click', () => {
                const event = {
                    title: 'JaZeR - First Music Video Premiere',
                    start: '2026-03-15T00:00:00Z',
                    end: '2026-03-15T01:00:00Z',
                    description: 'World premiere of JaZeR\'s first official music video! Watch live on YouTube.',
                    location: 'https://youtube.com/@jazer'
                };
                
                const googleCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.title)}&dates=20260315T000000Z/20260315T010000Z&details=${encodeURIComponent(event.description)}&location=${encodeURIComponent(event.location)}`;
                
                window.open(googleCalUrl, '_blank');
            });
        }

        // Video Filter Tabs
        const filterTabs = document.querySelectorAll('.filter-tab');
        const categoryCards = document.querySelectorAll('.category-card');
        const videoCards = document.querySelectorAll('.video-card');

        function filterVideos(filter) {
            videoCards.forEach(card => {
                const category = card.dataset.category || '';
                if (filter === 'all' || category.includes(filter)) {
                    card.style.display = 'block';
                    card.style.opacity = '1';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        filterTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                filterTabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                filterVideos(tab.dataset.filter);
            });
        });

        categoryCards.forEach(card => {
            card.addEventListener('click', () => {
                categoryCards.forEach(c => c.classList.remove('active'));
                card.classList.add('active');
                const filter = card.dataset.filter;
                filterTabs.forEach(t => {
                    t.classList.toggle('active', t.dataset.filter === filter);
                });
                filterVideos(filter);
            });
        });

        // BTS Photo Gallery Lightbox Effect
        const btsPhotos = document.querySelectorAll('.bts-photo');
        btsPhotos.forEach(photo => {
            photo.addEventListener('click', () => {
                photo.classList.toggle('expanded');
            });
        });
    </script>
