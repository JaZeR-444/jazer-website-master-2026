---
<BaseLayout
  bodyClass="shop-page has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={false}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/pages-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Shop - JaZeR | Coming in 2026</title>
    <meta name="description" content="The Official JaZeR Shop. Premium merchandise designed for the community. All items coming in 2026 — join the waitlist for early access." />
    <meta name="keywords" content="JaZeR shop, merchandise, merch, apparel, clothing, hoodies, t-shirts, limited edition, coming soon" />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      as="image"
      href={`${base}assets/images/Shop (234 x 96 px).svg`}
      type="image/svg+xml"
    />

    <style>
      /* ========================================
         SHOP PAGE - UNIFIED DESIGN SYSTEM
         ======================================== */
      
      html {
        scroll-behavior: smooth;
      }

      .shop-page {
        --shop-pink: #ef4444;
        --shop-purple: #8b5cf6;
        --shop-cyan: #06b6d4;
        --section-padding: 6rem 0;
        --card-radius: 16px;
        --card-border: 1px solid rgba(255, 255, 255, 0.1);
        --card-hover-border: rgba(6, 182, 212, 0.5);
        --focus-ring: 2px solid var(--jazer-cyan);
        --focus-offset: 2px;
      }

      /* ========================================
         FOCUS STATES (Accessibility)
         ======================================== */
      .shop-page a:focus-visible,
      .shop-page button:focus-visible,
      .shop-page input:focus-visible,
      .shop-page details:focus-visible {
        outline: var(--focus-ring);
        outline-offset: var(--focus-offset);
      }

      .shop-page .product-card:focus-within {
        border-color: var(--card-hover-border);
        box-shadow: 0 0 0 2px rgba(6, 182, 212, 0.3);
      }

      /* ========================================
         HERO SECTION
         ======================================== */
      .shop-hero {
        min-height: 50vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 8rem 2rem 4rem;
        position: relative;
      }

      .shop-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.25rem;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(139, 92, 246, 0.15));
        border: 1px solid rgba(6, 182, 212, 0.4);
        border-radius: 24px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--jazer-cyan);
        margin-bottom: 1.5rem;
        animation: badgePulse 3s ease infinite;
      }

      .shop-hero-badge::before {
        content: '';
        width: 8px;
        height: 8px;
        background: var(--jazer-cyan);
        border-radius: 50%;
        animation: blink 1.5s infinite;
      }

      .shop-hero h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
        background: linear-gradient(135deg, #fff 0%, var(--jazer-cyan) 50%, var(--jazer-purple) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
        line-height: 1.1;
      }

      .shop-hero-subtitle {
        font-size: 1.125rem;
        color: var(--text-muted);
        max-width: 600px;
        line-height: 1.7;
        margin-bottom: 2rem;
      }

      .shop-hero-cta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
      }

      /* ========================================
         CATEGORY FILTER TABS
         ======================================== */
      .category-filter {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 3rem;
        padding: 0 1rem;
      }

      .category-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .category-tab:hover {
        background: rgba(6, 182, 212, 0.1);
        border-color: rgba(6, 182, 212, 0.3);
        color: var(--text-light);
      }

      .category-tab.active {
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(139, 92, 246, 0.2));
        border-color: var(--jazer-cyan);
        color: var(--jazer-cyan);
      }

      /* ========================================
         PRODUCT CARDS (Standardized)
         ======================================== */
      .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .product-card {
        position: relative;
        background: rgba(10, 10, 20, 0.8);
        border: var(--card-border);
        border-radius: var(--card-radius);
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .product-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.08) 0%, rgba(139, 92, 246, 0.08) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }

      .product-card:hover::before {
        opacity: 1;
      }

      .product-card:hover {
        transform: translateY(-6px);
        border-color: var(--card-hover-border);
        box-shadow: 
          0 20px 40px rgba(0, 0, 0, 0.3),
          0 0 20px rgba(6, 182, 212, 0.15);
      }

      .product-card-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.75rem;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(8px);
        border-radius: 16px;
        font-size: 0.625rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--jazer-cyan);
        z-index: 2;
      }

      .product-card-badge::before {
        content: '';
        width: 6px;
        height: 6px;
        background: var(--jazer-cyan);
        border-radius: 50%;
        animation: blink 1.5s infinite;
      }

      .product-card-image {
        position: relative;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 50%, #0f0f1f 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        overflow: hidden;
      }

      .product-card-image::before {
        content: '';
        position: absolute;
        width: 150%;
        height: 150%;
        background: conic-gradient(
          from 0deg,
          transparent 0%,
          rgba(6, 182, 212, 0.08) 25%,
          transparent 50%,
          rgba(139, 92, 246, 0.08) 75%,
          transparent 100%
        );
        animation: rotateSlow 25s linear infinite;
      }

      .product-card-icon {
        font-size: 3rem;
        z-index: 1;
        opacity: 0.4;
      }

      .product-card-body {
        padding: 1.5rem;
      }

      .product-card-category {
        display: inline-block;
        padding: 0.25rem 0.625rem;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 4px;
        font-size: 0.625rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
      }

      .product-card-title {
        font-size: 1.125rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text-light);
      }

      .product-card-description {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 1rem;
      }

      .product-card-price {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--jazer-cyan);
        margin-bottom: 1rem;
      }

      .product-card-cta {
        width: 100%;
      }

      /* ========================================
         BUTTONS (Unified)
         ======================================== */
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.875rem 1.5rem;
        background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple));
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 700;
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(6, 182, 212, 0.3);
      }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.875rem 1.5rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-light);
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
      }

      .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: var(--jazer-cyan);
      }

      .btn-disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
      }

      /* ========================================
         ANIMATIONS
         ======================================== */
      @keyframes badgePulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4); }
        50% { box-shadow: 0 0 20px 5px rgba(6, 182, 212, 0.15); }
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
      }

      @keyframes rotateSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      /* Coming Soon Badge Animation */
      .coming-soon-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(139, 92, 246, 0.2));
        border: 1px solid rgba(6, 182, 212, 0.4);
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--jazer-cyan);
        animation: badgePulse 2s ease infinite;
      }

      .coming-soon-badge::before {
        content: '';
        width: 8px;
        height: 8px;
        background: var(--jazer-cyan);
        border-radius: 50%;
        animation: blink 1.5s infinite;
      }

      @keyframes badgePulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4); }
        50% { box-shadow: 0 0 20px 5px rgba(6, 182, 212, 0.2); }
      }

      /* Enhanced Shop Cards with Glow */
      .shop-card-enhanced {
        position: relative;
        background: rgba(10, 10, 20, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .shop-card-enhanced::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .shop-card-enhanced:hover::before {
        opacity: 1;
      }

      .shop-card-enhanced:hover {
        transform: translateY(-8px) scale(1.02);
        border-color: rgba(6, 182, 212, 0.5);
        box-shadow: 
          0 20px 40px rgba(0, 0, 0, 0.4),
          0 0 30px rgba(6, 182, 212, 0.2),
          inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }

      /* Floating Status Indicator */
      .status-indicator {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        border-radius: 20px;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--jazer-cyan);
        z-index: 2;
      }

      .status-indicator::before {
        content: '';
        width: 6px;
        height: 6px;
        background: var(--jazer-cyan);
        border-radius: 50%;
        animation: blink 1.5s infinite;
      }

      /* Improved Product Image Placeholder */
      .product-placeholder {
        position: relative;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 50%, #0f0f1f 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        overflow: hidden;
      }

      .product-placeholder::before {
        content: '';
        position: absolute;
        width: 200%;
        height: 200%;
        background: conic-gradient(
          from 0deg,
          transparent 0%,
          rgba(6, 182, 212, 0.1) 25%,
          transparent 50%,
          rgba(139, 92, 246, 0.1) 75%,
          transparent 100%
        );
        animation: rotateSlow 20s linear infinite;
      }

      @keyframes rotateSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .product-placeholder-icon {
        font-size: 3rem;
        opacity: 0.3;
        z-index: 1;
      }

      .product-placeholder-text {
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.3);
        z-index: 1;
      }

      /* Improved Timeline */
      .timeline-step-enhanced {
        position: relative;
        padding: 2rem 2.5rem;
        background: rgba(10, 10, 20, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        margin-bottom: 1.5rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
      }

      .timeline-step-enhanced::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, var(--jazer-cyan), var(--jazer-purple));
        opacity: 0.5;
        transition: opacity 0.3s ease;
      }

      .timeline-step-enhanced:hover::before {
        opacity: 1;
      }

      .timeline-step-enhanced:hover {
        transform: translateX(8px);
        background: rgba(6, 182, 212, 0.05);
        border-color: rgba(6, 182, 212, 0.3);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      }

      .timeline-phase-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(6, 182, 212, 0.2);
        border: 1px solid rgba(6, 182, 212, 0.3);
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--jazer-cyan);
        margin-bottom: 0.75rem;
      }

      /* Notify Button Enhancement */
      .notify-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple));
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .notify-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--jazer-purple), var(--jazer-pink));
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .notify-btn:hover::before {
        opacity: 1;
      }

      .notify-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(6, 182, 212, 0.4);
      }

      .notify-btn span {
        position: relative;
        z-index: 1;
      }

      /* Section Divider */
      .section-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(6, 182, 212, 0.3), rgba(139, 92, 246, 0.3), transparent);
        margin: 4rem 0;
      }

      /* Hero Section */
      .page-hero {
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 1rem;
        text-align: center;
      }

      .page-hero-title-logo {
        max-width: 100%;
        height: auto;
        margin-bottom: 1.5rem;
      }

      .page-hero-subtitle {
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--text-secondary);
        margin-bottom: 2rem;
      }

      /* Drop Countdown */
      .drop-countdown {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 2rem;
      }

      .countdown-label {
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
      }

      .countdown-time {
        font-size: 3rem;
        font-weight: 800;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .countdown-note {
        font-size: 0.875rem;
        color: var(--text-muted);
      }

      /* Email Capture */
      .hero-email-capture {
        max-width: 500px;
        margin: 2rem auto;
      }

      .hero-email-copy {
        font-size: 1rem;
        margin-bottom: 1rem;
        color: var(--text-secondary);
      }

      .hero-email-form {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
      }

      .hero-email-form .modern-input {
        flex: 1;
        min-width: 250px;
      }

      /* Page Intro */
      .page-intro-icon {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.7;
      }

      /* Shop Sections */
      .shop-section {
        margin-bottom: 4rem;
      }

      .shop-section-header {
        text-align: center;
        margin-bottom: 2rem;
      }

      .shop-section-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .shop-section-subtitle {
        font-size: 1rem;
        color: var(--text-muted);
        line-height: 1.6;
      }

      /* Shop Cards */
      .shop-featured-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .shop-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .shop-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      }

      .shop-card-media {
        position: relative;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .shop-card-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: var(--jazer-pink);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .shop-card-placeholder {
        font-size: 1.5rem;
        color: var(--text-muted);
        font-weight: 600;
      }

      .shop-card-title {
        padding: 1.5rem 1.5rem 0.5rem;
        font-size: 1.25rem;
        font-weight: 600;
      }

      .shop-card-meta {
        padding: 0 1.5rem 1rem;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .shop-interest-form {
        padding: 0 1.5rem 1.5rem;
        display: flex;
        gap: 0.5rem;
      }

      .shop-interest-input {
        flex: 1;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-size: 0.875rem;
        transition: border-color 0.2s ease;
      }

      .shop-interest-input:focus {
        outline: none;
        border-color: var(--jazer-cyan);
      }

      .shop-interest-input::placeholder {
        color: var(--text-muted);
      }

      .shop-interest-button {
        background: var(--jazer-cyan);
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .shop-interest-button:hover {
        background: #0891b2;
        transform: translateY(-2px);
      }

      /* Drop Timeline System Log */
      .drop-timeline {
        position: relative;
        max-width: 600px;
        margin: 0 auto;
        padding-left: 2rem;
        border-left: 2px solid rgba(255, 255, 255, 0.1);
      }

      .timeline-step {
        position: relative;
        padding: 1.5rem 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        margin-bottom: 2rem;
        text-align: left;
        transition: all 0.3s ease;
      }

      .timeline-step::before {
        content: '';
        position: absolute;
        left: -2.6rem; /* Adjust to align with border */
        top: 50%;
        transform: translateY(-50%);
        width: 12px; height: 12px;
        background: #000;
        border: 2px solid var(--jazer-cyan);
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
      }

      .timeline-step:hover {
        transform: translateX(10px);
        border-color: var(--jazer-cyan);
        box-shadow: 0 0 20px rgba(6, 182, 212, 0.1);
      }
      .timeline-step:hover::before {
        background: var(--jazer-cyan);
      }

      .timeline-title {
        font-family: 'Courier New', monospace;
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--jazer-cyan);
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .timeline-meta {
        color: var(--text-secondary);
        font-size: 0.9rem;
      }

      /* Tech Specs Bento */
      .tech-specs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .spec-card {
        background: rgba(10, 10, 20, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 2rem;
        transition: border-color 0.3s ease;
      }
      .spec-card:hover { border-color: var(--jazer-purple); }
      
      .spec-header {
          display: flex;
          align-items: center;
          gap: 1rem;
          margin-bottom: 1.5rem;
          border-bottom: 1px solid rgba(255,255,255,0.1);
          padding-bottom: 1rem;
      }
      .spec-icon { width: 24px; height: 24px; filter: invert(1); opacity: 0.7; }
      
      .spec-title {
          font-size: 1.25rem;
          font-weight: 600;
          color: white;
      }
      
      .spec-list {
          display: flex;
          flex-direction: column;
          gap: 1rem;
      }
      
      .spec-row {
          display: flex;
          justify-content: space-between;
          font-size: 0.9rem;
      }
      .spec-key { color: var(--text-muted); }
      .spec-val { color: white; font-weight: 500; text-align: right; }
      
      .grid-span-2 { grid-column: span 2; }
      @media (max-width: 768px) { .grid-span-2 { grid-column: 1; } }

      /* Design Story */
      .design-story {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: center;
        margin-top: 2rem;
      }

      .design-visual {
        aspect-ratio: 16 / 9;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--text-muted);
        font-weight: 600;
      }

      .design-copy {
        padding: 1rem;
      }

      .design-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      .design-text {
        margin-bottom: 1rem;
        line-height: 1.7;
        color: var(--text-secondary);
      }

      .design-text:last-child {
        margin-bottom: 0;
      }

      /* Materials Grid */
      .materials-grid,
      .shipping-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .material-card,
      .shipping-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        transition: transform 0.2s ease;
      }

      .material-card:hover,
      .shipping-card:hover {
        transform: translateY(-4px);
      }

      .material-title,
      .shipping-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: var(--jazer-purple);
      }

      .material-text,
      .shipping-text {
        color: var(--text-muted);
        line-height: 1.6;
      }

      /* Size Guide */
      .size-guide {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .size-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        text-align: center;
        transition: transform 0.2s ease;
      }

      .size-card:hover {
        transform: translateY(-4px);
      }

      .size-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }

      .size-text {
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      /* Bundle Builder */
      .bundle-builder {
        margin-top: 2rem;
      }

      .bundle-card {
        padding: 3rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        text-align: center;
        position: relative;
      }

      .bundle-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      .bundle-text {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
      }

      .bundle-tag {
        display: inline-block;
        background: var(--jazer-cyan);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
      }

      /* Mockup Carousel */
      .mockup-carousel {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .mockup-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s ease;
      }

      .mockup-card:hover {
        transform: translateY(-4px);
      }

      .mockup-art {
        aspect-ratio: 1;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--text-muted);
        font-weight: 600;
      }

      .mockup-caption {
        padding: 1rem;
        text-align: center;
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      .mockup-note {
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.875rem;
      }

      /* Tier Grid */
      .tier-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .tier-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        transition: transform 0.3s ease, border-color 0.3s ease;
      }

      .tier-card:hover {
        transform: translateY(-4px);
        border-color: var(--jazer-cyan);
      }

      .tier-name {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .tier-price {
        color: var(--jazer-cyan);
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
      }

      .tier-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .tier-list li {
        padding: 0.5rem 0;
        color: var(--text-secondary);
        position: relative;
        padding-left: 1.5rem;
      }

      .tier-list li::before {
        content: "✦";
        position: absolute;
        left: 0;
        color: var(--jazer-cyan);
      }

      /* Community Strip */
      .community-strip {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        padding: 3rem 2rem;
        text-align: center;
      }

      .community-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      .community-avatars {
        display: flex;
        gap: 0.5rem;
      }

      .social-avatar-gradient {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--jazer-pink), var(--jazer-purple));
        border: 2px solid rgba(255, 255, 255, 0.1);
      }

      .community-stats {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
      }

      .community-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .community-stat-number {
        font-size: 2rem;
        font-weight: 800;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .community-stat-label {
        color: var(--text-muted);
        font-size: 0.875rem;
        margin-top: 0.25rem;
      }

      /* FAQ */
      .faq-list {
        margin-top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .faq-item {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.5rem;
        transition: background 0.2s ease;
      }

      .faq-item:hover {
        background: rgba(255, 255, 255, 0.05);
      }

      .faq-item summary {
        font-weight: 600;
        cursor: pointer;
        list-style: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .faq-item summary::after {
        content: "+";
        font-size: 1.5rem;
        color: var(--jazer-cyan);
        transition: transform 0.2s ease;
      }

      .faq-item[open] summary::after {
        transform: rotate(45deg);
      }

      .faq-item p {
        margin-top: 1rem;
        color: var(--text-secondary);
        line-height: 1.6;
      }

      /* ========================================
         TRUST BLOCK
         ======================================== */
      .trust-block {
        background: rgba(10, 10, 20, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: var(--card-radius);
        padding: 2.5rem;
        margin-top: 3rem;
      }

      .trust-block-title {
        font-size: 1.25rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 2rem;
        color: var(--text-light);
      }

      .trust-links {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
      }

      .trust-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        text-decoration: none;
        color: var(--text-light);
        transition: all 0.3s ease;
      }

      .trust-link:hover {
        background: rgba(6, 182, 212, 0.1);
        border-color: rgba(6, 182, 212, 0.3);
      }

      .trust-link-name {
        font-weight: 600;
        font-size: 0.875rem;
      }

      .trust-link-status {
        font-size: 0.75rem;
        color: var(--text-muted);
        padding: 0.25rem 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
      }

      .trust-link-status.active {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
      }

      /* ========================================
         FOOTER RELEASE LINE
         ======================================== */
      .shop-footer-note {
        text-align: center;
        padding: 2rem;
        margin-top: 3rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.875rem;
        color: var(--text-muted);
      }

      .shop-footer-note strong {
        color: var(--jazer-cyan);
      }

      /* Email Capture Section */
      .email-capture {
        padding: 3rem;
        text-align: center;
        max-width: 600px;
        margin: 4rem auto;
      }

      .email-capture-title {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 1rem;
      }

      .email-capture-subtitle {
        color: var(--text-muted);
        margin-bottom: 2rem;
      }

      .email-capture-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
      }

      .email-capture-status {
        margin-top: 1rem;
        font-size: 0.875rem;
        min-height: 1.5rem;
      }

      /* Responsive Design */
      @media (max-width: 768px) {
        .page-hero {
          padding: 3rem 1rem;
        }

        .page-hero-subtitle {
          font-size: 1.125rem;
        }

        .coming-soon-text {
          font-size: 1.75rem;
          letter-spacing: 0.1em;
        }

        .hero-email-form {
          flex-direction: column;
        }

        .hero-email-form .modern-input {
          min-width: 100%;
        }

        .shop-featured-grid {
          grid-template-columns: 1fr;
        }

        .product-placeholder-icon {
          font-size: 2.5rem;
        }

        .product-placeholder-text {
          font-size: 0.75rem;
        }

        .status-indicator {
          font-size: 0.6rem;
          padding: 0.3rem 0.6rem;
        }

        .design-story {
          grid-template-columns: 1fr;
        }

        .drop-timeline {
          grid-template-columns: 1fr;
        }

        .timeline-step-enhanced {
          padding: 1.5rem;
        }

        .community-stats {
          gap: 2rem;
        }

        .tier-grid,
        .materials-grid,
        .shipping-grid {
          grid-template-columns: 1fr;
        }

        .mockup-carousel {
          grid-template-columns: repeat(2, 1fr);
        }

        .notify-btn {
          width: 100%;
          justify-content: center;
        }

        .shop-interest-form {
          flex-direction: column;
        }

        .shop-interest-input {
          width: 100%;
        }
      }

      @media (max-width: 480px) {
        .mockup-carousel {
          grid-template-columns: 1fr;
        }

        .community-stats {
          flex-direction: column;
          gap: 1.5rem;
        }
      }
      /* New Shop Hero Styles */
      .shop-hero {
          min-height: 80vh;
          display: flex;
          align-items: center;
          justify-content: center;
          position: relative;
          background: radial-gradient(circle at center, rgba(6, 182, 212, 0.1) 0%, transparent 70%);
      }
      .shop-hero-content {
          text-align: center;
          z-index: 2;
          width: 100%;
          max-width: 900px;
      }
      .shop-logo {
          max-width: 500px;
          height: auto;
          margin-bottom: 2.5rem;
          filter: drop-shadow(0 0 30px rgba(6, 182, 212, 0.3));
      }
      .countdown-wrapper {
          background: rgba(10, 10, 20, 0.6);
          border: 1px solid rgba(6, 182, 212, 0.3);
          box-shadow: 0 0 40px rgba(6, 182, 212, 0.1), inset 0 0 20px rgba(6, 182, 212, 0.05);
          padding: 2.5rem;
          border-radius: 12px;
          position: relative;
          backdrop-filter: blur(12px);
          max-width: 600px;
          margin: 0 auto;
      }
      .countdown-wrapper::before, .countdown-wrapper::after {
          content: '';
          position: absolute;
          width: 20px; height: 20px;
          border: 2px solid var(--jazer-cyan);
          transition: all 0.3s ease;
      }
      .countdown-wrapper::before { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
      .countdown-wrapper::after { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }
      
      .countdown-header {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.75rem;
          margin-bottom: 1rem;
      }
      .status-dot {
          width: 8px; height: 8px;
          background: var(--jazer-cyan);
          border-radius: 50%;
          box-shadow: 0 0 10px var(--jazer-cyan);
      }
      .blink { animation: blink 1.5s infinite; }
      .digital-clock {
          font-family: 'Courier New', monospace;
          font-size: 3.5rem;
          font-weight: 700;
          letter-spacing: 0.15em;
          color: var(--jazer-cyan);
          text-shadow: 0 0 25px rgba(6, 182, 212, 0.8);
          margin: 1rem 0;
          line-height: 1;
      }
      .coming-soon-text {
          font-family: 'Courier New', monospace;
          font-size: 2.5rem;
          font-weight: 700;
          letter-spacing: 0.2em;
          background: linear-gradient(135deg, var(--jazer-cyan) 0%, var(--jazer-purple) 50%, var(--jazer-pink) 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          text-shadow: none;
          margin: 1.5rem 0;
          line-height: 1.2;
          animation: gradientShift 4s ease infinite;
      }
      @keyframes gradientShift {
          0%, 100% { filter: hue-rotate(0deg); }
          50% { filter: hue-rotate(30deg); }
      }
      .countdown-footer {
          font-size: 0.75rem;
          color: rgba(6, 182, 212, 0.7);
          letter-spacing: 0.3em;
          text-transform: uppercase;
          margin-top: 1rem;
      }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

      /* Refined Shop Card */
      .shop-card-refined {
          border: 1px solid rgba(255, 255, 255, 0.1);
