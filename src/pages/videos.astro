  }
];

// Video content types - Using TBD for counts
const contentTypes = [
  { name: 'Music Videos', icon: 'video-black.svg', count: 'TBD', desc: 'Full production visuals', filter: 'music' },
  { name: 'Behind The Scenes', icon: 'camera-black.svg', count: 'TBD', desc: 'Studio process', filter: 'bts' },
  { name: 'Live Sessions', icon: 'live-black.svg', count: 'TBD', desc: 'Performances & shows', filter: 'live' },
  { name: 'Tutorials', icon: 'mixer-black.svg', count: 'TBD', desc: 'Production guides', filter: 'tutorial' }
];

// Featured collaborators - Using TBD for names
const collaborators = [
  { name: 'TBD', role: 'Music Video Production', avatar: '🎬' },
  { name: 'TBD', role: 'Dance & Movement', avatar: '💃' },
  { name: 'TBD', role: 'Visual Effects', avatar: '✨' },
  { name: 'TBD', role: 'Audio Mixing', avatar: '🎧' }
];

// FAQ Items - Safe copy only
const videosFAQ = [
  {
    q: 'When will videos be available?',
    a: 'Visual content is expected sometime in 2026. Join updates to be notified when videos drop.'
  },
  {
    q: 'Where can I watch?',
    a: 'Videos will be available on YouTube and social platforms when released. Subscribe to be first to know.'
  },
  {
    q: 'What types of content are planned?',
    a: 'Music videos, behind-the-scenes footage, tutorials, and live sessions are in development.'
  },
  {
    q: 'How do I get notified about new videos?',
    a: 'Join the email list below or subscribe on YouTube for premiere alerts and early access.'
  }
];

// BTS Photo gallery
const btsPhotos = [
  { id: 1, caption: 'Studio Setup', gradient: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' },
  { id: 2, caption: 'Recording Session', gradient: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)' },
  { id: 3, caption: 'Video Shoot', gradient: 'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)' },
  { id: 4, caption: 'Editing Suite', gradient: 'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)' },
  { id: 5, caption: 'Creative Meeting', gradient: 'linear-gradient(135deg, #fa709a 0%, #fee140 100%)' },
  { id: 6, caption: 'Rehearsal', gradient: 'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)' }
];
---
<BaseLayout
  bodyClass="has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/pages-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Videos - JaZeR</title>
    <meta
      name="description"
      content="Watch JaZeR's latest music videos, behind-the-scenes content, live performances, and creative vlogs. First video premiering March 2026."
    />
    <meta
      name="keywords"
      content="JaZeR, videos, music videos, behind the scenes, visual content, vlogs, live performances, tutorials"
    />
    <link rel="canonical" href={canonical} />
    <style>
      .videos-hero {
        min-height: 70vh;
        padding: 8rem 0 4rem;
      }
      .hero-content {
        max-width: 800px;
        margin: 0 auto;
      }
      .hero-logo {
        margin: 2rem auto;
        display: block;
        width: 100%;
        max-width: 501px;
        height: auto;
      }
      .tagline-roles {
        max-width: 600px;
        margin: 0 auto 2rem;
      }
      
      /* Countdown Timer Styles */
      .countdown-container {
        max-width: 600px;
        margin: 3rem auto;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 16px;
        border: 1px solid rgba(6, 182, 212, 0.3);
      }
      .countdown-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .countdown-item {
        text-align: center;
      }
      .countdown-value {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-pink));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
      }
      .countdown-label {
        font-size: 0.813rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.5rem;
      }
      
      /* Video Gallery Grid */
      .video-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        margin-top: 3rem;
      }
      .video-card {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .video-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }
      .video-thumbnail {
        position: relative;
        aspect-ratio: 16/9;
        overflow: hidden;
      }
      .video-play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.4);
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .video-card:hover .video-play-overlay {
        opacity: 1;
      }
      .video-play-btn {
        width: 64px;
        height: 64px;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: scale(0.9);
        transition: transform 0.3s ease;
      }
      .video-card:hover .video-play-btn {
        transform: scale(1);
      }
      .video-content {
        padding: 1.5rem;
      }
      .video-meta {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .video-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .video-duration {
        padding: 0.25rem 0.75rem;
        background: rgba(0, 0, 0, 0.6);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .video-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }
      .video-description {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 1rem;
      }
      .video-date {
        font-size: 0.813rem;
        color: var(--jazer-cyan);
        font-weight: 600;
      }
      
      /* Content Types Grid */
      .content-types-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-top: 3rem;
      }
      .content-type-card {
        background: rgba(0, 0, 0, 0.3);
        padding: 2rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
        transition: all 0.3s ease;
      }
      .content-type-card:hover {
        transform: translateY(-4px);
        border-color: var(--jazer-cyan);
        box-shadow: 0 12px 24px rgba(6, 182, 212, 0.2);
      }
      .content-type-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 1rem;
        filter: invert(1);
        opacity: 0.8;
      }
      .content-type-name {
        font-size: 1.125rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }
      .content-type-count {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
      }
      .content-type-desc {
        font-size: 0.875rem;
        color: var(--text-muted);
      }
      
      /* Stats Section */
      .video-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin: 4rem 0;
      }
      .stat-card {
        text-align: center;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .stat-value {
        font-size: 3rem;
        font-weight: 900;
        background: linear-gradient(135deg, var(--jazer-pink), var(--jazer-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
      }
      .stat-label {
        font-size: 1rem;
        color: var(--text-muted);
        margin-top: 0.75rem;
      }
      
      /* Mobile Optimization */
      @media (max-width: 768px) {
        .videos-hero {
          min-height: auto;
          padding: 6rem 0 3rem;
        }
        .hero-logo {
          max-width: 300px;
        }
        .countdown-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .countdown-value {
          font-size: 2rem;
        }
        .video-gallery {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
        .content-types-grid {
          grid-template-columns: 1fr;
        }
        .video-stats {
          grid-template-columns: repeat(2, 1fr);
          gap: 1rem;
        }
        .stat-value {
          font-size: 2rem;
        }
        .film-strip {
          display: none;
        }
        .bts-gallery {
          grid-template-columns: repeat(2, 1fr);
        }
        .collaborators-grid {
          grid-template-columns: 1fr;
        }
        .testimonials-grid {
          grid-template-columns: 1fr;
        }
        .video-embed-container {
          padding: 1.5rem;
        }
        .filter-tabs {
          flex-wrap: wrap;
          gap: 0.5rem;
        }
        .filter-tab {
          font-size: 0.813rem;
          padding: 0.5rem 1rem;
        }
      }

      /* Film Strip Animation */
      .film-strip {
        position: relative;
        overflow: hidden;
        padding: 2rem 0;
        background: linear-gradient(90deg, transparent, rgba(0,0,0,0.3), transparent);
      }
      .film-strip-track {
        display: flex;
        animation: filmScroll 30s linear infinite;
        gap: 1rem;
      }
      .film-frame {
        flex-shrink: 0;
        width: 200px;
        height: 120px;
        border-radius: 8px;
        position: relative;
        overflow: hidden;
      }
      .film-frame::before,
      .film-frame::after {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 12px;
        background: repeating-linear-gradient(
          180deg,
          #000 0px,
          #000 8px,
          transparent 8px,
          transparent 16px
        );
      }
      .film-frame::before { left: 0; }
      .film-frame::after { right: 0; }
      @keyframes filmScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      /* Video Embed Container */
      .video-embed-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.4);
        border-radius: 20px;
        border: 1px solid rgba(6, 182, 212, 0.3);
      }
      .video-embed {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        border-radius: 12px;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      }
      .video-embed iframe,
      .video-embed-placeholder {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
      }
      .video-embed-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      }
      .teaser-play-btn {
        width: 100px;
        height: 100px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
        border: 3px solid rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .teaser-play-btn:hover {
        transform: scale(1.1);
        background: rgba(255, 255, 255, 0.25);
        border-color: var(--jazer-cyan);
      }

      /* Filter Tabs */
      .filter-tabs {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin: 2rem 0;
        flex-wrap: wrap;
      }
      .filter-tab {
        padding: 0.75rem 1.5rem;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .filter-tab:hover,
      .filter-tab.active {
        background: var(--jazer-cyan);
        color: #000;
        border-color: var(--jazer-cyan);
      }

      /* BTS Photo Gallery */
      .bts-gallery {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-top: 2rem;
      }
      .bts-photo {
        aspect-ratio: 4/3;
        border-radius: 12px;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .bts-photo:hover {
        transform: scale(1.05);
        z-index: 10;
      }
      .bts-photo-inner {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
      }
      .bts-caption {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1rem;
        background: linear-gradient(transparent, rgba(0,0,0,0.8));
        font-size: 0.875rem;
        font-weight: 600;
      }

      /* Premiere Alert Modal */
      .premiere-modal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.9);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 2rem;
      }
      .premiere-modal.active {
        display: flex;
      }
      .premiere-modal-content {
        max-width: 500px;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border-radius: 20px;
        padding: 3rem;
        border: 1px solid rgba(6, 182, 212, 0.3);
        text-align: center;
        position: relative;
      }
      .modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.1);
        border: none;
        border-radius: 50%;
        color: #fff;
        font-size: 1.5rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Collaborators Grid */
      .collaborators-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-top: 2rem;
      }
      .collaborator-card {
        background: rgba(0, 0, 0, 0.3);
        padding: 2rem;
        border-radius: 16px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
      }
      .collaborator-card:hover {
        transform: translateY(-4px);
        border-color: var(--jazer-purple);
      }
      .collaborator-avatar {
        font-size: 3rem;
        margin-bottom: 1rem;
      }
      .collaborator-name {
        font-weight: 700;
        font-size: 1.125rem;
        margin-bottom: 0.25rem;
      }
      .collaborator-role {
        font-size: 0.875rem;
        color: var(--text-muted);
      }

      /* Testimonials */
      .testimonials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 2rem;
      }
      .testimonial-card {
        background: rgba(0, 0, 0, 0.3);
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .testimonial-text {
        font-style: italic;
        margin-bottom: 1rem;
        line-height: 1.6;
        color: var(--text-light);
      }
      .testimonial-author {
        font-weight: 600;
        font-size: 0.875rem;
      }
      .testimonial-platform {
        font-size: 0.75rem;
        color: var(--jazer-cyan);
      }

      /* YouTube Subscribe Button */
      .yt-subscribe-container {
        display: flex;
        justify-content: center;
        margin-top: 2rem;
      }
      .yt-subscribe-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: #FF0000;
        color: #fff;
        padding: 1rem 2rem;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
      }
      .yt-subscribe-btn:hover {
        background: #cc0000;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 0, 0, 0.3);
      }
      .yt-subscribe-btn img {
        width: 24px;
        height: 24px;
      }

      /* Category Cards */
      .category-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin: 2rem 0;
      }
      .category-card {
        background: rgba(0, 0, 0, 0.4);
        padding: 1.5rem;
        border-radius: 12px;
        text-align: center;
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .category-card:hover,
      .category-card.active {
        border-color: var(--jazer-cyan);
        background: rgba(6, 182, 212, 0.1);
      }
      .category-icon {
        font-size: 2rem;
        margin-bottom: 0.5rem;
      }
      .category-name {
        font-weight: 600;
        font-size: 0.875rem;
      }

      @media (max-width: 768px) {
        .category-cards {
          grid-template-columns: repeat(2, 1fr);
        }
        .collaborators-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </Fragment>

        <!-- Hero Section -->
        <section class="hero hero-animated videos-hero">
            <div class="hero-particles"></div>
            <div class="hero-content" data-animate="zoom-in">
                <span class="hero-eyebrow" data-animate="fade-up">
                    <span class="eyebrow-word" style="--i: 0">Visual</span>
                    <span class="eyebrow-divider">✦</span>
                    <span class="eyebrow-word" style="--i: 1">Content</span>
                    <span class="eyebrow-divider">✦</span>
                    <span class="eyebrow-word" style="--i: 2">Archive</span>
                </span>
                <img class="hero-logo" src={`${base}assets/images/Videos & Visuals (501 x 75 px).svg`} alt="Videos & Visuals" />
                <p class="tagline-roles">
                    Music videos, behind-the-scenes studio sessions, live performances, tutorials, and creative vlogs. The complete visual experience launching 2026.
                </p>
                <div class="cta-group">
                    <a href="https://youtube.com/@jazer" class="cta-button" target="_blank" rel="noopener">
                        <span class="cta-icon">📺</span>
                        <span>Subscribe on YouTube</span>
                    </a>
                    <a href="#countdown" class="cta-secondary">
                        <span>Premiere Countdown</span>
                        <span class="cta-arrow">→</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Film Strip Animation -->
        <section class="film-strip" aria-hidden="true">
            <div class="film-strip-track">
                {[...Array(12)].map((_, i) => (
