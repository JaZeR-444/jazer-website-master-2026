---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideosHero from '../components/videos/VideosHero.astro';
import FeaturedVisual from '../components/videos/FeaturedVisual.astro';
import VideoGrid from '../components/videos/VideoGrid.astro';
import VideosFAQ from '../components/videos/VideosFAQ.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';

const announcement = {
  href: '#updates',
  text: '🎬 VISUAL EXPERIENCE COMING IN 2026 — Join updates for early access'
};

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
---

<BaseLayout
  bodyClass="videos-page"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
>
  <Fragment slot="head">
    <title>Videos & Visuals - JaZeR</title>
    <meta
      name="description"
      content="Watch JaZeR's latest music videos, behind-the-scenes content, live performances, and creative vlogs. The complete visual experience is coming in 2026."
    />
    <meta
      name="keywords"
      content="JaZeR, videos, music videos, visualizer, live performance, behind the scenes, creative vlog"
    />
    <link rel="canonical" href={canonical} />
  </Fragment>

  <main>
    <VideosHero />
    
    <FeaturedVisual 
      title="Featured Visual (TBA)"
      subtitle="Official Music Video — Coming in 2026"
    />

    <VideoGrid />

    <JoinBeamCTA
      id="updates"
      sectionStyle="padding: 6rem 0;"
      captureStyle="max-width: 600px; margin: 0 auto;"
      subject="New subscriber from Videos page"
      buttonLabel="Get Premiere Alert"
      proofText="Join fans waiting for the premiere"
    >
      <Fragment slot="subtitle">
        Get notified when the first video drops. Plus exclusive <strong>behind-the-scenes content</strong> and early access.
      </Fragment>
    </JoinBeamCTA>

    <VideosFAQ />
  </main>
</BaseLayout>