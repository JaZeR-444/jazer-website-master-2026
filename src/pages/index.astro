      <script>
        // Homepage Countdown Timer
        function updateHomeCountdown() {
          const premiereDate = new Date('2026-03-15T00:00:00Z').getTime();
          const now = new Date().getTime();
          const distance = premiereDate - now;
          
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const mins = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const secs = Math.floor((distance % (1000 * 60)) / 1000);
          
          const daysEl = document.getElementById('countdown-days');
          const hoursEl = document.getElementById('countdown-hours');
          const minsEl = document.getElementById('countdown-mins');
          const secsEl = document.getElementById('countdown-secs');
          
          if (daysEl) daysEl.textContent = distance > 0 ? days : '0';
          if (hoursEl) hoursEl.textContent = distance > 0 ? hours.toString().padStart(2, '0') : '00';
          if (minsEl) minsEl.textContent = distance > 0 ? mins.toString().padStart(2, '0') : '00';
          if (secsEl) secsEl.textContent = distance > 0 ? secs.toString().padStart(2, '0') : '00';
        }
        
        updateHomeCountdown();
        setInterval(updateHomeCountdown, 1000);
      </script>
    
