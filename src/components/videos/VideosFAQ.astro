---
const faqs = [
  {
    q: 'When will video content be released?',
    a: 'Visual content is currently in development and expected to begin rolling out in 2026. Join the updates list to be notified.'
  },
  {
    q: 'Where will I be able to watch?',
    a: 'Videos will be available right here on the official site, as well as on YouTube and other major social platforms.'
  },
  {
    q: 'Can I get early access?',
    a: 'Subscribers to the "Beam" newsletter often get early previews and behind-the-scenes content before the public release.'
  }
];
---

<section class="faq-section">
  <div class="container">
    <h2 class="faq-header">
      <span class="gradient-text">Common Questions</span>
    </h2>
    
    <div class="faq-list">
      {faqs.map((item, index) => (
        <div class="faq-item">
          <details class="group">
            <summary
              class="faq-summary"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
              role="button"
            >
              <span class="faq-question">{item.q}</span>
              <span class="faq-icon">▼</span>
            </summary>
            <div class="faq-answer" id={`faq-answer-${index}`}>
              {item.a}
            </div>
          </details>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: 5rem 0;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 768px) {
    .faq-section {
      padding: 3rem 0;
    }

    .faq-header {
      font-size: 1.5rem;
      margin-bottom: 2rem;
    }
  }

  .container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .faq-header {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 3rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, #ffffff 0%, var(--text-muted) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    overflow: hidden;
    transition: background 0.3s ease;
  }

  .faq-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-summary:focus-visible {
    outline: 2px solid var(--jazer-cyan);
    outline-offset: 2px;
  }
  
  /* Hide default marker */
  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    font-weight: 700;
    font-size: 1.125rem;
    color: white;
  }

  .faq-icon {
    color: var(--jazer-cyan);
    font-size: 0.75rem;
    transition: transform 0.3s ease;
  }

  details[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (max-width: 480px) {
    .faq-section {
      padding: 2rem 0;
    }

    .faq-header {
      margin-bottom: 1.5rem;
    }

    .faq-summary {
      min-height: 48px; /* ensure easy tap */
      padding: 1rem 1.25rem;
      gap: 0.75rem;
    }

    .faq-question {
      font-size: 1rem;
    }

    .faq-answer {
      font-size: 1rem;
      line-height: 1.6;
    }
  }
</style>

<script>
  document.querySelectorAll('.faq-item details').forEach((details) => {
    const summary = details.querySelector('summary');
    if (!summary) return;

    const updateExpanded = () => {
      summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
    };

    updateExpanded();
    details.addEventListener('toggle', updateExpanded);
  });
</script>
