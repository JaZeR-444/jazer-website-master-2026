                <div style="font-size: 0.75rem; color: var(--text-muted);">{goal.target}</div>
              </div>
              <span style={`padding: 0.25rem 0.75rem; background: ${goal.status === 'In Progress' ? 'rgba(16, 185, 129, 0.2)' : 'rgba(255,255,255,0.1)'}; color: ${goal.status === 'In Progress' ? '#10b981' : 'var(--text-muted)'}; border-radius: 4px; font-size: 0.625rem; font-weight: 700;`}>{goal.status}</span>
            </div>
          ))}
        </div>
        
        <!-- Long Term -->
        <div data-animate="fade-up" data-animate-delay="100">
          <h3 style="font-weight: 700; margin-bottom: 1.5rem; color: var(--jazer-purple);">🔮 Long Term</h3>
