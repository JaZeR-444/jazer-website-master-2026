---
const { 
  title = "Visual Title (TBA)", 
  type = "Visual", 
  status = "Coming in 2026",
  color = "var(--jazer-cyan)", 
  gradient = "linear-gradient(135deg, #1a1a2e 0%, #16213e 100%)",
  delay = 0 
} = Astro.props;
---

<article class="video-card group relative rounded-2xl overflow-hidden bg-[rgba(13,14,18,0.6)] border border-[rgba(255,255,255,0.08)] transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl animate-fade-up" style={`animation-delay: ${delay}ms`}>
  <!-- Thumbnail Area -->
  <div class="video-thumbnail relative aspect-video overflow-hidden">
    <!-- Gradient Placeholder -->
    <div class="absolute inset-0 transition-transform duration-700 group-hover:scale-105" style={`background: ${gradient};`}></div>
    
    <!-- Type Icon (Overlay) -->
    <div class="absolute inset-0 flex items-center justify-center opacity-30 pointer-events-none">
       <span class="text-4xl filter invert drop-shadow-lg">🎬</span>
    </div>

    <!-- Status Badge -->
    <div class="absolute top-3 left-3 z-10">
      <span class="px-3 py-1 rounded-md text-xs font-bold uppercase tracking-wider text-white shadow-sm" style={`background: ${color};`}>
        {status}
      </span>
    </div>

    <!-- Hover Overlay -->
    <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-sm">
      <a href="#updates" class="notify-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-black font-bold text-sm transform scale-90 group-hover:scale-100 transition-all duration-300">
        <span>🔔</span>
        <span>Get Notified</span>
      </a>
    </div>
  </div>

  <!-- Content Area -->
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="text-[10px] uppercase tracking-wider font-bold text-[var(--text-muted)] border border-[rgba(255,255,255,0.1)] px-2 py-0.5 rounded-full">
        {type}
      </span>
    </div>
    
    <h3 class="text-lg font-bold text-white mb-1 group-hover:text-[var(--jazer-cyan)] transition-colors">
      {title}
    </h3>
    
    <p class="text-sm text-[var(--text-muted)]">
      {status === 'Live' ? 'Watch Now' : 'Premiere waiting list open'}
    </p>
  </div>
</article>

<style>
  .animate-fade-up {
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
