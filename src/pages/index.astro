---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
    ? new URL(`${base}assets/images/JaZeR Main Logo.jpg`, site).toString()
    : `${base}assets/images/JaZeR Main Logo.jpg`;

const announcement = {
    href: `${base}music`,
    text: 'Coming in 2026'
};

const pathways = [
    {
        title: 'Music',
        href: `${base}music`,
        desc: 'Releases and playlists',
        icon: `${base}assets/images/icons/music/headphones-black.svg`
    },
    {
        title: 'Videos & Visuals',
        href: `${base}videos`,
        desc: 'Visuals and behind-the-scenes',
        icon: `${base}assets/images/icons/navigation/videos.svg`
    },
    {
        title: 'About',
        href: `${base}about`,
        desc: 'The story and mission',
        icon: `${base}assets/images/icons/navigation/about.svg`
    },
    {
        title: 'Shop',
        href: `${base}shop`,
        desc: 'Merch and essentials',
        icon: `${base}assets/images/icons/navigation/shop.svg`
    },
    {
        title: 'Contact',
        href: `${base}contact`,
        desc: 'Collaborations and inquiries',
        icon: `${base}assets/images/icons/navigation/contact.svg`
    }
];

const nextSteps = [
    {
        title: 'Next Release',
        desc: 'TBA',
        status: 'Coming in 2026'
    },
    {
        title: 'Visual Drop',
        desc: 'TBA',
        status: 'TBA'
    },
    {
        title: 'Merch',
        desc: 'TBD',
        status: 'Expected in 2026'
    }
];

const mutedStatuses = ['TBA', 'TBD'];
---
<BaseLayout
  bodyClass="home-page has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={false}
  showPreloader={false}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={false}
  showBackToTop={true}
  includeGsap={false}
  extraStyles={[
    '/css/home.css'
  ]}
>
  <Fragment slot="head">
    <title>JaZeR - Official Site</title>
    <meta name="title" content="JaZeR - Official Site" />
    <meta
      name="description"
      content="Official site of JaZeR. Explore music, videos & visuals, and the story behind the sound."
    />
    <meta
      name="keywords"
      content="JaZeR, music artist, content creator, visual storyteller"
    />
    <meta name="author" content="JaZeR" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="JaZeR - Official Site" />
    <meta
      property="og:description"
      content="Explore music, videos & visuals, and the story behind the sound."
    />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content="JaZeR - Official Site" />
    <meta
      property="twitter:description"
      content="Explore music, videos & visuals, and the story behind the sound."
    />
    <meta property="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonical} />
  </Fragment>

  <div class="home-bento-layout">
    <!-- LEFT COLUMN: HERO -->
    <section class="home-bento-left">
      <div class="hero-content home-hero-content" data-animate="fade-up">
        <img
          class="hero-logo"
          src={`${base}assets/images/Vibrant JAZER Bubble Logo (450 x 150 px).svg`}
          alt="JaZeR"
          width="450"
          height="150"
          decoding="async"
        />
        <span class="status-chip">Coming in 2026</span>
        <h1 class="jazer-h1 hero-title">Meet <span class="accent-glow">✦</span> The <span class="accent-glow">✦</span> Artist</h1>
        <div class="cta-group">
          <a href={`${base}music`} class="cta-button">Listen Now</a>
          <a href="#explore" class="cta-secondary">Explore</a>
        </div>

        <!-- JOIN BEAM (Moved to Left Col) -->
        <div class="hero-join-beam">
          <JoinBeamCTA
            id="updates"
            sectionClass="home-updates-mini"
            sectionStyle="padding: 1rem 0 0; background: transparent;"
            captureStyle="max-width: 100%; margin: 0;"
            subtitleStyle="font-size: 0.9rem; margin: 0.5rem 0;"
            subject="New subscriber from JaZeR Home page"
            buttonLabel="Join"
            proofText=""
          >
            <Fragment slot="subtitle">
              Join the Beam for updates & exclusive drops.
            </Fragment>
          </JoinBeamCTA>
        </div>
      </div>
    </section>

    <!-- RIGHT COLUMN: EXPLORE & UPDATES -->
    <section class="home-bento-right" id="explore">
      
      <!-- BENTO GRID -->
      <div class="bento-section">
        <h2 class="section-title gradient-text" data-animate="fade-up">Explore</h2>
        <p class="section-subtitle">Choose your frequency</p>
        
        <div class="bento-grid">
          {/* About Card - Featured Larger */}
          <a href={`${base}about`} class="bento-card bento-card--featured premium-card" data-animate="zoom-in">
            <div class="bento-icon">
              <img src={`${base}assets/images/icons/navigation/about.svg`} alt="" loading="lazy"/>
            </div>
            <div class="bento-content">
              <h3 class="jazer-h3">About</h3>
              <p class="text-muted">The story and mission</p>
              <span class="bento-cta">Discover →</span>
            </div>
          </a>

          {/* Other Cards */}
          {pathways.filter(p => p.title !== 'About').map((pathway, index) => (
            <a href={pathway.href} class="bento-card premium-card" data-animate="fade-up" data-animate-delay={index * 50}>
              <div class="bento-icon-sm">
                 <img src={pathway.icon} alt="" loading="lazy" />
              </div>
              <div class="bento-content">
                <h3 class="jazer-h5">{pathway.title}</h3>
                <p class="text-muted text-xs">{pathway.desc}</p>
                <span class="bento-cta-sm">Explore →</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- WHAT'S NEXT -->
      <div class="next-section">
        <h2 class="section-title gradient-text" data-animate="fade-up">What's Next</h2>
        <div class="next-grid next-grid--compact">
          {nextSteps.map((item, index) => (
            <div class="next-card next-card--compact" data-animate="fade-up" data-animate-delay={index * 60}>
              <h3 class="jazer-h6">{item.title}</h3>
              <span class={`status-chip status-chip--xs${mutedStatuses.includes(item.status) ? ' is-muted' : ''}`}>
                {item.status}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
  
  <!-- BOTTOM TICKER MARQUEE -->
  <div class="home-ticker">
    <div class="home-ticker-track">
      {[...Array(8)].map(() => (
        <>
          <span class="ticker-item">TBA</span>
          <span class="ticker-sep">::</span>
          <span class="ticker-item">JOIN THE BEAM</span>
          <span class="ticker-sep">::</span>
          <span class="ticker-item">EST. 2026</span>
          <span class="ticker-sep">::</span>
          <span class="ticker-item">WELCOME TO THE DATABANK</span>
          <span class="ticker-sep">::</span>
          <span class="ticker-item">LATEST TRANSMISSION: TBA</span>
          <span class="ticker-sep">::</span>
        </>
      ))}
    </div>
  </div>
