---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;

const announcement = {
  href: `${base}shop`,
  text: '🛍️ MERCH COMING SOMETIME IN 2026 - Sign up for early access!'
};

// Product Categories
const productCategories = [
  { name: 'All', filter: 'all', icon: '🎯' },
  { name: 'Apparel', filter: 'apparel', icon: '👕' },
  { name: 'Accessories', filter: 'accessories', icon: '🧢' },
  { name: 'Music', filter: 'music', icon: '💿' },
  { name: 'Bundles', filter: 'bundles', icon: '📦' }
];

// Size Guide Data
const sizeGuide = {
  tees: [
    { size: 'S', chest: '36"', length: '28"', shoulder: '17"' },
    { size: 'M', chest: '40"', length: '29"', shoulder: '18"' },
    { size: 'L', chest: '44"', length: '30"', shoulder: '19"' },
    { size: 'XL', chest: '48"', length: '31"', shoulder: '20"' },
    { size: '2XL', chest: '52"', length: '32"', shoulder: '21"' }
  ]
};

// Customer Reviews
const reviews = [
  { name: 'Early Supporter', rating: 5, text: "Can't wait for the drop! The mockups look fire 🔥", date: 'January 2026' },
  { name: 'Day One Fan', rating: 5, text: "Finally merch from JaZeR! Take my money already!", date: 'January 2026' },
  { name: 'Music Lover', rating: 5, text: "The designs are so clean. Definitely copping the hoodie.", date: 'January 2026' }
];

// Shipping Info
const shippingInfo = [
  { region: 'United States', time: '3-5 business days', cost: 'Free over $75' },
  { region: 'Canada', time: '5-7 business days', cost: '$12 flat rate' },
  { region: 'Europe', time: '7-14 business days', cost: 'Varies by country' },
  { region: 'Rest of World', time: '14-21 business days', cost: 'Calculated at checkout' }
];
---
<BaseLayout
  bodyClass="shop-page has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={false}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/pages-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Shop - JaZeR</title>
    <meta name="description" content="Shop JaZeR merchandise and exclusive items. Get early access to limited drops, premium apparel, and exclusive bundles." />
    <meta name="keywords" content="JaZeR shop, merchandise, merch, apparel, clothing, hoodies, t-shirts, limited edition" />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      as="image"
      href={`${base}assets/images/Shop (234 x 96 px).svg`}
      type="image/svg+xml"
    />

    <style>
      /* Shop Page Styles */
      html {
        scroll-behavior: smooth;
      }

      .shop-page {
        --shop-pink: #ef4444;
        --shop-purple: #8b5cf6;
        --shop-cyan: #06b6d4;
      }

      /* Coming Soon Badge Animation */
      .coming-soon-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(139, 92, 246, 0.2));
        border: 1px solid rgba(6, 182, 212, 0.4);
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--jazer-cyan);
        animation: badgePulse 2s ease infinite;
      }

      .coming-soon-badge::before {
        content: '';
        width: 8px;
        height: 8px;
        background: var(--jazer-cyan);
        border-radius: 50%;
        animation: blink 1.5s infinite;
      }

      @keyframes badgePulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.4); }
        50% { box-shadow: 0 0 20px 5px rgba(6, 182, 212, 0.2); }
      }

      /* Enhanced Shop Cards with Glow */
      .shop-card-enhanced {
        position: relative;
        background: rgba(10, 10, 20, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .shop-card-enhanced::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .shop-card-enhanced:hover::before {
        opacity: 1;
      }

      .shop-card-enhanced:hover {
        transform: translateY(-8px) scale(1.02);
        border-color: rgba(6, 182, 212, 0.5);
        box-shadow: 
          0 20px 40px rgba(0, 0, 0, 0.4),
          0 0 30px rgba(6, 182, 212, 0.2),
          inset 0 1px 0 rgba(255, 255, 255, 0.1);
      }

      /* Floating Status Indicator */
      .status-indicator {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.8rem;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        border-radius: 20px;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--jazer-cyan);
        z-index: 2;
      }

      .status-indicator::before {
        content: '';
        width: 6px;
        height: 6px;
        background: var(--jazer-cyan);
        border-radius: 50%;
        animation: blink 1.5s infinite;
      }

      /* Improved Product Image Placeholder */
      .product-placeholder {
        position: relative;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #0a0a1a 0%, #1a1a2e 50%, #0f0f1f 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        overflow: hidden;
      }

      .product-placeholder::before {
        content: '';
        position: absolute;
        width: 200%;
        height: 200%;
        background: conic-gradient(
          from 0deg,
          transparent 0%,
          rgba(6, 182, 212, 0.1) 25%,
          transparent 50%,
          rgba(139, 92, 246, 0.1) 75%,
          transparent 100%
        );
        animation: rotateSlow 20s linear infinite;
      }

      @keyframes rotateSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .product-placeholder-icon {
        font-size: 3rem;
        opacity: 0.3;
        z-index: 1;
      }

      .product-placeholder-text {
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.3);
        z-index: 1;
      }

      /* Improved Timeline */
      .timeline-step-enhanced {
        position: relative;
        padding: 2rem 2.5rem;
        background: rgba(10, 10, 20, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        margin-bottom: 1.5rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
      }

      .timeline-step-enhanced::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, var(--jazer-cyan), var(--jazer-purple));
        opacity: 0.5;
        transition: opacity 0.3s ease;
      }

      .timeline-step-enhanced:hover::before {
        opacity: 1;
      }

      .timeline-step-enhanced:hover {
        transform: translateX(8px);
        background: rgba(6, 182, 212, 0.05);
        border-color: rgba(6, 182, 212, 0.3);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      }

      .timeline-phase-tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(6, 182, 212, 0.2);
        border: 1px solid rgba(6, 182, 212, 0.3);
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--jazer-cyan);
        margin-bottom: 0.75rem;
      }

      /* Notify Button Enhancement */
      .notify-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple));
        border: none;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }

      .notify-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--jazer-purple), var(--jazer-pink));
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      .notify-btn:hover::before {
        opacity: 1;
      }

      .notify-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(6, 182, 212, 0.4);
      }

      .notify-btn span {
        position: relative;
        z-index: 1;
      }

      /* Section Divider */
      .section-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(6, 182, 212, 0.3), rgba(139, 92, 246, 0.3), transparent);
        margin: 4rem 0;
      }

      /* Hero Section */
      .page-hero {
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 1rem;
        text-align: center;
      }

      .page-hero-title-logo {
        max-width: 100%;
        height: auto;
        margin-bottom: 1.5rem;
      }

      .page-hero-subtitle {
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--text-secondary);
        margin-bottom: 2rem;
      }

      /* Drop Countdown */
      .drop-countdown {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 2rem;
      }

      .countdown-label {
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
      }

      .countdown-time {
        font-size: 3rem;
        font-weight: 800;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .countdown-note {
        font-size: 0.875rem;
        color: var(--text-muted);
      }

      /* Email Capture */
      .hero-email-capture {
        max-width: 500px;
        margin: 2rem auto;
      }

      .hero-email-copy {
        font-size: 1rem;
        margin-bottom: 1rem;
        color: var(--text-secondary);
      }

      .hero-email-form {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        justify-content: center;
      }

      .hero-email-form .modern-input {
        flex: 1;
        min-width: 250px;
      }

      /* Page Intro */
      .page-intro-icon {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.7;
      }

      /* Shop Sections */
      .shop-section {
        margin-bottom: 4rem;
      }

      .shop-section-header {
        text-align: center;
        margin-bottom: 2rem;
      }

      .shop-section-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .shop-section-subtitle {
        font-size: 1rem;
        color: var(--text-muted);
        line-height: 1.6;
      }

      /* Shop Cards */
      .shop-featured-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .shop-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .shop-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      }

      .shop-card-media {
        position: relative;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .shop-card-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: var(--jazer-pink);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .shop-card-placeholder {
        font-size: 1.5rem;
        color: var(--text-muted);
        font-weight: 600;
      }

      .shop-card-title {
        padding: 1.5rem 1.5rem 0.5rem;
        font-size: 1.25rem;
        font-weight: 600;
      }

      .shop-card-meta {
        padding: 0 1.5rem 1rem;
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      .shop-interest-form {
        padding: 0 1.5rem 1.5rem;
        display: flex;
        gap: 0.5rem;
      }

      .shop-interest-input {
        flex: 1;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-primary);
        padding: 0.5rem 0.75rem;
        border-radius: 8px;
        font-size: 0.875rem;
        transition: border-color 0.2s ease;
      }

      .shop-interest-input:focus {
        outline: none;
        border-color: var(--jazer-cyan);
      }

      .shop-interest-input::placeholder {
        color: var(--text-muted);
      }

      .shop-interest-button {
        background: var(--jazer-cyan);
        color: white;
        border: none;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
      }

      .shop-interest-button:hover {
        background: #0891b2;
        transform: translateY(-2px);
      }

      /* Drop Timeline System Log */
      .drop-timeline {
        position: relative;
        max-width: 600px;
        margin: 0 auto;
        padding-left: 2rem;
        border-left: 2px solid rgba(255, 255, 255, 0.1);
      }

      .timeline-step {
        position: relative;
        padding: 1.5rem 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        margin-bottom: 2rem;
        text-align: left;
        transition: all 0.3s ease;
      }

      .timeline-step::before {
        content: '';
        position: absolute;
        left: -2.6rem; /* Adjust to align with border */
        top: 50%;
        transform: translateY(-50%);
        width: 12px; height: 12px;
        background: #000;
        border: 2px solid var(--jazer-cyan);
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
      }

      .timeline-step:hover {
        transform: translateX(10px);
        border-color: var(--jazer-cyan);
        box-shadow: 0 0 20px rgba(6, 182, 212, 0.1);
      }
      .timeline-step:hover::before {
        background: var(--jazer-cyan);
      }

      .timeline-title {
        font-family: 'Courier New', monospace;
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--jazer-cyan);
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .timeline-meta {
        color: var(--text-secondary);
        font-size: 0.9rem;
      }

      /* Tech Specs Bento */
      .tech-specs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .spec-card {
        background: rgba(10, 10, 20, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 2rem;
        transition: border-color 0.3s ease;
      }
      .spec-card:hover { border-color: var(--jazer-purple); }
      
      .spec-header {
          display: flex;
          align-items: center;
          gap: 1rem;
          margin-bottom: 1.5rem;
          border-bottom: 1px solid rgba(255,255,255,0.1);
          padding-bottom: 1rem;
      }
      .spec-icon { width: 24px; height: 24px; filter: invert(1); opacity: 0.7; }
      
      .spec-title {
          font-size: 1.25rem;
          font-weight: 600;
          color: white;
      }
      
      .spec-list {
          display: flex;
          flex-direction: column;
          gap: 1rem;
      }
      
      .spec-row {
          display: flex;
          justify-content: space-between;
          font-size: 0.9rem;
      }
      .spec-key { color: var(--text-muted); }
      .spec-val { color: white; font-weight: 500; text-align: right; }
      
      .grid-span-2 { grid-column: span 2; }
      @media (max-width: 768px) { .grid-span-2 { grid-column: 1; } }

      /* Design Story */
      .design-story {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        align-items: center;
        margin-top: 2rem;
      }

      .design-visual {
        aspect-ratio: 16 / 9;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--text-muted);
        font-weight: 600;
      }

      .design-copy {
        padding: 1rem;
      }

      .design-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      .design-text {
        margin-bottom: 1rem;
        line-height: 1.7;
        color: var(--text-secondary);
      }

      .design-text:last-child {
        margin-bottom: 0;
      }

      /* Materials Grid */
      .materials-grid,
      .shipping-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .material-card,
      .shipping-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        transition: transform 0.2s ease;
      }

      .material-card:hover,
      .shipping-card:hover {
        transform: translateY(-4px);
      }

      .material-title,
      .shipping-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        color: var(--jazer-purple);
      }

      .material-text,
      .shipping-text {
        color: var(--text-muted);
        line-height: 1.6;
      }

      /* Size Guide */
      .size-guide {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .size-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        text-align: center;
        transition: transform 0.2s ease;
      }

      .size-card:hover {
        transform: translateY(-4px);
      }

      .size-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }

      .size-text {
        color: var(--text-muted);
        font-size: 0.875rem;
      }

      /* Bundle Builder */
      .bundle-builder {
        margin-top: 2rem;
      }

      .bundle-card {
        padding: 3rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        text-align: center;
        position: relative;
      }

      .bundle-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
      }

      .bundle-text {
        color: var(--text-muted);
        margin-bottom: 1.5rem;
      }

      .bundle-tag {
        display: inline-block;
        background: var(--jazer-cyan);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
      }

      /* Mockup Carousel */
      .mockup-carousel {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .mockup-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.2s ease;
      }

      .mockup-card:hover {
        transform: translateY(-4px);
      }

      .mockup-art {
        aspect-ratio: 1;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--text-muted);
        font-weight: 600;
      }

      .mockup-caption {
        padding: 1rem;
        text-align: center;
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      .mockup-note {
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.875rem;
      }

      /* Tier Grid */
      .tier-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      .tier-card {
        padding: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;
        transition: transform 0.3s ease, border-color 0.3s ease;
      }

      .tier-card:hover {
        transform: translateY(-4px);
        border-color: var(--jazer-cyan);
      }

      .tier-name {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .tier-price {
        color: var(--jazer-cyan);
        font-size: 1.125rem;
