---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
  ? new URL(`${base}assets/images/JaZeR Main Logo.jpg`, site).toString()
  : `${base}assets/images/JaZeR Main Logo.jpg`;

const announcement = {
  href: `${base}music`,
  text: '🎵 MUSIC COMING IN 2026 — Join the beam for updates'
};

// Transmission Log (Unified Release Data)
const releases = [
  { 
    id: 'rel-001',
    title: 'Project: Aether', 
    type: 'Single', 
    status: 'Coming in 2026',
    year: '2026',
    gradient: 'gradient-1',
    description: 'The first signal.',
    cta: 'Get Notified'
  },
  { 
    id: 'rel-002',
    title: 'Phase 1: Ignition', 
    type: 'EP', 
    status: 'Expected in 2026',
    year: '2026',
    gradient: 'gradient-2',
    description: 'Details encrypted.',
    cta: 'Get Notified'
  },
  { 
    id: 'rel-003',
    title: 'Concept: Void', 
    type: 'TBA', 
    status: 'Coming in 2026',
    year: '2026',
    gradient: 'gradient-3',
    description: 'Classified.',
    cta: 'Get Notified'
  }
];

// Streaming Platforms
const streamingPlatforms = [
  { name: 'Spotify', href: '#', icon: 'music-note-black.svg', color: '#1DB954' },
  { name: 'Apple Music', href: '#', icon: 'playlist-black.svg', color: '#FA233B' },
  { name: 'SoundCloud', href: '#', icon: 'soundcloud-round-icon.svg', color: '#FF5500', isRound: true },
  { name: 'YouTube', href: '#', icon: 'youtube-round-icon.svg', color: '#FF0000', isRound: true },
  { name: 'Tidal', href: '#', icon: 'album-black.svg', color: '#000000' },
  { name: 'Amazon Music', href: '#', icon: 'playlist-black.svg', color: '#25D1DA' }
];

// FAQ Items
const faqItems = [
  {
    question: 'When will music be available?',
    answer: 'The first releases are expected sometime in 2026. Join updates to be notified when music drops.'
  },
  {
    question: 'Where can I listen?',
    answer: 'Music will be available on all major streaming platforms including Spotify, Apple Music, YouTube Music, and more when released.'
  },
  {
    question: 'How do I get notified about new releases?',
    answer: 'Join the beam using the signup form below — you\'ll be first to know about releases, updates, and exclusive content.'
  }
];
---
<BaseLayout
  bodyClass="has-announcement music-page"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={false}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/music-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Music - JaZeR</title>
    <meta name="title" content="Music - JaZeR" />
    <meta
      name="description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links. Listen now on Spotify, Apple Music, and all major platforms."
    />
    <meta
      name="keywords"
      content="JaZeR, music, releases, discography, electronic music, streaming, Spotify, Apple Music, hip-hop, rap, melodic"
    />
    <meta name="author" content="JaZeR" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Music - JaZeR" />
    <meta
      property="og:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="og:image"
      content={ogImage}
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content="Music - JaZeR" />
    <meta
      property="twitter:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="twitter:image"
      content={ogImage}
    />

    <link rel="canonical" href={canonical} />
    
    <style>
      /* Page-Specific Overrides */
      .music-hero-section {
          min-height: 80vh;
          display: flex;
          align-items: center;
          position: relative;
          background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.05), transparent 60%),
                      radial-gradient(circle at bottom left, rgba(6, 182, 212, 0.05), transparent 60%);
          overflow: hidden;
      }

      /* Sonic Waveform Background */
      .sonic-waveform-bg {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0.15;
          pointer-events: none;
          z-index: 0;
      }
      .waveform-line {
          width: 6px;
          height: 100px;
          margin: 0 4px;
          background: var(--jazer-cyan);
          border-radius: 4px;
          animation: sonicPulse 3s ease-in-out infinite;
          animation-delay: calc(var(--i) * 0.1s);
      }
      @keyframes sonicPulse {
          0%, 100% { height: 15%; opacity: 0.1; }
          50% { height: 70%; opacity: 0.4; }
      }

      .music-hero-content {
          z-index: 2;
          max-width: 800px;
          margin: 0 auto;
          text-align: center;
      }

      .hero-eyebrow {
          font-family: 'Courier New', monospace;
          color: var(--jazer-cyan);
          font-size: 0.875rem;
          margin-bottom: 1.5rem;
          letter-spacing: 0.2em;
          display: inline-flex;
          align-items: center;
          gap: 0.75rem;
          padding: 0.5rem 1rem;
          background: rgba(6, 182, 212, 0.1);
          border-radius: 4px;
          border: 1px solid rgba(6, 182, 212, 0.2);
      }
      .eyebrow-dot {
          width: 6px; height: 6px;
          background: var(--jazer-cyan);
          box-shadow: 0 0 8px var(--jazer-cyan);
          border-radius: 50%;
          animation: blink 2s infinite;
      }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

      .music-hero-title-text {
          font-family: var(--font-primary);
          font-size: clamp(3rem, 8vw, 6rem);
          font-weight: 900;
          line-height: 1;
          margin-bottom: 1.5rem;
          letter-spacing: -0.02em;
          background: linear-gradient(135deg, #fff 0%, #a5f3fc 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          text-shadow: 0 0 30px rgba(6, 182, 212, 0.3);
      }

      .music-hero-description {
          font-size: 1.25rem;
          color: var(--text-muted);
          max-width: 600px;
          margin: 0 auto 2.5rem;
          line-height: 1.6;
      }

      /* Discography Grid */
      .discography-section {
          padding: 4rem 0;
          position: relative;
          z-index: 2;
      }
      
      .discography-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
          gap: 2rem;
          margin-top: 3rem;
      }

      .release-card {
          background: rgba(15, 15, 20, 0.6);
          border: 1px solid rgba(255, 255, 255, 0.05);
          border-radius: 16px;
          overflow: hidden;
          transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
          group: hover;
      }
      .release-card:hover {
          transform: translateY(-8px);
          border-color: rgba(6, 182, 212, 0.3);
          box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
      }

      .release-cover {
          aspect-ratio: 1;
          background: #111;
          position: relative;
          overflow: hidden;
      }
      
      .cover-placeholder {
          width: 100%; height: 100%;
          transition: transform 0.6s ease;
      }
      .release-card:hover .cover-placeholder {
          transform: scale(1.05);
      }

      .status-overlay {
          position: absolute;
          top: 1rem; right: 1rem;
          z-index: 2;
      }
      .status-badge {
          background: rgba(0, 0, 0, 0.8);
          backdrop-filter: blur(4px);
          color: var(--jazer-cyan);
          font-family: 'Courier New', monospace;
          font-size: 0.75rem;
          font-weight: 700;
          padding: 0.35rem 0.75rem;
          border-radius: 4px;
          border: 1px solid rgba(6, 182, 212, 0.3);
          text-transform: uppercase;
          letter-spacing: 0.05em;
      }

      .release-details {
          padding: 1.5rem;
      }
      .release-title {
          font-size: 1.5rem;
          font-weight: 700;
          color: white;
          margin-bottom: 0.5rem;
      }
      .release-meta {
          color: var(--text-muted);
          font-size: 0.875rem;
          margin-bottom: 1.5rem;
          display: flex;
          gap: 0.75rem;
          align-items: center;
      }
      .meta-divider {
          width: 4px; height: 4px;
          background: var(--text-muted);
          border-radius: 50%;
          opacity: 0.5;
      }

      .release-link {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          color: var(--jazer-cyan);
          font-weight: 600;
          font-size: 0.875rem;
          text-decoration: none;
          transition: gap 0.3s ease;
      }
      .release-link:hover {
          gap: 0.75rem;
          text-shadow: 0 0 10px rgba(6, 182, 212, 0.6);
      }

      /* Platform Grid */
      .platform-grid {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          gap: 1.5rem;
          margin-top: 3rem;
      }
      .platform-pill {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          padding: 0.75rem 1.5rem;
          background: rgba(255,255,255,0.03);
          border: 1px solid rgba(255,255,255,0.1);
          border-radius: 100px;
          color: var(--text-light);
          text-decoration: none;
          transition: all 0.3s ease;
      }
      .platform-pill:hover {
          background: rgba(255,255,255,0.1);
          transform: translateY(-2px);
      }
      .platform-pill img {
          width: 20px; height: 20px;
          filter: grayscale(1);
          transition: filter 0.3s ease;
      }
      .platform-pill:hover img {
          filter: grayscale(0);
      }

      @media (max-width: 768px) {
        .music-hero-section { min-height: auto; padding: 6rem 0 4rem; }
        .discography-grid { grid-template-columns: 1fr; }
      }
    </style>
  </Fragment>

  <!-- Hero Section -->
  <section class="music-hero-section">
    <div class="sonic-waveform-bg" aria-hidden="true">
      {[...Array(15)].map((_, i) => (
        <div class="waveform-line" style={`--i: ${i + 1}`}></div>
      ))}
    </div>

    <div class="container music-hero-content" data-animate="fade-up">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>SYSTEM STATUS: ONLINE</span>
      </div>
      
      <h1 class="music-hero-title-text" style="background: none; -webkit-text-fill-color: initial;">
        <img 
          src={`${base}assets/images/Featured Content (450 x 150 px).svg`} 
          alt="Featured Content" 
          style="width: 100%; max-width: 600px; height: auto; filter: drop-shadow(0 0 30px rgba(6, 182, 212, 0.3));"
        />
      </h1>
      
      <p class="music-hero-description">
        The archive of JaZeR's auditory transmissions. <br/>
        First signals expected to materialize in 2026.
      </p>
      
      <div class="hero-nav-links" style="display: flex; justify-content: center; gap: 1rem;">
        <a href="#transmission-log" class="system-button">Transmission Log</a>
        <a href="#join-beam" class="system-button" style="background: transparent;">Get Updates</a>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Transmission Log (Releases) -->
  <section id="transmission-log" class="discography-section section">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Transmission Log</h2>
        <p class="section-subtitle">Incoming signals and scheduled releases</p>
      </div>
      
      <div class="discography-grid">
        {releases.map((release, index) => (
          <article class="release-card" data-animate="fade-up" style={`--delay: ${index * 0.1}s`}>
            <div class="release-cover">
              <div class={`cover-placeholder ${release.gradient}`} aria-hidden="true"></div>
              <div class="status-overlay" aria-hidden="true">
                <span class="status-badge">{release.status}</span>
              </div>
            </div>
            <div class="release-details">
              <h3 class="release-title">{release.title}</h3>
              <div class="release-meta">
                <span>{release.type}</span>
                <span class="meta-divider"></span>
                <span>{release.year}</span>
              </div>
              <p style="color: var(--text-gray); font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
                {release.description}
              </p>
              <a href="#join-beam" class="release-link">
                {release.cta} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Featured Track Section: System Preview -->
  <section class="featured-track-section section">
    <div class="container">
      <div class="featured-track-container premium-card" data-animate="fade-up">
        <!-- Visual (Vinyl) - Left Side -->
        <div class="featured-track-visual">
           <div class="vinyl-container">
             <div class="vinyl-record">
               <div class="vinyl-grooves"></div>
               <div class="vinyl-label">
                 <img src={`${base}assets/images/JZR-Circle-Monogram-Logo (500 x 500 px).svg`} alt="JZR" class="label-logo" />
               </div>
               <div class="vinyl-shine"></div>
             </div>
           </div>
        </div>
      
        <div class="featured-track-info">
          <div class="featured-header">
            <span class="featured-badge-pill">🔥 New Release</span>
          </div>
          <h2 class="featured-title">In Due Time</h2>
          <p class="featured-artist">JaZeR</p>
          
          <!-- Visualizer Bars -->
          <div class="audio-visualizer">
            <div class="bar" style="--h: 40%"></div>
            <div class="bar" style="--h: 70%"></div>
            <div class="bar" style="--h: 50%"></div>
            <div class="bar" style="--h: 90%"></div>
            <div class="bar" style="--h: 60%"></div>
            <div class="bar" style="--h: 80%"></div>
            <div class="bar" style="--h: 50%"></div>
          </div>

          <div class="featured-meta-row">
            <span class="meta-tag highlight">4:34</span>
            <span class="meta-tag">MELODIC HIP-HOP • RAP</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Streaming Platforms (Pre-save / Profiles) -->
  <section id="platforms" class="section-sm" style="background: rgba(10,10,20,0.5);">
    <div class="container">
      <div class="text-center" data-animate="fade-up">
        <h2 class="section-title text-center" style="font-size: 1.75rem;">Network Channels</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">
          Connect on major frequencies. Content populating in 2026.
        </p>
        
        <div class="platform-grid">
          {streamingPlatforms.map((platform) => (
            <a 
              href={platform.href} 
              class="platform-pill"
              aria-label={`${platform.name} - Coming soon`}
            >
              <img 
                src={`${base}assets/images/icons/${platform.isRound ? 'social' : 'music'}/${platform.icon}`} 
                alt="" 
                loading="lazy" 
              />
              <span>{platform.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- FAQ Section -->
  <section class="section" style="padding: 4rem 0;">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Frequencies FAQ</h2>
      </div>
      
      <div style="max-width: 700px; margin: 2rem auto; display: grid; gap: 1rem;">
        {faqItems.map((item, index) => (
          <div class="premium-glass-card" style="padding: 1.5rem 2rem; border-left: 3px solid var(--jazer-cyan);" data-animate="fade-up" data-animate-delay={index * 100}>
            <h3 style="font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; color: #fff;">
              {item.question}
            </h3>
            <p style="color: var(--text-muted); line-height: 1.6; font-size: 0.938rem; margin: 0;">
              {item.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Email Signup CTA -->
  <div id="join-beam" style="scroll-margin-top: 100px;">
    <JoinBeamCTA
      sectionStyle="padding: 6rem 0;"
      captureStyle="max-width: 700px; margin: 0 auto;"
      subtitleStyle="font-size: 1.125rem; max-width: 500px; margin: 1.5rem auto;"
      subject="New subscriber from JaZeR Music page"
      buttonLabel="Initialize Uplink"
      proofText="Join 200+ others waiting for the signal"
    >
      <Fragment slot="subtitle">
        Secure your place in the beam. Priority access to transmissions, visuals, and data drops in 2026.
      </Fragment>
    </JoinBeamCTA>
  </div>

</BaseLayout>

