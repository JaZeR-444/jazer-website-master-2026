---
<BaseLayout
  bodyClass="has-announcement music-page"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/music-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Music - JaZeR</title>
    <meta name="title" content="Music - JaZeR" />
    <meta
      name="description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links. Listen now on Spotify, Apple Music, and all major platforms."
    />
    <meta
      name="keywords"
      content="JaZeR, music, releases, discography, electronic music, streaming, Spotify, Apple Music, hip-hop, rap, melodic"
    />
    <meta name="author" content="JaZeR" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Music - JaZeR" />
    <meta
      property="og:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="og:image"
      content={ogImage}
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content="Music - JaZeR" />
    <meta
      property="twitter:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="twitter:image"
      content={ogImage}
    />

    <link rel="canonical" href={canonical} />
    
    <style>
      .music-hero-section {
          min-height: 85vh;
          display: flex;
          align-items: center;
          position: relative;
          background: radial-gradient(circle at top right, rgba(139, 92, 246, 0.1), transparent 60%),
                      radial-gradient(circle at bottom left, rgba(6, 182, 212, 0.1), transparent 60%);
          overflow: hidden;
      }

      /* Sonic Waveform Background */
      .sonic-waveform-bg {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0.1;
          pointer-events: none;
          z-index: 0;
      }
      .waveform-line {
          width: 4px;
          height: 100px;
          margin: 0 2px;
          background: var(--jazer-cyan);
          border-radius: 2px;
          animation: sonicPulse 2s ease-in-out infinite;
          animation-delay: calc(var(--i) * 0.05s);
      }
      @keyframes sonicPulse {
          0%, 100% { height: 10%; opacity: 0.2; }
          50% { height: 80%; opacity: 0.8; }
      }

      .music-hero-content {
          z-index: 2;
          max-width: 600px;
      }

      .hero-eyebrow {
          font-family: 'Courier New', monospace;
          color: var(--jazer-cyan);
          font-size: 0.875rem;
          margin-bottom: 1rem;
          letter-spacing: 0.05em;
          display: flex;
          align-items: center;
          gap: 0.5rem;
      }
      .eyebrow-dot {
          width: 8px; height: 8px;
          background: var(--jazer-cyan);
          box-shadow: 0 0 8px var(--jazer-cyan);
          border-radius: 50%;
      }

      .music-hero-title-graphic {
          margin-bottom: 1.5rem;
          display: flex;
      }
      .music-hero-title-graphic img {
          width: 100%;
          max-width: 450px;
          height: auto;
          display: block;
          filter: drop-shadow(0 0 20px rgba(6, 182, 212, 0.3));
      }

      /* Holographic Disc */
      .holographic-disc-container {
          perspective: 1000px;
          display: flex;
          justify-content: center;
          align-items: center;
      }
      .holographic-disc {
          width: 400px;
          height: 400px;
          border-radius: 50%;
          background: 
              conic-gradient(from 0deg, transparent 0%, rgba(255,255,255,0.1) 20%, transparent 40%),
              radial-gradient(circle at center, #000 25%, #111 26%, #222 65%, rgba(6,182,212,0.2) 66%, transparent 70%);
          position: relative;
          box-shadow: 0 0 50px rgba(139, 92, 246, 0.2);
          animation: discSpin 20s linear infinite;
          transform-style: preserve-3d;
          border: 1px solid rgba(255,255,255,0.1);
      }
      .disc-reflection {
          position: absolute;
          inset: 0;
          border-radius: 50%;
          background: linear-gradient(135deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
          animation: reflectionMove 5s ease-in-out infinite;
      }
      .disc-art {
          position: absolute;
          top: 50%; left: 50%;
          transform: translate(-50%, -50%);
          width: 250px; height: 250px;
          border-radius: 50%;
          object-fit: cover;
          box-shadow: 0 0 30px rgba(0,0,0,0.8);
          z-index: 2;
      }
      @keyframes discSpin { from { transform: rotate(0deg) rotateX(10deg); } to { transform: rotate(360deg) rotateX(10deg); } }
      @keyframes reflectionMove { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.7; } }

      /* Portal Cards (Streaming) */
      .portal-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
          gap: 1.5rem;
          margin-top: 3rem;
      }
      .portal-card {
          position: relative;
          padding: 1.5rem;
          background: rgba(10, 10, 20, 0.8);
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 12px;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 1rem;
          overflow: hidden;
          transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
          text-decoration: none;
      }
      .portal-card::before {
          content: '';
          position: absolute;
          inset: 0;
          background: radial-gradient(circle at center, var(--hover-color), transparent 70%);
          opacity: 0;
          transition: opacity 0.3s ease;
      }
      .portal-card:hover {
          transform: translateY(-5px) scale(1.02);
          border-color: rgba(255,255,255,0.3);
      }
      .portal-card:hover::before { opacity: 0.15; }
      
      .portal-icon { width: 40px; height: 40px; z-index: 1; filter: invert(1); }
      .portal-name { font-size: 0.875rem; font-weight: 600; color: white; z-index: 1; }

      /* Featured Track Section */
      .featured-track-container {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 3rem;
        align-items: center;
        padding: 3rem;
      }
      .featured-track-visual {
        display: flex;
        justify-content: center;
      }
      .featured-track-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .featured-meta-row {
        display: flex;
        gap: 1rem;
        margin: 1rem 0;
        flex-wrap: wrap;
      }

      /* Responsive */
      @media (max-width: 992px) {
          .music-hero-container { grid-template-columns: 1fr; text-align: center; }
          .music-hero-content { margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
          .hero-eyebrow { justify-content: center; }
          .music-hero-title-graphic { justify-content: center; }
          .holographic-disc { width: 300px; height: 300px; margin: 3rem auto; }
          .disc-art { width: 180px; height: 180px; }
          
          .featured-track-container {
            grid-template-columns: 1fr;
            gap: 2rem;
            text-align: center;
            padding: 2rem;
          }
          .featured-track-info {
            align-items: center;
          }
          .featured-meta-row {
            justify-content: center;
          }
           .music-hero-section { min-height: auto; padding: 6rem 0 4rem; }
      }

      @media (max-width: 768px) {
          .music-hero-section { min-height: auto; padding: 4rem 0 3rem; }
          .music-hero-title-graphic img { max-width: 280px; }
          .portal-grid { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); width: 100%; }
          .holographic-disc { width: 220px; height: 220px; margin: 2rem auto; }
          .disc-art { width: 130px; height: 130px; }
          .music-hero-description { font-size: 1rem; padding: 0 1rem; }
          
          .featured-track-container {
            padding: 1.5rem;
          }
          .featured-header {
             display: flex;
             justify-content: center;
          }
      }

      /* System Button */
      .system-button {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          padding: 0.75rem 1.5rem;
          background: rgba(6, 182, 212, 0.1);
          border: 1px solid var(--jazer-cyan);
          color: var(--jazer-cyan);
          font-weight: 600;
          font-size: 0.875rem;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          border-radius: 4px;
          cursor: pointer;
          transition: all 0.3s ease;
      }
      .system-button:hover {
          background: var(--jazer-cyan);
          color: #000;
          box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
      }
      .system-button img {
          filter: invert(36%) sepia(93%) saturate(1836%) hue-rotate(162deg) brightness(94%) contrast(101%); /* cyan filter equivalent or use mask */
          transition: filter 0.3s ease;
      }
      .system-button:hover img {
          filter: invert(0);
      }

      /* Transmission End Divider */
      .transmission-end {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 1rem;
          padding: 2rem 0 4rem;
          color: rgba(255, 255, 255, 0.3);
          font-family: 'Courier New', monospace;
          letter-spacing: 0.2em;
          font-size: 0.75rem;
          text-transform: uppercase;
      }
      .transmission-line {
          height: 1px;
          width: 100px;
          background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      }
    </style>
  </Fragment>

  <!-- Sonic Hero Section -->
  <section class="music-hero-section">
    <div class="sonic-waveform-bg">
        <div class="waveform-line" style="--i: 1"></div>
        <div class="waveform-line" style="--i: 2"></div>
        <div class="waveform-line" style="--i: 3"></div>
        <div class="waveform-line" style="--i: 4"></div>
        <div class="waveform-line" style="--i: 5"></div>
        <div class="waveform-line" style="--i: 6"></div>
        <div class="waveform-line" style="--i: 7"></div>
        <div class="waveform-line" style="--i: 8"></div>
        <div class="waveform-line" style="--i: 9"></div>
        <div class="waveform-line" style="--i: 10"></div>
    </div>

    <div class="container music-hero-container">
      <div class="music-hero-content" data-animate="fade-right">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>SONIC DATABANK // V.2026</span>
        </div>
        <div class="music-hero-title-graphic">
          <img 
            src={`${base}assets/images/Transmission Incoming (429 x 150 px).svg`} 
            alt="Transmission Incoming" 
            width="429" 
            height="150"
            loading="eager"
            decoding="async"
          />
        </div>
        <p class="music-hero-description">
          Compiling the next generation of sound. The first wave of the JaZeR signal arrives 2026.
        </p>
        
        <div class="portal-grid">
            <a href="#" class="portal-card" style="--hover-color: #1DB954;">
                 <img src={`${base}assets/images/icons/music/music-note-black.svg`} alt="Spotify" class="portal-icon" />
                 <span class="portal-name">Spotify</span>
            </a>
            <a href="#" class="portal-card" style="--hover-color: #FA233B;">
                 <img src={`${base}assets/images/icons/music/playlist-black.svg`} alt="Apple Music" class="portal-icon" />
                 <span class="portal-name">Apple Music</span>
            </a>
            <a href="#" class="portal-card" style="--hover-color: #000000;">
                 <img src={`${base}assets/images/icons/music/album-black.svg`} alt="Tidal" class="portal-icon" />
                 <span class="portal-name">Tidal</span>
            </a>
        </div>
      </div>

      <div class="music-hero-visual" data-animate="fade-left">
         <div class="holographic-disc-container">
             <div class="holographic-disc">
                 <div class="disc-reflection"></div>
                 <img src={`${base}assets/images/jazer-cosmic-soundbirth.png`} alt="Cosmic Soundbirth" class="disc-art" />
             </div>
         </div>
      </div>
    </div>

    <!-- Animated Waveform Divider -->
    <div class="music-waveform-divider" aria-hidden="true">
      <div class="waveform-bar" style="--delay: 0s; --height: 40%;"></div>
      <div class="waveform-bar" style="--delay: 0.1s; --height: 70%;"></div>
      <div class="waveform-bar" style="--delay: 0.2s; --height: 50%;"></div>
      <div class="waveform-bar" style="--delay: 0.3s; --height: 80%;"></div>
      <div class="waveform-bar" style="--delay: 0.4s; --height: 60%;"></div>
      <div class="waveform-bar" style="--delay: 0.5s; --height: 90%;"></div>
      <div class="waveform-bar" style="--delay: 0.6s; --height: 65%;"></div>
      <div class="waveform-bar" style="--delay: 0.7s; --height: 75%;"></div>
      <div class="waveform-bar" style="--delay: 0.8s; --height: 55%;"></div>
      <div class="waveform-bar" style="--delay: 0.9s; --height: 85%;"></div>
      <div class="waveform-bar" style="--delay: 1s; --height: 45%;"></div>
      <div class="waveform-bar" style="--delay: 1.1s; --height: 95%;"></div>
    </div>
  </section>

  <!-- Discography Section: Project Roadmap -->
  <section class="discography-section section">
    <div class="container">
      <h2 class="section-title text-center gradient-text" data-animate="fade-up">Transmission Log: 2026</h2>
      <div class="discography-grid">
        <!-- Roadmap Item 1 -->
        <article class="release-card" data-animate="fade-up" style="--delay: 0s">
          <div class="release-cover">
            <div class="cover-placeholder gradient-1" aria-hidden="true"></div>
            <div class="status-overlay" aria-hidden="true">
              <span class="status-badge status-badge-rotate-left">Confidential</span>
            </div>
          </div>
          <div class="release-details">
            <h3 class="release-title">Project: Aether</h3>
            <p class="release-meta">Single • Spring 2026</p>
            <span class="release-link release-link-muted" aria-label="Project Aether status">Status: Locked 🔒</span>
          </div>
        </article>

        <!-- Roadmap Item 2 -->
        <article class="release-card" data-animate="fade-up" style="--delay: 0.1s">
          <div class="release-cover">
            <div class="cover-placeholder gradient-2" aria-hidden="true"></div>
            <div class="status-overlay" aria-hidden="true">
              <span class="status-badge status-badge-cyan">Compiling</span>
            </div>
          </div>
          <div class="release-details">
            <h3 class="release-title">Phase 1: Ignition</h3>
            <p class="release-meta">EP • Summer 2026</p>
            <span class="release-link release-link-cyan" aria-label="Phase 1 Ignition status">Details Encrypted ⚡</span>
          </div>
        </article>

        <!-- Roadmap Item 3 -->
        <article class="release-card" data-animate="fade-up" style="--delay: 0.2s">
          <div class="release-cover">
            <div class="cover-placeholder gradient-3" aria-hidden="true"></div>
            <div class="status-overlay" aria-hidden="true">
              <span class="status-badge status-badge-rotate-right">Top Secret</span>
            </div>
          </div>
          <div class="release-details">
            <h3 class="release-title">Concept: Void</h3>
            <p class="release-meta">Single • Late 2026</p>
            <span class="release-link release-link-muted" aria-label="Concept Void status">Status: Classified 🚫</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Streaming Portals -->
  <section class="streaming-section section-sm">
    <div class="container">
      <div class="streaming-platforms" data-animate="fade-up">
        <h2 class="streaming-platforms-title text-center">Available Frequencies</h2>
        <div class="portal-grid">
          <a href="https://open.spotify.com/artist/jazer" class="portal-card" target="_blank" rel="noopener noreferrer" style="--hover-color: #1DB954;">
            <img src={`${base}assets/images/icons/music/music-note-black.svg`} alt="" class="portal-icon" loading="lazy" />
            <span class="portal-name">Spotify</span>
          </a>

          <a href="https://music.apple.com/artist/jazer" class="portal-card" target="_blank" rel="noopener noreferrer" style="--hover-color: #FA233B;">
            <img src={`${base}assets/images/icons/music/playlist-black.svg`} alt="" class="portal-icon" loading="lazy" />
            <span class="portal-name">Apple Music</span>
          </a>

          <a href="https://soundcloud.com/jazer" class="portal-card" target="_blank" rel="noopener noreferrer" style="--hover-color: #FF5500;">
            <img src={`${base}assets/images/icons/social/soundcloud-round-icon.svg`} alt="" class="portal-icon" loading="lazy" />
            <span class="portal-name">SoundCloud</span>
          </a>

          <a href="https://youtube.com/@jazer" class="portal-card" target="_blank" rel="noopener noreferrer" style="--hover-color: #FF0000;">
            <img src={`${base}assets/images/icons/social/youtube-round-icon.svg`} alt="" class="portal-icon" loading="lazy" />
