// Exclusive Previews for Subscribers
const exclusivePreviews = [
  { title: 'In Due Time (Preview)', duration: '0:30', locked: false },
  { title: 'Track 2 (Snippet)', duration: '0:15', locked: true },
  { title: 'Album Intro (Teaser)', duration: '0:20', locked: true }
];

// Smart Links
const smartLinks = {
  mainLink: 'jazer.link/music',
  platforms: ['Spotify', 'Apple Music', 'YouTube Music', 'Amazon Music', 'Tidal', 'Deezer', 'SoundCloud', 'Pandora']
};

// Listening Stats
const listeningStats = {
  topCity: 'Los Angeles',
  topCountry: 'United States',
  peakTime: '10 PM - 2 AM',
