---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;

const announcement = {
  href: `${base}videos`,
  text: '🎬 VISUAL CONTENT COMING IN 2026 — Join updates for early access'
};

// Upcoming video content - Using safe placeholders only
const upcomingVideos = [
  {
    id: 1,
    title: 'Visual Title (TBA)',
    type: 'Music Video',
    duration: 'TBD',
    status: 'Coming in 2026',
    description: 'The debut visual experience. Full cinematic production.',
    color: 'var(--jazer-pink)',
    gradient: 'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)'
  },
  {
    id: 2,
    title: 'Studio Sessions (TBA)',
    type: 'Behind The Scenes',
    duration: 'TBD',
    status: 'Expected in 2026',
    description: 'Go behind the scenes. Studio process, production tips, and creative journey.',
    color: 'var(--jazer-cyan)',
    gradient: 'linear-gradient(135deg, rgba(6, 182, 212, 0.2) 0%, rgba(59, 130, 246, 0.2) 100%)'
  },
  {
    id: 3,
    title: 'Live Session (TBA)',
    type: 'Live Performance',
    duration: 'TBD',
    status: 'Coming in 2026',
    description: 'Experience live performance with visual effects and stage production.',
    color: 'var(--jazer-purple)',
    gradient: 'linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, rgba(168, 85, 247, 0.2) 100%)'
  },
  {
    id: 4,
    title: 'Creative Vlog (TBA)',
    type: 'Documentary',
    duration: 'TBD',
    status: 'Expected in 2026',
    description: 'A day in the life: songwriting, production workflow, and creative philosophy.',
    color: '#f59e0b',
    gradient: 'linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(251, 146, 60, 0.2) 100%)'
