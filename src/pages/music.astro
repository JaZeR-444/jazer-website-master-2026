---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
  ? new URL(`${base}assets/images/JaZeR Main Logo.jpg`, site).toString()
  : `${base}assets/images/JaZeR Main Logo.jpg`;

const announcement = {
  href: `${base}music`,
  text: '🎵 NEW SINGLE "IN DUE TIME" DROPPING MARCH 2026 - Pre-save now!'
