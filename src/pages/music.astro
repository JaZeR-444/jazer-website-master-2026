  { track: 'Preview Track 1', plays: '5K+', saves: '1.2K', shares: '400', growth: '+32%' },
  { track: 'Preview Track 2', plays: '3K+', saves: '800', shares: '250', growth: '+28%' }
];

// Production Credits
const productionCredits = [
  { role: 'Producer', name: 'JaZeR', icon: '🎛️' },
  { role: 'Mixing', name: 'JaZeR', icon: '🎚️' },
  { role: 'Mastering', name: 'TBD', icon: '💿' },
  { role: 'Songwriter', name: 'JaZeR', icon: '✍️' },
  { role: 'Vocals', name: 'JaZeR', icon: '🎤' },
  { role: 'Artwork', name: 'JaZeR Design', icon: '🎨' }
