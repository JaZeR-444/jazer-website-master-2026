---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;

const announcement = {
  href: `${base}shop`,
  text: '🛍️ STOREFRONT OPENING IN 2026 — Join the waitlist for early access'
};

// Featured Upcoming Products (Placeholders)
const upcomingProducts = [
  { 
    id: 1,
    title: 'Signature Hoodie (TBA)',
    category: 'Apparel',
    description: 'Heavyweight construction. Gradient embroidery.',
    status: 'Coming in 2026',
    icon: '🧥'
  },
  { 
    id: 2,
    title: 'Graphic Tee (TBA)',
    category: 'Apparel',
    description: 'Oversized fit. Reflective back print.',
    status: 'Expected in 2026',
    icon: '👕'
  },
  { 
    id: 3,
    title: 'Orbit Cap (TBA)',
    category: 'Accessories',
    description: 'Structured fit with 3D puff embroidery.',
    status: 'Coming in 2026',
    icon: '🧢'
  },
  { 
    id: 4,
    title: 'Collector Vinyl (TBA)',
    category: 'Music',
    description: 'Limited edition pressing. Exclusive artwork.',
    status: 'Coming in 2026',
    icon: '💿'
  },
  { 
    id: 5,
    title: 'Sticker Pack (TBA)',
    category: 'Accessories',
    description: 'Holographic die-cut decals.',
    status: 'Coming in 2026',
    icon: '✨'
  },
  { 
    id: 6,
    title: 'Launch Bundle (TBA)',
    category: 'Bundles',
    description: 'The complete starter kit. Details TBD.',
    status: 'Expected in 2026',
    icon: '📦'
  }
];

// Drop Timeline Phases (Safe Copy)
const dropPhases = [
  { 
    phase: '01', 
    title: 'Foundation Drop', 
    description: 'Core apparel essentials.', 
    timing: 'Coming in 2026',
    status: 'In Development'
  },
  { 
    phase: '02', 
    title: 'Expansion Pack', 
    description: 'Accessories and collectibles.', 
    timing: 'Expected in 2026',
    status: 'Planned'
  },
  { 
    phase: '03', 
    title: 'Limited Edition', 
    description: 'Exclusive small-batch releases.', 
    timing: 'Later in 2026',
    status: 'Planned'
  }
];

// Shop FAQ (Safe Copy)
const shopFAQ = [
  { 
    q: 'When does the shop open?', 
    a: "We are preparing for a 2026 launch. Join the waitlist to be notified as soon as we go live." 
  },
  { 
    q: 'What products will be available?', 
    a: 'We are developing a range of premium apparel, accessories, and music collectibles. Full lineup TBD.' 
  },
  { 
    q: 'Will you ship internationally?', 
    a: 'Yes, international shipping is planned for the launch. Specific regions and rates will be confirmed later.' 
  },
  { 
    q: "How do I get early access?", 
    a: 'Subscribers to the "Beam" waitlist will receive priority access codes when the store opens.' 
  }
];
---
<BaseLayout
  bodyClass="shop-page has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/pages-enhancements.css',
    '/css/music-enhancements.css' // Reusing premium card styles
  ]}
>
  <Fragment slot="head">
    <title>Shop - JaZeR | Coming in 2026</title>
    <meta name="description" content="The Official JaZeR Shop. Premium merchandise coming in 2026. Join the waitlist for early access." />
    <meta name="keywords" content="JaZeR shop, merchandise, merch, apparel, clothing, coming soon, 2026" />
    <link rel="canonical" href={canonical} />
    
    <style>
      .shop-hero-section {
          min-height: 80vh;
          display: flex;
          align-items: center;
          position: relative;
          background: radial-gradient(circle at top right, rgba(236, 72, 153, 0.05), transparent 60%),
                      radial-gradient(circle at bottom left, rgba(139, 92, 246, 0.05), transparent 60%);
          overflow: hidden;
      }

      .hero-eyebrow {
          font-family: 'Courier New', monospace;
          color: var(--jazer-pink);
          font-size: 0.875rem;
          margin-bottom: 1.5rem;
          letter-spacing: 0.2em;
          display: inline-flex;
          align-items: center;
          gap: 0.75rem;
          padding: 0.5rem 1rem;
          background: rgba(236, 72, 153, 0.1);
          border-radius: 4px;
          border: 1px solid rgba(236, 72, 153, 0.2);
      }
      .eyebrow-dot {
          width: 6px; height: 6px;
          background: var(--jazer-pink);
          box-shadow: 0 0 8px var(--jazer-pink);
          border-radius: 50%;
          animation: blink 2s infinite;
      }
      
      .shop-hero-title {
          font-family: var(--font-primary);
          font-size: clamp(3rem, 8vw, 6rem);
          font-weight: 900;
          line-height: 1;
          margin-bottom: 1.5rem;
          background: linear-gradient(135deg, #fff 0%, #fbcfe8 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          text-shadow: 0 0 30px rgba(236, 72, 153, 0.3);
      }

      .product-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
          gap: 2rem;
          margin-top: 3rem;
      }

      .product-card {
          background: rgba(15, 15, 20, 0.6);
          border: 1px solid rgba(255, 255, 255, 0.05);
          border-radius: 16px;
          overflow: hidden;
          transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
          display: flex;
          flex-direction: column;
      }
      .product-card:hover {
          transform: translateY(-8px);
          border-color: rgba(236, 72, 153, 0.3);
          box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
      }

      .product-image-placeholder {
          aspect-ratio: 1;
          background: linear-gradient(135deg, #1f1f2e 0%, #1a1a24 100%);
          display: flex;
          align-items: center;
          justify-content: center;
          position: relative;
          overflow: hidden;
      }
      .product-image-placeholder::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.1'/%3E%3C/svg%3E");
        opacity: 0.3;
        mix-blend-mode: overlay;
      }
      
      .product-icon {
          font-size: 4rem;
          opacity: 0.2;
          filter: grayscale(1);
          transition: all 0.4s ease;
      }
      .product-card:hover .product-icon {
          opacity: 0.8;
          filter: grayscale(0);
          transform: scale(1.1);
      }

      .status-badge {
          position: absolute;
          top: 1rem; right: 1rem;
          background: rgba(0, 0, 0, 0.8);
          backdrop-filter: blur(4px);
          color: var(--jazer-pink);
          font-family: 'Courier New', monospace;
          font-size: 0.75rem;
          font-weight: 700;
          padding: 0.35rem 0.75rem;
          border-radius: 4px;
          border: 1px solid rgba(236, 72, 153, 0.3);
          text-transform: uppercase;
          letter-spacing: 0.05em;
          z-index: 2;
      }

      .product-info {
          padding: 1.5rem;
          flex: 1;
          display: flex;
          flex-direction: column;
      }
      
      .product-category {
          font-size: 0.75rem;
          text-transform: uppercase;
          letter-spacing: 0.1em;
          color: var(--text-muted);
          margin-bottom: 0.5rem;
      }

      .product-title {
          font-size: 1.25rem;
          font-weight: 700;
          color: white;
          margin-bottom: 0.5rem;
      }

      .product-price {
          color: var(--jazer-pink);
          font-weight: 600;
          font-size: 0.9rem;
          margin-top: auto;
          padding-top: 1rem;
      }

      .notify-btn {
          margin-top: 1rem;
          width: 100%;
          padding: 0.75rem;
          background: rgba(255, 255, 255, 0.05);
          border: 1px solid rgba(255, 255, 255, 0.1);
          color: white;
          font-weight: 600;
          border-radius: 8px;
          cursor: pointer;
          transition: all 0.3s ease;
      }
      .notify-btn:hover {
          background: var(--jazer-pink);
          border-color: var(--jazer-pink);
          color: white;
      }

      /* Tech Specs / Timeline */
      .timeline-step {
          padding: 1.5rem;
          background: rgba(255, 255, 255, 0.02);
          border-left: 2px solid var(--jazer-pink);
          margin-bottom: 1rem;
      }
    </style>
  </Fragment>

  <!-- Hero Section -->
  <section class="shop-hero-section">
    <div class="container text-center" data-animate="fade-up">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>SYSTEM STATUS: STANDBY</span>
      </div>
      
      <h1 class="shop-hero-title">
        OFFICIAL<br/>STOREFRONT
      </h1>
      
      <p style="font-size: 1.25rem; color: var(--text-muted); max-width: 600px; margin: 0 auto 2.5rem; line-height: 1.6;">
        Premium apparel and collectibles designed for the JaZeR community.
        <br/><strong style="color: var(--text-light);">Opening in 2026.</strong>
      </p>
      
      <div style="display: flex; justify-content: center; gap: 1rem;">
        <a href="#featured-drops" class="system-button" style="border-color: var(--jazer-pink); color: var(--jazer-pink);">
          View Drops
        </a>
        <a href="#join-waitlist" class="system-button" style="background: var(--jazer-pink); border-color: var(--jazer-pink); color: white;">
          Get Notified
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Drops -->
  <section id="featured-drops" class="section">
    <div class="container">
      <div class="section-header text-center" data-animate="fade-up">
        <h2 class="section-title gradient-text" style="--gradient: linear-gradient(135deg, #ec4899, #8b5cf6);">Featured Drops</h2>
        <p class="section-subtitle">Preview the 2026 Collection</p>
      </div>
      
      <div class="product-grid">
        {upcomingProducts.map((product, index) => (
          <article class="product-card" data-animate="fade-up" style={`--delay: ${index * 0.1}s`}>
            <div class="product-image-placeholder">
              <div class="status-badge">{product.status}</div>
              <div class="product-icon">{product.icon}</div>
            </div>
            <div class="product-info">
              <span class="product-category">{product.category}</span>
              <h3 class="product-title">{product.title}</h3>
              <p style="color: var(--text-gray); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1rem;">
                {product.description}
              </p>
              <div class="product-price">Price: TBD</div>
              <a href="#join-waitlist" class="notify-btn text-center" style="text-decoration: none;">
                Notify Me
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true" style="opacity: 0.3;">
    <div class="tech-line"></div>
    <div class="tech-node" style="background: var(--jazer-pink); box-shadow: 0 0 10px var(--jazer-pink);"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Drop Timeline -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center" data-animate="fade-up">
        <h2 class="section-title">Drop Sequence</h2>
        <p class="section-subtitle">Planned rollout schedule</p>
      </div>
      
      <div style="max-width: 700px; margin: 3rem auto;">
        {dropPhases.map((phase, index) => (
          <div class="timeline-step" data-animate="fade-left" style={`--delay: ${index * 0.15}s`}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-family: 'Courier New'; color: var(--jazer-pink); font-weight: 700;">PHASE {phase.phase}</span>
              <span style="font-size: 0.75rem; text-transform: uppercase; opacity: 0.7;">{phase.status}</span>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem;">{phase.title}</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem;">{phase.description} • <strong>{phase.timing}</strong></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-header text-center" data-animate="fade-up">
        <h2 class="section-title">Store FAQ</h2>
      </div>
      <div style="max-width: 700px; margin: 0 auto; display: grid; gap: 1rem;">
        {shopFAQ.map((item, index) => (
          <div class="premium-glass-card" style="padding: 1.5rem; border-left: 3px solid var(--jazer-pink);" data-animate="fade-up">
            <h3 style="font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; color: #fff;">{item.q}</h3>
            <p style="color: var(--text-muted); margin: 0; font-size: 0.9rem;">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Waitlist CTA -->
  <div id="join-waitlist" style="scroll-margin-top: 100px;">
    <JoinBeamCTA
      sectionStyle="padding: 6rem 0;"
      captureStyle="max-width: 700px; margin: 0 auto;"
      subtitleStyle="font-size: 1.125rem; max-width: 500px; margin: 1.5rem auto;"
      subject="New subscriber from JaZeR Shop"
      buttonLabel="Join Store Waitlist"
      proofText="Get priority access codes"
    >
      <Fragment slot="subtitle">
        Don't miss the first drop. Secure your spot in line for the 2026 launch.
      </Fragment>
    </JoinBeamCTA>
  </div>

  <!-- Shop Footer Note -->
  <div class="shop-footer-note">
    🛍️ <strong>Release updates:</strong> All merchandise coming in 2026. Join the waitlist to stay informed.
  </div>

</BaseLayout>