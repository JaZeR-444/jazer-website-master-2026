// Audio Quality Options
const audioQuality = [
  { format: 'Standard', quality: '256 kbps', icon: '🎵', available: true },
  { format: 'High Quality', quality: '320 kbps', icon: '🎧', available: true },
  { format: 'Lossless', quality: 'FLAC 16-bit', icon: '💎', available: true },
  { format: 'Hi-Res', quality: '24-bit/96kHz', icon: '🔊', available: false },
  { format: 'Spatial Audio', quality: 'Dolby Atmos', icon: '🌐', available: false }
];

// Chart/Playlist Placements
const chartPlacements = [
  { playlist: 'New Music Friday', platform: 'Spotify', status: 'Target', icon: '🎯' },
  { playlist: 'Chill Vibes', platform: 'Apple Music', status: 'Pitched', icon: '📤' },
  { playlist: 'Discover Weekly', platform: 'Spotify', status: 'Goal', icon: '⭐' },
