        {dropPhases.map((phase) => (
          <div class="timeline-step-enhanced">
            <span class="timeline-phase-tag">Phase {phase.phase}</span>
            <div class="timeline-title" style="font-size: 1.25rem; margin-bottom: 0.5rem;">{phase.title}</div>
