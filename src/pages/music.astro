];

// Upcoming Releases
const upcomingReleases = [
  { title: 'In Due Time', type: 'Single', date: 'March 15, 2026', status: 'PRE-SAVE' },
  { title: 'Midnight Sessions EP', type: 'EP', date: 'Summer 2026', status: 'COMING' },
  { title: 'First Light', type: 'Album', date: 'Fall 2026', status: 'ANNOUNCED' }
