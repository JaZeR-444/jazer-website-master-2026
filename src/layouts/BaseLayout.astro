---
import Nav from '../components/Nav.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
const base = import.meta.env.BASE_URL;

const {
  bodyClass = '',
  showAnnouncement = false,
  announcement = null,
  showNoiseOverlay = false,
  showPreloader = false,
  showNavEnhancements = false,
  showFooter = true,
  showAudioPlayer = false,
  showBackToTop = false,
  showSkipLink = true,
  includeGsap = false,
  extraStyles = []
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedStyles = extraStyles.map((href) =>
  href.startsWith('/') ? `${base}${href.slice(1)}` : href
);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      href={`${base}assets/images/vibrant-jzr-monogram-logo (50 x 50 px).svg`}
      type="image/svg+xml"
    />
    <link rel="stylesheet" href={`${base}css/tokens.css`} />
    <link rel="stylesheet" href={`${base}css/global.css`} />
    <link rel="stylesheet" href={`${base}css/components.css`} />
    <link rel="stylesheet" href={`${base}css/enhancements.css`} />
    <link rel="stylesheet" href={`${base}css/mobile-optimizations.css`} />
    {resolvedStyles.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {showNoiseOverlay && <div class="noise-overlay"></div>}
    {showAnnouncement && announcement && (
      <AnnouncementBar href={announcement.href} text={announcement.text} />
    )}
    {showPreloader && (
      <div class="preloader" aria-hidden="true">
        <img
          class="preloader-logo"
          src={`${base}assets/images/vibrant-jzr-monogram-logo-(500 x 500 px).svg`}
          alt=""
        />
        <div class="preloader-bar"></div>
      </div>
    )}
    {showSkipLink && <a class="skip-link" href="#main">Skip to content</a>}

    <Nav currentPath={currentPath} />

    {showNavEnhancements && (
      <>
        <div class="nav-progress" aria-hidden="true"></div>
        <div class="nav-overlay" data-nav-overlay></div>
      </>
    )}

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <slot name="afterMain" />

    {showFooter && <Footer currentPath={currentPath} />}
    {showAudioPlayer && <Player />}
    {showBackToTop && (
      <button class="back-to-top" aria-label="Back to top">
        <span class="rocket-emoji">🚀</span>
      </button>
    )}

    <script src={`${base}js/script.js`} is:inline></script>
    {includeGsap && (
      <>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
        <script src={`${base}js/gsap-animations.js`} is:inline></script>
      </>
    )}
  </body>
</html>

