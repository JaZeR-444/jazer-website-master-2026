      <div style="max-width: 500px; margin: 3rem auto;">
        {exclusivePreviews.map((preview, index) => (
          <div class="premium-card" style="padding: 1.5rem; margin-bottom: 1rem; display: flex; align-items: center; gap: 1rem;" data-animate="fade-up" data-animate-delay={index * 100}>
            <div style={`width: 50px; height: 50px; background: ${preview.locked ? 'rgba(255,255,255,0.1)' : 'linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple))'}; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;`}>
              {preview.locked ? '🔒' : '▶️'}
            </div>
            <div style="flex: 1;">
              <div style="font-weight: 600;">{preview.title}</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);">{preview.duration}</div>
            </div>
            {preview.locked ? (
              <span style="font-size: 0.75rem; color: var(--jazer-pink);">Join to unlock</span>
            ) : (
              <button class="system-button" style="padding: 0.5rem 1rem; font-size: 0.75rem;">Play</button>
            )}
          </div>
        ))}
        
        <div style="text-align: center; margin-top: 2rem;">
          <a href="#join-beam" class="cta-button">
            <span>🔓</span>
            <span>Unlock All Previews</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Listening Stats -->
  <section class="section" style="padding: 6rem 0; background: rgba(0,0,0,0.3);">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Listener Insights</h2>
        <p class="section-subtitle">Who's listening and when</p>
      </div>
      
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; max-width: 800px; margin: 3rem auto;">
        <div class="premium-card" style="padding: 1.5rem; text-align: center;" data-animate="fade-up">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">📍</div>
          <div style="font-weight: 700; font-size: 1.125rem; color: var(--jazer-cyan);">{listeningStats.topCity}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Top City</div>
        </div>
        <div class="premium-card" style="padding: 1.5rem; text-align: center;" data-animate="fade-up" data-animate-delay="100">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🌍</div>
          <div style="font-weight: 700; font-size: 1.125rem; color: var(--jazer-purple);">{listeningStats.topCountry}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Top Country</div>
        </div>
        <div class="premium-card" style="padding: 1.5rem; text-align: center;" data-animate="fade-up" data-animate-delay="200">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🌙</div>
          <div style="font-weight: 700; font-size: 1.125rem; color: var(--jazer-pink);">{listeningStats.peakTime}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Peak Time</div>
        </div>
        <div class="premium-card" style="padding: 1.5rem; text-align: center;" data-animate="fade-up" data-animate-delay="300">
          <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">⏱️</div>
          <div style="font-weight: 700; font-size: 1.125rem; color: #10b981;">{listeningStats.avgListenTime}</div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">Avg Listen</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Smart Links -->
  <section class="section" style="padding: 6rem 0;">
    <div class="container">
      <div class="premium-glass-card" style="max-width: 600px; margin: 0 auto; padding: 3rem; text-align: center;" data-animate="fade-up">
        <div style="font-size: 3rem; margin-bottom: 1rem;">🔗</div>
        <h2 class="gradient-text" style="margin-bottom: 0.5rem;">One Link, All Platforms</h2>
        <p style="color: var(--text-muted); margin-bottom: 2rem;">Share music with anyone, anywhere</p>
        
        <div style="background: rgba(0,0,0,0.3); padding: 1rem 2rem; border-radius: 12px; display: inline-flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
          <span style="font-family: monospace; font-size: 1.125rem; color: var(--jazer-cyan);">{smartLinks.mainLink}</span>
          <button style="padding: 0.5rem 1rem; background: var(--jazer-cyan); color: #000; border: none; border-radius: 6px; font-weight: 700; cursor: pointer;">Copy</button>
        </div>
        
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem;">
          {smartLinks.platforms.map((platform) => (
            <span style="padding: 0.5rem 1rem; background: rgba(255,255,255,0.1); border-radius: 6px; font-size: 0.813rem;">{platform}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Email Signup CTA -->
  <JoinBeamCTA
    sectionStyle="padding: 6rem 0;"
    captureStyle="max-width: 700px; margin: 0 auto;"
    subtitleStyle="font-size: 1.125rem; max-width: 500px; margin: 1.5rem auto;"
    subject="New subscriber from JaZeR Music page"
    buttonLabel="Join the Beam"
    proofText="Join <strong>500+</strong> fans on the beam"
  >
    <Fragment slot="subtitle">
      Be the first to hear new music, get exclusive updates, and <strong>join the community</strong>.
    </Fragment>
  </JoinBeamCTA>

</BaseLayout>

