  <script>
    // Audio Player Logic
    const playBtn = document.getElementById('audio-player-btn');
    const audio = document.getElementById('track-audio');
    
    if(playBtn && audio) {
      playBtn.addEventListener('click', () => {
        if(audio.paused) {
          audio.play();
          playBtn.classList.add('playing');
        } else {
          audio.pause();
          playBtn.classList.remove('playing');
        }
      });
      
      audio.addEventListener('ended', () => {
        playBtn.classList.remove('playing');
      });
    }

    // Simple Countdown Logic
    const targetDate = new Date('2026-06-01T00:00:00').getTime();
    
    function updateCountdown() {
      const now = new Date().getTime();
      const distance = targetDate - now;
      
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      
      const vals = document.querySelectorAll('.countdown-val');
      if(vals.length >= 3) {
        vals[0].innerText = days > 0 ? days : '0';
        vals[1].innerText = hours > 0 ? hours : '0';
        vals[2].innerText = minutes > 0 ? minutes : '0';
      }
    }
    
    // Initial call and interval
    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>

</BaseLayout>

