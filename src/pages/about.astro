---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
import FloatingNotes from '../components/FloatingNotes.astro';

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
    ? new URL(`${base}assets/images/jazer-cosmic-soundbirth.png`, site).toString()
    : `${base}assets/images/jazer-cosmic-soundbirth.png`;

const announcement = {
    href: `${base}music`,
    text: 'New Era: Coming in 2026'
};

const pathways = [
    {
        title: 'Music',
        href: `${base}music`,
        desc: 'Sonic transmissions',
        icon: `${base}assets/images/icons/music/headphones-black.svg`,
        cta: 'Listen'
    },
    {
        title: 'Videos',
        href: `${base}videos`,
        desc: 'Visual stories',
        icon: `${base}assets/images/icons/navigation/videos.svg`,
        cta: 'Watch'
    },
    {
        title: 'Shop',
        href: `${base}shop`,
        desc: 'Apparel & Goods',
        icon: `${base}assets/images/icons/navigation/shop.svg`,
        cta: 'Browse'
    },
    {
        title: 'Contact',
        href: `${base}contact`,
        desc: 'Inquiries',
        icon: `${base}assets/images/icons/navigation/contact.svg`,
        cta: 'Connect'
    }
];

const faqs = [
    {
        q: "When is the debut release?",
        a: "The first official project is expected to arrive in 2026. Stay tuned for announcements."
    },
    {
        q: "Will there be live performances?",
        a: "Live experiences are in the planning stages. Dates and locations are TBA."
    },
    {
        q: "How can I collaborate?",
        a: "JaZeR is open to creative partnerships. Reach out via the Contact page to start a conversation."
    }
];
---
<BaseLayout
  bodyClass="about-page has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={false}
  showPreloader={false}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={false}
  showBackToTop={true}
  includeGsap={false}
  extraStyles={[
    '/css/home.css' /* Reusing home styles for consistent hero/card look */
  ]}
>
  <FloatingNotes />
  
  <!-- Hero Section -->
  <section class="hero hero-animated">
    <div class="hero-content" style="max-width: 800px; position: relative; z-index: 10; display: flex; flex-direction: column; align-items: center; padding: 0;">
      <img class="hero-logo" src={`${base}assets/images/About JaZeR (441 x 94 px).svg`} alt="About JaZeR" style="margin: 0 auto 1.5rem; object-fit: contain; max-height: 120px;" />
      <p class="tagline-roles" style="max-width: 600px; margin: 0 auto 1.5rem; font-size: 1.25rem;">
        A sonic escape hatch — a beam of color for anyone who needs a place to belong.
      </p>
      <span id="hero-eyebrow-text" class="hero-eyebrow brand-gradient" style="display: inline-block; margin-bottom: 0.5rem; opacity: 1; visibility: visible;">
        <span class="eyebrow-word" style="--i: 0">Meet</span>
        <span class="eyebrow-divider">✦</span>
        <span class="eyebrow-word" style="--i: 1">The</span>
        <span class="eyebrow-divider">✦</span>
        <span class="eyebrow-word" style="--i: 2">Artist</span>
      </span>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true" style="margin: 0;">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Artist Profile Section -->
  <section class="section about-section" style="position: relative;">
    <div class="container">
      <!-- Ambient Glow Orbs -->
      <div class="ambient-glow magenta"></div>
      <div class="ambient-glow blue"></div>

    <div class="bento-grid" style="align-items: stretch; gap: 1.5rem;">
        
        <!-- Profile Card - Horizontal Layout -->
        <article class="card premium-card profile-card grid-span-2 profile-card-redesign" data-animate="fade-up" data-animate-delay="100">
          <!-- Profile Image -->
          <div class="profile-image-container">
             <div class="profile-bg-gradient"></div>
             <img src={`${base}assets/images/vibrant-jzr-monogram-logo (250 x 250 px).svg`} alt="JaZeR" class="profile-logo" />
          </div>

          <!-- Profile Content -->
          <div class="profile-content">
            <h1 class="profile-name">JaZeR</h1>
            <p class="profile-roles">
              Content Creator <span class="accent-star">✧</span> Musician <span class="accent-star">✧</span> Storyteller
            </p>
            
            <div class="profile-actions">
              <a href="https://instagram.com/jazer_music" target="_blank" class="cta-secondary profile-btn">
                Follow
              </a>
              <a href="#connect" class="cta-secondary profile-btn">
                Contact
              </a>
            </div>
          </div>
        </article>

        <!-- At a Glance Stats - 4 Col Grid -->
        <article class="card premium-card grid-span-2 at-glance-card stats-card-redesign" style="height: auto !important; overflow: visible !important;">
          <h3 class="track-title stats-title">At a Glance</h3>
          
          <div class="stats-grid-4col">
            <!-- Row 1 -->
            <div class="stat-item">
              <div class="stat-value text-purple">2026</div>
              <div class="stat-label">Launch Year</div>
            </div>
            <div class="stat-item">
              <div class="stat-value text-purple">25+</div>
              <div class="stat-label">Original Tracks</div>
            </div>
            <div class="stat-item">
              <div class="stat-value text-gradient-magic">Growing</div>
              <div class="stat-label">Listeners</div>
            </div>
            <div class="stat-item">
              <div class="stat-value text-gradient-royal">Vision</div>
              <div class="stat-label">Innovation</div>
            </div>

            <!-- Row 2 -->
             <div class="stat-item">
              <div class="stat-value text-purple">∞</div>
              <div class="stat-label">Creative Energy</div>
            </div>
             <div class="stat-item">
              <div class="stat-value text-purple">100%</div>
              <div class="stat-label">Authentic</div>
            </div>
             <div class="stat-item">
              <div class="stat-value text-gradient-royal">Style</div>
              <div class="stat-label">Fusion</div>
            </div>
             <div class="stat-item">
              <div class="stat-value text-gradient-magic">Status</div>
              <div class="stat-label">Indie</div>
            </div>
          </div>

          <div class="stats-mission" style="display: block !important; box-sizing: border-box !important; margin-top: 1.25rem !important; padding: 1rem !important; background: rgba(255, 255, 255, 0.05) !important; border-top: 1px solid rgba(255, 255, 255, 0.15) !important; border-radius: 12px !important; width: 100% !important; clear: both !important; position: relative !important; z-index: 50 !important; visibility: visible !important; opacity: 1 !important;">
            <p style="font-size: 0.9rem !important; line-height: 1.5 !important; color: white !important; margin: 0 !important; text-align: center !important; width: 100% !important; display: block !important;">
              <strong>Mission:</strong> To create music that feels like home for the people who don't always feel like they have one.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true" style="margin: 0;">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <div class="container section">
    <div class="content-narrow">

      <!-- Visual Timeline -->
      <div class="premium-glass-card mb-lg" data-animate="fade-up">
        <h2 class="mb-md text-center"><span class="brand-gradient">The Journey</span></h2>

        <div class="timeline-container">
          <!-- Timeline line -->
          <div class="timeline-line"></div>

          <!-- Timeline Item 1 -->
          <div class="timeline-item">
            <div class="timeline-dot pink"></div>
            <div class="timeline-content">
              <h4 style="color: var(--jazer-pink);">The Struggle</h4>
              <p class="text-muted">
                JaZeR was born out of transition — a long stretch of struggle, constraint, and feeling like my light was dimmed.
              </p>
            </div>
          </div>

          <!-- Timeline Item 2 -->
          <div class="timeline-item">
            <div class="timeline-dot purple"></div>
            <div class="timeline-content">
              <h4 style="color: var(--jazer-purple);">The Discovery</h4>
              <p class="text-muted">
                Music has always been the one thing that made me feel truly special. When I didn't know my purpose, sound gave me one. When I felt lost, rhythm felt like home.
              </p>
            </div>
          </div>

          <!-- Timeline Item 3 -->
          <div class="timeline-item">
            <div class="timeline-dot cyan"></div>
            <div class="timeline-content">
              <h4 style="color: var(--jazer-cyan);">The Mission - 2026</h4>
              <p class="text-muted">
                Now that I'm finally at a point where I feel free, JaZeR is my way of giving that feeling back. Creating music that feels like home for those who don't always have one.
              </p>
            </div>
          </div>
        </div>

        <div class="mission-card">
          <p class="text-strong text-lg">
            The mission is simple: to create music that feels like home for the people who don't always feel like they have one.
          </p>
        </div>
      </div>

      <!-- CTA: Listen Now -->
      <div class="text-center mb-lg" data-animate="fade-up">
        <a href="music.html" class="cta-button">
          <span class="cta-icon">🎧</span>
          <span>Listen Now</span>
        </a>
      </div>

      <!-- Core Values -->
      <div class="core-values-grid mb-lg" data-animate="fade-up">
        <div class="value-card value-card-pink">
          <!-- Heart Icon -->
          <svg class="value-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3>A sense of belonging</h3>
          <p>For those who don't always feel like they have one</p>
        </div>
        <div class="value-card value-card-cyan">
          <!-- Compass Icon -->
          <svg class="value-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3>A sense of purpose</h3>
          <p>Finding meaning through sound and rhythm</p>
        </div>
        <div class="value-card value-card-purple">
          <!-- Rocket Icon -->
          <svg class="value-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3>Limitless potential</h3>
          <p>A reminder that you're capable of far more than you were told</p>
        </div>
      </div>

      <!-- Sound & Style -->
      <div class="premium-glass-card mb-lg">
        <h2 class="mb-md text-center"><span class="brand-gradient">Vibe, Sound & Style</span></h2>
        <p class="mb-md text-lg" style="line-height: 1.7;">
          <strong>Upbeat, positive, and lyrically sharp</strong> — with a lot of choppy wordplay and rhythmic twists.
        </p>

        <p class="mb-sm text-strong" style="font-size: 1.125rem; margin-top: 2rem;">Genre Influences:</p>
        <div class="genre-badge-container">
          <span class="genre-badge genre-rock">🎸 Southern Rock</span>
          <span class="genre-badge genre-bass">🔊 Heavy Bass</span>
          <span class="genre-badge genre-electronic">⚡ Electronic</span>
          <span class="genre-badge genre-hiphop">🎤 Hip-Hop & Rap</span>
          <span class="genre-badge genre-jazz">🎷 Jazz & Blues</span>
          <span class="genre-badge genre-boom">🎹 Boom Bap</span>
          <span class="genre-badge genre-trap">💎 Trap-Soul</span>
        </div>

        <div style="padding: 1.5rem; background: rgba(6, 182, 212, 0.1); border-left: 3px solid var(--jazer-cyan); border-radius: 8px;">
          <p style="line-height: 1.7;">
            Whenever I'm in the lab, I'm chasing emotion. Good, bad, beautiful, or painful — it all belongs. For me, the point of music is to take even the worst situations and transform them into something beautiful.
          </p>
        </div>
      </div>

      <!-- Behind the Scenes -->
      <div class="premium-glass-card mb-lg" data-animate="fade-up">
        <h2 class="mb-md text-center"><span class="brand-gradient">Behind the Scenes</span></h2>
        <div class="process-grid">
          <div class="process-card process-card-cyan">
            <!-- Sliders/Mixer Icon -->
            <svg class="process-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h4>Production</h4>
            <p class="text-muted text-sm">FL Studio, Ableton, and a coffee addiction</p>
          </div>
          <div class="process-card process-card-purple">
            <!-- Microphone Icon -->
            <svg class="process-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3M8 22h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h4>Recording</h4>
            <p class="text-muted text-sm">Home studio vibes, late-night sessions</p>
          </div>
          <div class="process-card process-card-pink">
            <!-- Pen/Edit Icon -->
            <svg class="process-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h4>Writing</h4>
            <p class="text-muted text-sm">Life experiences, emotions, and raw truth</p>
          </div>
        </div>
      </div>

      <!-- Themes -->
      <div class="premium-glass-card mb-lg">
        <h2 class="mb-md text-center"><span class="brand-gradient">Themes & The World of JaZeR</span></h2>
        <p class="mb-md text-italic">
          JaZeR lives in a "funky futuristic" lane — a blend of soulful humanity and cosmic, digital energy.
        </p>
        <div class="themes-grid mt-lg">
          <div class="theme-card">
            <h4>Self-belief & perseverance</h4>
            <p class="text-sm text-muted">Never stopping, never shrinking</p>
          </div>
          <div class="theme-card">
            <h4>Freedom & transformation</h4>
            <p class="text-sm text-muted">Breaking out of old versions of yourself</p>
          </div>
          <div class="theme-card">
            <h4>Authenticity & purpose</h4>
            <p class="text-sm text-muted">Staying true while you build something new</p>
          </div>
          <div class="theme-card">
            <h4>Mental & emotional growth</h4>
            <p class="text-sm text-muted">Clarity, healing, evolution</p>
          </div>
          <div class="theme-card grid-span-2-mobile">
            <h4>Technology & consciousness</h4>
            <p class="text-sm text-muted">Metaphysical vibes, digital dreams, cosmic imagery</p>
          </div>
        </div>
      </div>

      <!-- Why JaZeR -->
      <div class="premium-glass-card mb-lg">
        <h2 class="mb-md text-center"><span class="brand-gradient">Why "JaZeR"?</span></h2>
        <div class="why-jazer-grid">
          <!-- Card 1: Origin -->
          <div class="why-card">
            <h4 class="mb-sm" style="color: var(--jazer-pink);">Origin</h4>
            <p style="font-size: 0.9rem; line-height: 1.5;">
              It started as a nickname. A play on my name, "Jay," and the way I move — an infinite beam of light.
            </p>
          </div>
          <!-- Card 2: Identity -->
          <div class="why-card">
            <h4 class="mb-sm" style="color: var(--jazer-purple);">The Name</h4>
            <p style="font-size: 0.9rem; line-height: 1.5;">
              JaZeR is like "J-Laser": a focused beam of energy designed to cut through the noise and light up the dark.
            </p>
          </div>
          <!-- Card 3: Mission -->
          <div class="why-card">
            <h4 class="mb-sm" style="color: var(--accent-cyan);">The Mission</h4>
            <p style="font-size: 0.9rem; line-height: 1.5;">
              To create a "sonic escape hatch" — a place where dreamers and builders can feel seen, safe, and at home.
            </p>
          </div>
          <!-- Card 4: Promise -->
          <div class="why-card special">
            <h4 class="mb-sm" style="color: var(--text-primary);">The Promise</h4>
            <p style="font-size: 0.9rem; line-height: 1.5; font-weight: 600;">
              To always leave you lighter, stronger, and closer to your next step than when you arrived.
            </p>
          </div>
        </div>
      </div>

      <!-- Testimonials Section -->
      <div class="premium-glass-card mb-lg" data-animate="fade-up">
        <h2 class="mb-md text-center"><span class="brand-gradient">What Early Listeners Say</span></h2>
        <div class="testimonials-grid">
          <!-- Testimonial 1 -->
          <div class="testimonial-card pink-border">
            <p class="text-italic mb-sm" style="line-height: 1.6; font-size: 0.95rem;">
              "The energy is unmatched. Every track feels like it's speaking directly to where I am in life."
            </p>
            <p class="text-xs text-strong" style="color: var(--jazer-pink);">— Early Supporter</p>
          </div>

          <!-- Testimonial 2 -->
          <div class="testimonial-card cyan-border">
            <p class="text-italic mb-sm" style="line-height: 1.6; font-size: 0.95rem;">
              "This is exactly what I needed to hear. The wordplay is insane and the vibe is perfect."
            </p>
            <p class="text-xs text-strong" style="color: var(--jazer-cyan);">— Beta Listener</p>
          </div>

          <!-- Testimonial 3 -->
          <div class="testimonial-card purple-border">
            <p class="text-italic mb-sm" style="line-height: 1.6; font-size: 0.95rem;">
              "JaZeR's music makes me feel like I'm not alone in this. It's fuel for the journey."
            </p>
            <p class="text-xs text-strong" style="color: var(--jazer-purple);">— Community Member</p>
          </div>
        </div>
      </div>

      <!-- CTA: Watch the Journey -->
      <div class="text-center mb-lg" data-animate="fade-up">
        <a href="videos.html" class="cta-button">
          <span class="cta-icon">🎬</span>
          <span>Watch the Journey</span>
        </a>
      </div>

    </div>
  </div>



  <!-- Collaborate Section -->
  <section class="section about-section" id="connect">
    <div class="container">
      <div class="content-narrow">
        <div class="premium-glass-card" data-animate="fade-up">
          <h2 class="mb-md text-center"><span class="brand-gradient">Let's Work Together</span></h2>
          <p class="text-center mb-lg" style="font-size: 1.125rem; line-height: 1.7;">
            Open to collaborations, features, production work, and creative partnerships.
          </p>

          <div class="collab-grid">
            <!-- Collaboration Type 1 -->
            <div class="collab-card collab-card-pink">
              <!-- Microphone Icon -->
              <svg class="collab-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3M8 22h8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <h4 class="feature-title">Features</h4>
              <p class="feature-desc">Guest verses and vocal features</p>
            </div>

            <!-- Collaboration Type 2 -->
            <div class="collab-card collab-card-purple">
              <!-- Piano/Grid Icon -->
              <svg class="collab-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="2"/>
                <path d="M8 4v10M16 4v10M2 14h20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <h4 class="feature-title">Production</h4>
              <p class="feature-desc">Beats, mixing, and sound design</p>
            </div>

            <!-- Collaboration Type 3 -->
            <div class="collab-card collab-card-cyan">
              <!-- Briefcase Icon -->
              <svg class="collab-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="7" width="20" height="13" rx="2" stroke="currentColor" stroke-width="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16M2 12h20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <h4 class="feature-title">Business</h4>
              <p class="feature-desc">Bookings, partnerships, licensing</p>
            </div>
          </div>

          <div class="text-center" style="margin-top: 2.5rem;">
            <a href="contact.html" class="cta-button">
              <span class="cta-icon">📧</span>
              <span>Get in Touch</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container section">
    <div class="content-narrow">

      <!-- For New Listeners -->
      <div class="premium-glass-card callout-gradient-soft">
        <h2 class="mb-md text-center"><span class="brand-gradient">For New Listeners</span></h2>
        <p class="mb-lg text-center text-lg text-muted">
          If you're reading this, here's what I want you to feel:
        </p>
        
        <div class="feelings-grid mb-lg">
          <div class="feeling-card feeling-card-pink">
            <!-- Sparkles Icon -->
