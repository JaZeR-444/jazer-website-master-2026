---
const faqs = [
  {
    q: 'When will video content be released?',
    a: 'Visual content is currently in development and expected to begin rolling out in 2026. Join the updates list to be notified.'
  },
  {
    q: 'Where will I be able to watch?',
    a: 'Videos will be available right here on the official site, as well as on YouTube and other major social platforms.'
  },
  {
    q: 'Can I get early access?',
    a: 'Subscribers to the "Beam" newsletter often get early previews and behind-the-scenes content before the public release.'
  }
];
---

<section class="py-20 bg-[rgba(0,0,0,0.2)] border-t border-[rgba(255,255,255,0.05)]">
  <div class="container px-4 max-w-3xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-12">
      <span class="bg-clip-text text-transparent bg-gradient-to-r from-white to-[var(--text-muted)]">
        Common Questions
      </span>
    </h2>
    
    <div class="space-y-4">
      {faqs.map((item) => (
        <div class="faq-item rounded-xl bg-[rgba(255,255,255,0.03)] border border-[rgba(255,255,255,0.05)] overflow-hidden">
          <details class="group">
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <span class="font-bold text-lg">{item.q}</span>
              <span class="transform transition-transform duration-300 group-open:rotate-180 text-[var(--jazer-cyan)]">▼</span>
            </summary>
            <div class="px-6 pb-6 text-[var(--text-muted)] leading-relaxed">
              {item.a}
            </div>
          </details>
        </div>
      ))}
    </div>
  </div>
</section>
