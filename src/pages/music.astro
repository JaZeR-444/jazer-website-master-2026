---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
  ? new URL(`${base}assets/images/JaZeR Main Logo.jpg`, site).toString()
  : `${base}assets/images/JaZeR Main Logo.jpg`;

const announcement = {
  href: `${base}music`,
  text: '🎵 MUSIC COMING IN 2026 — Join the beam for updates'
};

// Transmission Log (Unified Release Data)
const releases = [
  { 
    id: 'rel-001',
    title: 'Project: Aether', 
    type: 'Single', 
    status: 'Coming in 2026',
    year: '2026',
    gradient: 'gradient-1',
    description: 'The first signal.',
    cta: 'Get Notified'
  },
  { 
    id: 'rel-002',
    title: 'Phase 1: Ignition', 
    type: 'EP', 
    status: 'Expected in 2026',
    year: '2026',
    gradient: 'gradient-2',
    description: 'Details encrypted.',
    cta: 'Get Notified'
  },
  { 
    id: 'rel-003',
    title: 'Concept: Void', 
    type: 'TBA', 
    status: 'Coming in 2026',
    year: '2026',
    gradient: 'gradient-3',
    description: 'Classified.',
    cta: 'Get Notified'
  }
];

// Streaming Platforms
const streamingPlatforms = [
  { name: 'Spotify', href: '#', icon: 'spotify-round-icon.svg' },
  { name: 'Apple Music', href: '#', icon: 'apple-music-round-icon.svg' },
  { name: 'SoundCloud', href: '#', icon: 'soundcloud-round-icon.svg' },
  { name: 'YouTube', href: '#', icon: 'youtube-round-icon.svg' }
];

// FAQ Items
const faqItems = [
  {
    question: 'When will music be available?',
    answer: 'The first releases are expected sometime in 2026. Join updates to be notified when music drops.'
  },
  {
    question: 'Where can I listen?',
    answer: 'Music will be available on all major streaming platforms including Spotify, Apple Music, YouTube Music, and more when released.'
  },
  {
    question: 'How do I get notified about new releases?',
    answer: 'Join the beam using the signup form below — you\'ll be first to know about releases, updates, and exclusive content.'
  }
];
---
<BaseLayout
  bodyClass="has-announcement music-page"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={false}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/music-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Music - JaZeR</title>
    <meta name="title" content="Music - JaZeR" />
    <meta
      name="description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links. Listen now on Spotify, Apple Music, and all major platforms."
    />
    <meta
      name="keywords"
      content="JaZeR, music, releases, discography, electronic music, streaming, Spotify, Apple Music, hip-hop, rap, melodic"
    />
    <meta name="author" content="JaZeR" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Music - JaZeR" />
    <meta
      property="og:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="og:image"
      content={ogImage}
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content="Music - JaZeR" />
    <meta
      property="twitter:description"
      content="Explore JaZeR's music - Latest releases, discography, and streaming links."
    />
    <meta
      property="twitter:image"
      content={ogImage}
    />

    <link rel="canonical" href={canonical} />
    
    <style>
      /* Page-Specific Overrides */
      .music-hero-section {
          align-items: center;
          position: relative;
          background: transparent;
          overflow: hidden;
      }

      /* Sonic Waveform Background */
      .sonic-waveform-bg {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          opacity: 0.15;
          pointer-events: none;
          z-index: 0;
      }
      .waveform-line {
          width: 6px;
          height: 100px;
          margin: 0 4px;
          background: var(--jazer-cyan);
          border-radius: 4px;
          animation: sonicPulse 3s ease-in-out infinite;
          animation-delay: calc(var(--i) * 0.1s);
      }
      @keyframes sonicPulse {
          0%, 100% { height: 15%; opacity: 0.1; }
          50% { height: 70%; opacity: 0.4; }
      }

      /* Glitch Effect */
      .glitch-text {
        position: relative;
        display: inline-block;
      }
      .glitch-text::before,
      .glitch-text::after {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #0f0f14; /* Match bg */
      }
      .glitch-text::before {
        left: 2px;
        text-shadow: -1px 0 #cc00ff;
        clip: rect(44px, 450px, 56px, 0);
        animation: glitch-anim-1 5s infinite linear alternate-reverse;
      }
      .glitch-text::after {
        left: -2px;
        text-shadow: -1px 0 #00ffff;
        clip: rect(44px, 450px, 56px, 0);
        animation: glitch-anim-2 5s infinite linear alternate-reverse;
      }
      @keyframes glitch-anim-1 {
        0% { clip: rect(30px, 9999px, 10px, 0); }
        20% { clip: rect(30px, 9999px, 80px, 0); }
        40% { clip: rect(60px, 9999px, 20px, 0); }
        60% { clip: rect(10px, 9999px, 50px, 0); }
        80% { clip: rect(50px, 9999px, 30px, 0); }
        100% { clip: rect(70px, 9999px, 90px, 0); }
      }
      @keyframes glitch-anim-2 {
        0% { clip: rect(15px, 9999px, 50px, 0); }
        20% { clip: rect(60px, 9999px, 20px, 0); }
        40% { clip: rect(10px, 9999px, 80px, 0); }
        60% { clip: rect(40px, 9999px, 10px, 0); }
        80% { clip: rect(80px, 9999px, 40px, 0); }
        100% { clip: rect(20px, 9999px, 60px, 0); }
      }

      .music-hero-content {
          z-index: 2;
          max-width: 800px;
          margin: 0 auto;
          text-align: center;
      }

      .hero-eyebrow {
          font-family: 'Courier New', monospace;
          color: var(--jazer-cyan);
          font-size: 0.875rem;
          margin-bottom: 1.5rem;
          letter-spacing: 0.2em;
          display: inline-flex;
          align-items: center;
          gap: 0.75rem;
          padding: 0.5rem 1rem;
          background: rgba(6, 182, 212, 0.1);
          border-radius: 4px;
          border: 1px solid rgba(6, 182, 212, 0.2);
      }
      .eyebrow-dot {
          width: 6px; height: 6px;
          background: var(--jazer-cyan);
          box-shadow: 0 0 8px var(--jazer-cyan);
          border-radius: 50%;
          animation: blink 2s infinite;
      }
      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

      .music-hero-title-text {
          font-family: var(--font-primary);
          font-size: clamp(3rem, 8vw, 6rem);
          font-weight: 900;
          line-height: 1;
          margin-bottom: 1.5rem;
          letter-spacing: -0.02em;
          background: linear-gradient(135deg, #fff 0%, #a5f3fc 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          text-shadow: 0 0 30px rgba(6, 182, 212, 0.3);
      }

      .music-hero-description {
          font-size: 1.25rem;
          color: var(--text-muted);
          max-width: 600px;
          margin: 0 auto 2.5rem;
          line-height: 1.6;
      }

      /* Discography Grid */
      .discography-section {
          padding: 4rem 0;
          position: relative;
          z-index: 2;
      }
      
      .discography-grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
          gap: 1.5rem;
          margin-top: 2rem;
      }

      .release-card {
          background: rgba(15, 15, 20, 0.4);
          border: 1px solid rgba(255, 255, 255, 0.03);
          border-radius: 12px; /* More compact radius */
          overflow: hidden;
          transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
          display: flex; /* Horizontal compact layout on desktop? No, vertical but tighter */
          flex-direction: column;
      }
      .release-card:hover {
          transform: translateY(-4px); /* Smoother lift */
          border-color: rgba(6, 182, 212, 0.4);
          background: rgba(15, 15, 20, 0.7);
          box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
      }
      
      /* Compact Text Adjustments */
      .release-details {
          padding: 1rem 1.25rem; /* Reduced padding */
      }
      .release-title {
          font-size: 1.2rem; /* Slightly smaller title */
          margin-bottom: 0.25rem;
      }
      .release-meta {
          margin-bottom: 0.75rem;
          font-size: 0.8rem;
      }
      .release-card p {
          margin-bottom: 1rem !important;
          font-size: 0.85rem !important;
          line-height: 1.4 !important;
      }

      .release-cover {
          aspect-ratio: 1;
          background: #111;
          position: relative;
          overflow: hidden;
      }
      
      .cover-placeholder {
          width: 100%; height: 100%;
          transition: transform 0.6s ease;
      }
      .release-card:hover .cover-placeholder {
          transform: scale(1.05);
      }

      .status-overlay {
          position: absolute;
          top: 1rem; right: 1rem;
          z-index: 2;
      }
      .status-badge {
          background: rgba(0, 0, 0, 0.8);
          backdrop-filter: blur(4px);
          color: var(--jazer-cyan);
          font-family: 'Courier New', monospace;
          font-size: 0.75rem;
          font-weight: 700;
          padding: 0.35rem 0.75rem;
          border-radius: 4px;
          border: 1px solid rgba(6, 182, 212, 0.3);
          text-transform: uppercase;
          letter-spacing: 0.05em;
      }

      .release-details {
          padding: 1.5rem;
      }
      .release-title {
          font-size: 1.5rem;
          font-weight: 700;
          color: white;
          margin-bottom: 0.5rem;
      }
      .release-meta {
          color: var(--text-muted);
          font-size: 0.875rem;
          margin-bottom: 1.5rem;
          display: flex;
          gap: 0.75rem;
          align-items: center;
      }
      .meta-divider {
          width: 4px; height: 4px;
          background: var(--text-muted);
          border-radius: 50%;
          opacity: 0.5;
      }

      .release-link {
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          color: var(--jazer-cyan);
          font-weight: 600;
          font-size: 0.875rem;
          text-decoration: none;
          transition: gap 0.3s ease;
      }
      .release-link:hover {
          gap: 0.75rem;
          text-shadow: 0 0 10px rgba(6, 182, 212, 0.6);
      }

      /* Platform Grid */
      .platform-grid {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          gap: 0.75rem;
          margin-top: 2rem;
      }
      .platform-pill {
          display: flex;
          align-items: center;
          gap: 0.75rem;
          padding: 0.75rem 1.5rem;
          background: rgba(255,255,255,0.03);
          border: 1px solid rgba(255,255,255,0.1);
          border-radius: 100px;
          color: var(--text-light);
          text-decoration: none;
          transition: all 0.3s ease;
      }
      .platform-pill:hover {
          background: rgba(255,255,255,0.1);
          transform: translateY(-2px);
      }
      .platform-pill img {
          width: 20px; height: 20px;
          filter: grayscale(1);
          transition: filter 0.3s ease;
      }
      .platform-pill:hover img {
          filter: grayscale(0);
      }

      @media (max-width: 768px) {
        .music-hero-section { min-height: auto; padding: 4rem 0 2rem; }
        
        /* Force 3 Columns on Mobile for ALL grids */
        .discography-grid,
        .faq-grid,
        .platform-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 0.25rem;
          justify-content: stretch;
        }

        /* Compact Card Styles for Release Grid */
        .release-card {
          min-width: 0;
          display: flex;
          flex-direction: column;
          border-radius: 8px;
        }
        .release-details {
          padding: 0.5rem 0.25rem;
        }
        .release-title {
          font-size: 0.65rem;
          margin-bottom: 0.1rem;
          line-height: 1.1;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
        .release-meta {
          font-size: 0.5rem;
          margin-bottom: 0.25rem;
          gap: 0.25rem;
        }
        .release-details p { display: none !important; }
        .release-link { font-size: 0.6rem; gap: 0.25rem; }
        .status-badge {
          font-size: 0.4rem;
          padding: 0.15rem 0.3rem;
          top: 0.5rem; right: 0.5rem;
        }
        .meta-divider { display: none; }
        .release-meta span { display: block; width: 100%; }

        /* Compact Styles for FAQ Grid */
        .faq-grid { margin: 1rem 0; }
        .premium-glass-card {
            padding: 0.5rem !important;
            border-left-width: 2px !important;
            min-height: 80px; 
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .premium-glass-card h3 {
            font-size: 0.6rem !important;
            line-height: 1.1;
            margin-bottom: 0.25rem !important;
        }
        .premium-glass-card p {
            font-size: 0.5rem !important;
            line-height: 1.2 !important;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        /* Compact Styles for Platform Grid */
        .platform-pill { 
            padding: 0 !important;
        }
        .platform-pill img { width: 28px !important; height: 28px !important; }

        .countdown-val { font-size: 1.25rem; }

        /* Compact Featured Track Section */
        .featured-track-container {
            display: grid;
            grid-template-columns: 80px 1fr;
            padding: 1.75rem 1rem;
            padding-right: 4rem; /* Space for the absolute button */
            gap: 1rem;
            text-align: left;
            align-items: center;
            position: relative;
        }
        .featured-track-visual {
            margin-bottom: 0;
            justify-content: flex-start;
        }
        .vinyl-container {
            max-width: 80px;
            margin: 0;
        }
        .featured-track-info {
            gap: 0.25rem;
        }
        .featured-header {
            display: block;
            margin-bottom: 0.25rem;
        }
        .featured-badge-pill {
            font-size: 0.55rem;
            padding: 0.15rem 0.5rem;
            margin-bottom: 0;
        }
        .featured-title {
            font-size: 1.1rem;
            margin-bottom: 0;
            line-height: 1.2;
        }
        .featured-artist {
            font-size: 0.85rem;
        }
        .audio-visualizer {
            display: none; /* Hide visualizer on mobile to save space */
        }
        .play-btn-circle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            width: 40px; height: 40px;
            margin: 0;
        }
        .play-icon, .pause-icon { width: 16px; height: 16px; }
        .featured-meta-row {
            justify-content: flex-start;
            gap: 0.75rem;
            margin-top: 0.25rem;
            font-size: 0.7rem;
        }
      }
      
      /* FAQ Grid Base Style */
      .faq-grid {
          max-width: 700px; 
          margin: 2rem auto; 
          display: grid; 
          gap: 1rem;
      }
      
      /* Countdown Styles */
      .countdown-container {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }
      .countdown-item {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .countdown-val {
        font-family: 'Courier New', monospace;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--jazer-cyan);
      }
      .countdown-label {
        font-size: 0.65rem;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.1em;
      }
      
      /* Audio Play Button */
      .play-btn-circle {
        width: 50px; height: 50px;
        border-radius: 50%;
        background: var(--jazer-cyan);
        display: flex; 
        align-items: center; justify-content: center;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
      }
      .play-btn-circle:hover {
        transform: scale(1.1);
        box-shadow: 0 0 25px rgba(6, 182, 212, 0.5);
      }
      .play-icon { width: 20px; height: 20px; fill: #000; margin-left: 3px; }
      .pause-icon { width: 18px; height: 18px; fill: #000; display: none; }
      .playing .play-icon { display: none; }
      .playing .pause-icon { display: block; }
      
      /* Ticker Styles */
      .home-ticker {
        border-top: 1px solid rgba(255,255,255,0.05);
        background: rgba(0,0,0,0.3);
        padding: 0.8rem 0;
        overflow: hidden;
        position: relative;
        width: 100%;
      }
      .home-ticker-track {
        display: flex;
        align-items: center;
        white-space: nowrap;
        animation: tickerScroll 120s linear infinite;
        width: max-content;
      }
      .home-ticker-track:hover { animation-play-state: paused; }
      .ticker-item {
        font-family: 'Courier New', monospace;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: rgba(255, 255, 255, 0.6);
        padding: 0 0.75rem;
      }
      .ticker-sep {
        color: var(--jazer-cyan);
        opacity: 0.5;
        font-size: 0.7rem;
        padding: 0 0.5rem;
      }
      @keyframes tickerScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      @media (max-width: 768px) {
        .home-ticker { padding: 0.4rem 0; }
        .ticker-item { font-size: 0.55rem; padding: 0 0.4rem; }
        .ticker-sep { font-size: 0.5rem; }
      }
    </style>
  </Fragment>

  <!-- Hero Section -->
  <section class="music-hero-section">
    <div class="sonic-waveform-bg" aria-hidden="true">
      {[...Array(15)].map((_, i) => (
        <div class="waveform-line" style={`--i: ${i + 1}`}></div>
      ))}
    </div>

    <div class="container music-hero-content" data-animate="fade-up">
      <div class="hero-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>SYSTEM STATUS: ONLINE</span>
      </div>
      
      <img
        src={`${base}assets/images/Transmission Incoming (429 x 150 px).svg`}
        alt="Transmission Incoming"
        class="music-hero-title-img"
        style="max-width: 100%; height: auto; margin-bottom: 1.5rem;"
      />
      
      <!-- Countdown -->
      <div id="countdown" class="countdown-container">
        <div class="countdown-item">
          <span class="countdown-val">364</span>
          <span class="countdown-label">Days</span>
        </div>
        <div class="countdown-item">
          <span class="countdown-val">23</span>
          <span class="countdown-label">Hrs</span>
        </div>
        <div class="countdown-item">
          <span class="countdown-val">59</span>
          <span class="countdown-label">Mins</span>
        </div>
      </div>
      
      <p class="music-hero-description">
        The archive of JaZeR's auditory transmissions. <br/>
        First signals expected to materialize in 2026.
      </p>
      
      <div class="hero-nav-links" style="display: flex; justify-content: center; gap: 1rem;">
        <a href="#transmission-log" class="system-button">Transmission Log</a>
        <a href="#join-beam" class="system-button" style="background: transparent;">Get Updates</a>
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Transmission Log (Releases) -->
  <section id="transmission-log" class="discography-section section">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Transmission Log</h2>
        <p class="section-subtitle">Incoming signals and scheduled releases</p>
      </div>
      
      <div class="discography-grid">
        {releases.map((release, index) => (
          <article class="release-card" data-animate="fade-up" style={`--delay: ${index * 0.1}s`}>
            <div class="release-cover">
              <div class={`cover-placeholder ${release.gradient}`} aria-hidden="true"></div>
              <div class="status-overlay" aria-hidden="true">
                <span class="status-badge">{release.status}</span>
              </div>
            </div>
            <div class="release-details">
              <h3 class="release-title">{release.title}</h3>
              <div class="release-meta">
                <span>{release.type}</span>
                <span class="meta-divider"></span>
                <span>{release.year}</span>
              </div>
              <p style="color: var(--text-gray); font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5;">
                {release.description}
              </p>
              <a href="#join-beam" class="release-link">
                {release.cta} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Divider -->
  <div class="tech-divider" aria-hidden="true">
    <div class="tech-line"></div>
    <div class="tech-node"></div>
    <div class="tech-line"></div>
  </div>

  <!-- Featured Track Section: System Preview -->
  <section class="featured-track-section section">
    <div class="container">
      <div class="featured-track-container premium-card" data-animate="fade-up">
        <!-- Visual (Vinyl) - Left Side -->
        <div class="featured-track-visual">
           <div class="vinyl-container">
             <div class="vinyl-record">
               <div class="vinyl-grooves"></div>
               <div class="vinyl-label">
                 <img src={`${base}assets/images/JZR-Circle-Monogram-Logo (500 x 500 px).svg`} alt="JZR" class="label-logo" />
               </div>
               <div class="vinyl-shine"></div>
             </div>
           </div>
        </div>
      
        <div class="featured-track-info">
          <div class="featured-header" style="display: flex; align-items: center; justify-content: space-between;">
            <span class="featured-badge-pill">🔥 New Release</span>
            <div id="audio-player-btn" class="play-btn-circle" role="button" aria-label="Play Preview">
