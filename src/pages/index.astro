---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
    ? new URL(`${base}assets/images/JaZeR Main Logo.jpg`, site).toString()
    : `${base}assets/images/JaZeR Main Logo.jpg`;

const announcement = {
    href: `${base}music`,
    text: 'Coming in 2026'
};

const pathways = [
    {
        title: 'Music',
        href: `${base}music`,
        desc: 'Releases and playlists',
        icon: `${base}assets/images/icons/music/headphones-black.svg`
    },
    {
        title: 'Videos & Visuals',
        href: `${base}videos`,
        desc: 'Visuals and behind-the-scenes',
        icon: `${base}assets/images/icons/navigation/videos.svg`
    },
    {
        title: 'About',
        href: `${base}about`,
        desc: 'The story and mission',
        icon: `${base}assets/images/icons/navigation/about.svg`
    },
    {
        title: 'Shop',
        href: `${base}shop`,
        desc: 'Merch and essentials',
        icon: `${base}assets/images/icons/navigation/shop.svg`
    },
    {
        title: 'Contact',
        href: `${base}contact`,
        desc: 'Collaborations and inquiries',
        icon: `${base}assets/images/icons/navigation/contact.svg`
    }
];

const nextSteps = [
    {
        title: 'Next Release',
        desc: 'TBA',
        status: 'Coming in 2026'
    },
    {
        title: 'Visual Drop',
        desc: 'TBA',
        status: 'TBA'
    },
    {
        title: 'Merch',
        desc: 'TBD',
        status: 'Expected in 2026'
    }
];

const mutedStatuses = ['TBA', 'TBD'];
---
<BaseLayout
  bodyClass="home-page has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={false}
  showPreloader={false}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={false}
  showBackToTop={true}
  includeGsap={false}
  extraStyles={[
    '/css/home.css'
  ]}
>
  <Fragment slot="head">
    <title>JaZeR - Official Site</title>
    <meta name="title" content="JaZeR - Official Site" />
    <meta
      name="description"
      content="Official site of JaZeR. Explore music, videos & visuals, and the story behind the sound."
    />
    <meta
      name="keywords"
      content="JaZeR, music artist, content creator, visual storyteller"
    />
    <meta name="author" content="JaZeR" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="JaZeR - Official Site" />
    <meta
      property="og:description"
      content="Explore music, videos & visuals, and the story behind the sound."
    />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content="JaZeR - Official Site" />
    <meta
      property="twitter:description"
      content="Explore music, videos & visuals, and the story behind the sound."
    />
    <meta property="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonical} />
  </Fragment>

  <section class="hero home-hero">
    <div class="hero-content home-hero-content" data-animate="fade-up">
      <div class="hero-status">
        <span class="status-chip">New Era: Coming in 2026</span>
      </div>
      <img
        class="hero-logo"
        src={`${base}assets/images/Vibrant JAZER Bubble Logo (450 x 150 px).svg`}
        alt="JaZeR"
        width="450"
        height="150"
        decoding="async"
      />
      <h1 class="jazer-h1 hero-title">
        Cinematic music and visuals for a new era.
      </h1>
      <p class="jazer-body-lg hero-subhead">
        Experience the next evolution of JaZeR. Music, art, and stories in one frequency.
      </p>
      <div class="cta-group">
        <a href={`${base}music`} class="cta-button">
          Listen Now
        </a>
        <a href="#pathways" class="cta-secondary">
          Explore
        </a>
      </div>
    </div>
  </section>

  <section class="section home-featured">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Featured</h2>
        <p class="section-subtitle">Priority updates and releases</p>
      </div>

      <article class="premium-card featured-card" data-animate="fade-up" data-animate-delay="100">
        <div class="featured-media" aria-hidden="true">
          <img
            src={`${base}assets/images/JZR-Circle-Monogram-Logo (500 x 500 px).svg`}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="featured-content">
          <span class="status-chip">Coming in 2026</span>
          <h3 class="jazer-h3">Next Release (TBA)</h3>
          <p class="text-muted">
            A new sonic journey is in production. Stay tuned for the drop.
          </p>
          <div class="cta-group">
            <a href={`${base}music`} class="cta-button">Visit Music</a>
            <a href={`${base}videos`} class="cta-secondary">Videos & Visuals</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="section home-pathways" id="pathways">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Explore</h2>
        <p class="section-subtitle">Choose your path</p>
      </div>

      <div class="pathways-grid">
        {pathways.map((pathway, index) => (
          <a
            href={pathway.href}
            class="pathway-card premium-card"
            data-animate="fade-up"
            data-animate-delay={index * 80}
          >
            <div class="pathway-icon" aria-hidden="true">
              <img src={pathway.icon} alt="" loading="lazy" decoding="async" />
            </div>
            <h3 class="jazer-h4">{pathway.title}</h3>
            <p class="text-muted text-sm">{pathway.desc}</p>
            <span class="pathway-cta">Explore</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section brand-banner">
    <div class="container">
      <div class="brand-banner-inner" data-animate="fade-up">
        <p class="jazer-eyebrow">Signature</p>
        <h2 class="jazer-h2">A focused beam of sound and visuals.</h2>
        <p class="jazer-body-lg text-muted brand-banner-subhead">
          Music, visuals, and story converge in one signal.
        </p>
        <img
          class="brand-banner-logo"
          src={`${base}assets/images/Vibrant JAZER Bubble Logo (300 x 100 px).svg`}
          alt="JaZeR"
          loading="lazy"
          decoding="async"
        />
        <div class="brand-banner-tags">
          <span class="tag-chip">Music</span>
          <span class="tag-chip">Visuals</span>
          <span class="tag-chip">Story</span>
          <span class="tag-chip">Community</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section home-proof">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Press / Features</h2>
        <p class="section-subtitle">Updates will appear here.</p>
      </div>

      <div class="premium-card press-card" data-animate="fade-up" data-animate-delay="100">
        <span class="status-chip is-muted">TBA</span>
        <p class="text-muted">
          Press mentions and features will be listed once available.
        </p>
      </div>
    </div>
  </section>

  <JoinBeamCTA
    id="updates"
    sectionClass="section home-updates"
    sectionStyle="padding: var(--section-spacing) 0;"
    captureStyle="max-width: 720px; margin: 0 auto;"
    subtitleStyle="font-size: 1.125rem; max-width: 520px; margin: 1.5rem auto;"
    subject="New subscriber from JaZeR Home page"
    buttonLabel="Get updates"
    proofText="Updates: <strong>Expected in 2026</strong>"
  >
    <Fragment slot="subtitle">
      Get updates—new drops expected in <strong>2026</strong>.
    </Fragment>
  </JoinBeamCTA>

  <section class="section home-next">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">What's Next</h2>
        <p class="section-subtitle">Signals in progress.</p>
      </div>

      <div class="next-grid">
        {nextSteps.map((item, index) => (
          <div class="premium-card next-card" data-animate="fade-up" data-animate-delay={index * 100}>
            <span class={`status-chip${mutedStatuses.includes(item.status) ? ' is-muted' : ''}`}>
              {item.status}
            </span>
            <h3 class="jazer-h4">{item.title}</h3>
            <p class="text-muted">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
