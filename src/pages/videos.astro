---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;

const announcement = {
  href: `${base}videos`,
  text: '🎬 FIRST MUSIC VIDEO PREMIERING MARCH 15, 2026 - Set your reminder now!'
};

// Upcoming video content
const upcomingVideos = [
  {
    id: 1,
    title: 'In Due Time - Official Music Video',
    type: 'Music Video',
    duration: '3:24',
    status: 'PREMIERE',
    date: 'March 15, 2026',
    description: 'The debut visual experience. Full cinematic production featuring stunning visuals and choreography.',
    color: 'var(--jazer-pink)',
    gradient: 'linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)'
  },
  {
    id: 2,
    title: 'Studio Sessions: The Making Of',
    type: 'Behind The Scenes',
    duration: '12:45',
    status: 'BTS',
    date: 'March 2026',
    description: 'Go behind the scenes as JaZeR creates the debut album. Studio process, production tips, and creative journey.',
    color: 'var(--jazer-cyan)',
    gradient: 'linear-gradient(135deg, rgba(6, 182, 212, 0.2) 0%, rgba(59, 130, 246, 0.2) 100%)'
  },
  {
    id: 3,
    title: 'Live Performance - First Show',
    type: 'Live Performance',
    duration: '45:00',
    status: 'LIVE',
    date: 'April 2026',
    description: 'Experience the first live performance featuring all new tracks, visual effects, and stage production.',
    color: 'var(--jazer-purple)',
    gradient: 'linear-gradient(135deg, rgba(139, 92, 246, 0.2) 0%, rgba(168, 85, 247, 0.2) 100%)'
  },
  {
    id: 4,
    title: 'Creative Process Vlog',
    type: 'Documentary',
    duration: '8:15',
    status: 'VLOG',
    date: 'April 2026',
    description: 'A day in the life: songwriting, production workflow, inspiration sources, and creative philosophy.',
    color: '#f59e0b',
    gradient: 'linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(251, 146, 60, 0.2) 100%)'
  },
  {
    id: 5,
    title: 'Lyric Video Collection',
    type: 'Lyric Video',
    duration: '15:30',
    status: 'LYRIC',
    date: 'May 2026',
    description: 'Animated lyric videos for all singles with kinetic typography and visual storytelling.',
    color: '#ec4899',
    gradient: 'linear-gradient(135deg, rgba(236, 72, 153, 0.2) 0%, rgba(219, 39, 119, 0.2) 100%)'
  },
  {
    id: 6,
    title: 'Tutorial: Producing Beats',
    type: 'Tutorial',
    duration: '20:00',
    status: 'EDU',
    date: 'May 2026',
    description: 'Learn how JaZeR produces tracks from scratch. FL Studio walkthrough, mixing tips, and sound design.',
    color: '#10b981',
    gradient: 'linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(5, 150, 105, 0.2) 100%)'
  }
];

// Video content types
const contentTypes = [
  { name: 'Music Videos', icon: 'video-black.svg', count: '5+', desc: 'Full production visuals' },
  { name: 'Behind The Scenes', icon: 'camera-black.svg', count: '10+', desc: 'Studio process' },
  { name: 'Live Sessions', icon: 'live-black.svg', count: '8+', desc: 'Performances & shows' },
  { name: 'Tutorials', icon: 'mixer-black.svg', count: '15+', desc: 'Production guides' }
];
---
<BaseLayout
  bodyClass="has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
  extraStyles={[
    '/css/pages-enhancements.css'
  ]}
>
  <Fragment slot="head">
    <title>Videos - JaZeR</title>
    <meta
      name="description"
      content="Watch JaZeR's latest music videos, behind-the-scenes content, live performances, and creative vlogs. First video premiering March 2026."
    />
    <meta
      name="keywords"
      content="JaZeR, videos, music videos, behind the scenes, visual content, vlogs, live performances, tutorials"
    />
    <link rel="canonical" href={canonical} />
    <style>
      .videos-hero {
        min-height: 70vh;
        padding: 8rem 0 4rem;
      }
      .hero-content {
        max-width: 800px;
        margin: 0 auto;
      }
      .hero-logo {
        margin: 2rem auto;
        display: block;
        width: 100%;
        max-width: 501px;
        height: auto;
      }
      .tagline-roles {
        max-width: 600px;
        margin: 0 auto 2rem;
      }
      
      /* Countdown Timer Styles */
      .countdown-container {
        max-width: 600px;
        margin: 3rem auto;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 16px;
        border: 1px solid rgba(6, 182, 212, 0.3);
      }
      .countdown-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .countdown-item {
        text-align: center;
      }
      .countdown-value {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-pink));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
      }
      .countdown-label {
        font-size: 0.813rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.5rem;
      }
      
      /* Video Gallery Grid */
      .video-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        margin-top: 3rem;
      }
      .video-card {
        background: rgba(0, 0, 0, 0.3);
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .video-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
      }
      .video-thumbnail {
        position: relative;
        aspect-ratio: 16/9;
        overflow: hidden;
      }
      .video-play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.4);
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .video-card:hover .video-play-overlay {
        opacity: 1;
      }
      .video-play-btn {
        width: 64px;
        height: 64px;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: scale(0.9);
        transition: transform 0.3s ease;
      }
      .video-card:hover .video-play-btn {
        transform: scale(1);
      }
      .video-content {
        padding: 1.5rem;
      }
      .video-meta {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }
      .video-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .video-duration {
        padding: 0.25rem 0.75rem;
        background: rgba(0, 0, 0, 0.6);
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .video-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }
      .video-description {
        font-size: 0.875rem;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 1rem;
      }
      .video-date {
        font-size: 0.813rem;
        color: var(--jazer-cyan);
        font-weight: 600;
      }
      
      /* Content Types Grid */
      .content-types-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-top: 3rem;
      }
      .content-type-card {
        background: rgba(0, 0, 0, 0.3);
        padding: 2rem;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        text-align: center;
        transition: all 0.3s ease;
      }
      .content-type-card:hover {
        transform: translateY(-4px);
        border-color: var(--jazer-cyan);
        box-shadow: 0 12px 24px rgba(6, 182, 212, 0.2);
      }
      .content-type-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 1rem;
        filter: invert(1);
        opacity: 0.8;
      }
      .content-type-name {
        font-size: 1.125rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
      }
      .content-type-count {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
      }
      .content-type-desc {
        font-size: 0.875rem;
        color: var(--text-muted);
      }
      
      /* Stats Section */
      .video-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin: 4rem 0;
      }
      .stat-card {
        text-align: center;
        padding: 2rem;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
      .stat-value {
        font-size: 3rem;
        font-weight: 900;
        background: linear-gradient(135deg, var(--jazer-pink), var(--jazer-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1;
      }
      .stat-label {
        font-size: 1rem;
        color: var(--text-muted);
        margin-top: 0.75rem;
      }
      
      /* Mobile Optimization */
      @media (max-width: 768px) {
        .videos-hero {
          min-height: auto;
          padding: 6rem 0 3rem;
        }
        .hero-logo {
          max-width: 300px;
        }
        .countdown-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .countdown-value {
          font-size: 2rem;
        }
        .video-gallery {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
        .content-types-grid {
          grid-template-columns: 1fr;
        }
        .video-stats {
          grid-template-columns: repeat(2, 1fr);
          gap: 1rem;
        }
        .stat-value {
          font-size: 2rem;
        }
      }
    </style>
  </Fragment>

        <!-- Hero Section -->
        <section class="hero hero-animated videos-hero">
            <div class="hero-particles"></div>
            <div class="hero-content" data-animate="zoom-in">
                <span class="hero-eyebrow" data-animate="fade-up">
                    <span class="eyebrow-word" style="--i: 0">Visual</span>
                    <span class="eyebrow-divider">✦</span>
                    <span class="eyebrow-word" style="--i: 1">Content</span>
                    <span class="eyebrow-divider">✦</span>
                    <span class="eyebrow-word" style="--i: 2">Archive</span>
                </span>
                <img class="hero-logo" src={`${base}assets/images/Videos & Visuals (501 x 75 px).svg`} alt="Videos & Visuals" />
                <p class="tagline-roles">
                    Music videos, behind-the-scenes studio sessions, live performances, tutorials, and creative vlogs. The complete visual experience launching 2026.
                </p>
                <div class="cta-group">
                    <a href="https://youtube.com/@jazer" class="cta-button" target="_blank" rel="noopener">
                        <span class="cta-icon">📺</span>
                        <span>Subscribe on YouTube</span>
                    </a>
                    <a href="#countdown" class="cta-secondary">
                        <span>Premiere Countdown</span>
                        <span class="cta-arrow">→</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Countdown Section -->
        <section class="section" id="countdown" style="padding: 4rem 0;">
            <div class="container">
                <div class="countdown-container" data-animate="fade-up">
                    <div style="text-align: center;">
                        <span class="track-badge" style="background: var(--jazer-pink); color: #fff; padding: 0.5rem 1rem; border-radius: 6px; font-size: 0.875rem; font-weight: 700; letter-spacing: 0.05em;">🎬 WORLD PREMIERE</span>
                        <h3 style="font-size: 1.5rem; font-weight: 700; margin-top: 1rem;">First Music Video Drops In</h3>
                    </div>
                    <div class="countdown-grid">
                        <div class="countdown-item">
                            <div class="countdown-value" id="days">62</div>
                            <div class="countdown-label">Days</div>
                        </div>
                        <div class="countdown-item">
                            <div class="countdown-value" id="hours">14</div>
                            <div class="countdown-label">Hours</div>
                        </div>
                        <div class="countdown-item">
                            <div class="countdown-value" id="minutes">32</div>
                            <div class="countdown-label">Minutes</div>
                        </div>
                        <div class="countdown-item">
                            <div class="countdown-value" id="seconds">08</div>
                            <div class="countdown-label">Seconds</div>
                        </div>
                    </div>
                    <div style="text-align: center; margin-top: 2rem;">
                        <a href="https://youtube.com/@jazer" class="cta-secondary" target="_blank" rel="noopener" style="display: inline-flex;">
                            <span>Set Reminder on YouTube</span>
                            <span class="cta-arrow">→</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="section" style="padding: 4rem 0; background: rgba(0,0,0,0.2);">
            <div class="container">
                <div class="video-stats" data-animate="fade-up">
                    <div class="stat-card">
                        <div class="stat-value">30+</div>
                        <div class="stat-label">Videos Planned</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">5K+</div>
                        <div class="stat-label">Subscribers Goal</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">4</div>
                        <div class="stat-label">Content Types</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-value">100%</div>
                        <div class="stat-label">Original Content</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Upcoming Videos Gallery -->
        <section class="section" style="padding: 6rem 0;">
            <div class="container">
                <div class="section-header" data-animate="fade-up">
                    <h2 class="section-title text-center gradient-text">Coming Soon</h2>
                    <p class="section-subtitle">Upcoming video releases throughout 2026</p>
                </div>

                <div class="video-gallery">
                    {upcomingVideos.map((video, index) => (
                        <article class="video-card" data-animate="fade-up" data-animate-delay={index * 100}>
                            <div class="video-thumbnail" style={`background: ${video.gradient};`}>
                                <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;">
                                    <img src={`${base}assets/images/icons/music/${video.type === 'Music Video' ? 'play-black.svg' : video.type === 'Behind The Scenes' ? 'video-black.svg' : 'live-black.svg'}`} alt={video.type} style="width: 64px; height: 64px; opacity: 0.3; filter: invert(1);" />
                                </div>
                                <div class="video-play-overlay">
                                    <div class="video-play-btn">
                                        <img src={`${base}assets/images/icons/music/play-black.svg`} alt="Play" style="width: 28px; height: 28px; margin-left: 3px;" />
                                    </div>
                                </div>
                                <span style={`position: absolute; bottom: 1rem; right: 1rem;`} class="video-duration">{video.duration}</span>
                            </div>
                            <div class="video-content">
                                <div class="video-meta">
                                    <span class="video-badge" style={`background: ${video.color}; color: ${video.color === '#f59e0b' || video.color === '#10b981' ? '#000' : '#fff'};`}>{video.status}</span>
                                    <span class="track-genre">{video.type}</span>
                                </div>
                                <h3 class="video-title">{video.title}</h3>
                                <p class="video-description">{video.description}</p>
                                <p class="video-date">📅 {video.date}</p>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Content Types Section -->
        <section class="section" style="padding: 6rem 0; background: rgba(0,0,0,0.2);">
            <div class="container">
                <div class="section-header" data-animate="fade-up">
                    <h2 class="section-title text-center gradient-text">What to Expect</h2>
                    <p class="section-subtitle">Diverse content across multiple formats</p>
                </div>

                <div class="content-types-grid">
                    {contentTypes.map((type, index) => (
                        <div class="content-type-card" data-animate="fade-up" data-animate-delay={index * 100}>
                            <img src={`${base}assets/images/icons/music/${type.icon}`} alt={type.name} class="content-type-icon" />
                            <h3 class="content-type-name">{type.name}</h3>
                            <div class="content-type-count">{type.count}</div>
                            <p class="content-type-desc">{type.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Platform Links -->
        <section class="section" style="padding: 6rem 0;">
            <div class="container">
                <div class="section-header" data-animate="fade-up">
                    <h2 class="section-title text-center gradient-text">Watch Everywhere</h2>
                    <p class="section-subtitle">Follow on your favorite platform</p>
                </div>

                <div class="streaming-platform-grid" style="max-width: 800px; margin: 3rem auto 0; gap: 1.5rem;">
                    <a href="https://youtube.com/@jazer" class="platform-card premium-card" target="_blank" rel="noopener" data-animate="fade-up" data-animate-delay="100">
                        <div class="platform-icon">
                            <img src={`${base}assets/images/icons/social/youtube-round-icon.svg`} alt="YouTube" width="48" height="48">
                        </div>
                        <h4 class="platform-name" style="font-size: 1rem; font-weight: 600;">YouTube</h4>
                        <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">Full-length videos & vlogs</p>
                    </a>

                    <a href="https://tiktok.com/@jazer_music" class="platform-card premium-card" target="_blank" rel="noopener" data-animate="fade-up" data-animate-delay="150">
                        <div class="platform-icon">
                            <img src={`${base}assets/images/icons/social/tiktok-round-logo.svg`} alt="TikTok" width="48" height="48">
                        </div>
                        <h4 class="platform-name" style="font-size: 1rem; font-weight: 600;">TikTok</h4>
                        <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">Short clips & trends</p>
                    </a>

                    <a href="https://instagram.com/jazer_music" class="platform-card premium-card" target="_blank" rel="noopener" data-animate="fade-up" data-animate-delay="200">
                        <div class="platform-icon">
                            <img src={`${base}assets/images/icons/social/instagram-round-icon.svg`} alt="Instagram" width="48" height="48">
                        </div>
                        <h4 class="platform-name" style="font-size: 1rem; font-weight: 600;">Instagram</h4>
                        <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">Reels & stories</p>
                    </a>

                    <a href="https://www.facebook.com/jazer.music/" class="platform-card premium-card" target="_blank" rel="noopener" data-animate="fade-up" data-animate-delay="250">
                        <div class="platform-icon">
                            <img src={`${base}assets/images/icons/social/round-facebook-icon.svg`} alt="Facebook" width="48" height="48">
                        </div>
                        <h4 class="platform-name" style="font-size: 1rem; font-weight: 600;">Facebook</h4>
                        <p style="font-size: 0.875rem; color: var(--text-muted); margin-top: 0.25rem;">Live streams & updates</p>
                    </a>
                </div>
            </div>
        </section>

        <!-- Video Request Section -->
        <section class="section" style="padding: 6rem 0; background: rgba(0,0,0,0.2);">
            <div class="container">
                <div class="premium-glass-card" style="max-width: 700px; margin: 0 auto; padding: 3rem;" data-animate="fade-up">
                    <h2 class="text-center gradient-text" style="margin-bottom: 1rem;">Request a Video</h2>
                    <p class="text-center text-muted" style="margin-bottom: 2rem;">What type of content would you like to see? Let us know!</p>
                    
                    <form class="contact-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
                        <div class="modern-form-group">
                            <label for="video-type" class="modern-label">Content Type</label>
                            <select id="video-type" name="type" class="modern-input" required>
                                <option value="">Select type...</option>
                                <option value="music-video">Music Video</option>
                                <option value="bts">Behind The Scenes</option>
                                <option value="tutorial">Production Tutorial</option>
                                <option value="live">Live Performance</option>
                                <option value="vlog">Vlog / Day in Life</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        
                        <div class="modern-form-group">
                            <label for="request" class="modern-label">Your Request</label>
                            <textarea id="request" name="request" class="modern-textarea" required placeholder="Tell us what you'd like to see..."></textarea>
                        </div>
                        
                        <div class="modern-form-group">
                            <label for="request-email" class="modern-label">Email (optional)</label>
                            <input type="email" id="request-email" name="email" class="modern-input" placeholder="your@email.com">
                        </div>
                        
                        <input type="hidden" name="_subject" value="Video Request from JaZeR website">
                        <button type="submit" class="cta-button" style="width: 100%;">Submit Request</button>
                    </form>
                </div>
            </div>
        </section>

        <!-- Email Signup -->
        <JoinBeamCTA
          id="notify"
          sectionStyle="padding: 6rem 0;"
          captureStyle="max-width: 700px; margin: 0 auto;"
          subtitleStyle="font-size: 1.125rem; max-width: 500px; margin: 1.5rem auto;"
          subject="New subscriber from JaZeR Videos page"
          buttonLabel="Get Premiere Alert"
          proofText="Join <strong>500+</strong> fans waiting for the premiere"
        >
          <Fragment slot="subtitle">
            Get notified when the first video drops. Plus exclusive <strong>behind-the-scenes content</strong> and early access.
          </Fragment>
        </JoinBeamCTA>
    
    <script>
        // Countdown Timer
        function updateCountdown() {
            const premiereDate = new Date('2026-03-15T00:00:00Z').getTime();
            const now = new Date().getTime();
            const distance = premiereDate - now;
            
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);
            
            document.getElementById('days').textContent = days;
            document.getElementById('hours').textContent = hours.toString().padStart(2, '0');
            document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0');
            document.getElementById('seconds').textContent = seconds.toString().padStart(2, '0');
            
            if (distance < 0) {
                document.getElementById('days').textContent = '00';
                document.getElementById('hours').textContent = '00';
                document.getElementById('minutes').textContent = '00';
                document.getElementById('seconds').textContent = '00';
            }
        }
        
        updateCountdown();
        setInterval(updateCountdown, 1000);
    </script>
</BaseLayout>
