---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
    ? new URL(`${base}assets/images/JaZeR Main Logo.jpg`, site).toString()
    : `${base}assets/images/JaZeR Main Logo.jpg`;

const announcement = {
    href: `${base}music`,
    text: 'New Era: Coming in 2026'
};

const pathways = [
    {
        title: 'Music',
        href: `${base}music`,
        desc: 'Sonic transmissions',
        icon: `${base}assets/images/icons/music/headphones-black.svg`,
        cta: 'Listen'
    },
    {
        title: 'Videos',
        href: `${base}videos`,
        desc: 'Visual stories',
        icon: `${base}assets/images/icons/navigation/videos.svg`,
        cta: 'Watch'
    },
    {
        title: 'Shop',
        href: `${base}shop`,
        desc: 'Apparel & Goods',
        icon: `${base}assets/images/icons/navigation/shop.svg`,
        cta: 'Browse'
    },
    {
        title: 'Contact',
        href: `${base}contact`,
        desc: 'Inquiries',
        icon: `${base}assets/images/icons/navigation/contact.svg`,
        cta: 'Connect'
    }
];

const faqs = [
    {
        q: "When is the debut release?",
        a: "The first official project is expected to arrive in 2026. Stay tuned for announcements."
    },
    {
        q: "Will there be live performances?",
        a: "Live experiences are in the planning stages. Dates and locations are TBA."
    },
    {
        q: "How can I collaborate?",
        a: "JaZeR is open to creative partnerships. Reach out via the Contact page to start a conversation."
    }
];
---
<BaseLayout
  bodyClass="about-page has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={false}
  showPreloader={false}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={false}
  showBackToTop={true}
  includeGsap={false}
  extraStyles={[
    '/css/home.css' /* Reusing home styles for consistent hero/card look */
  ]}
>
  <Fragment slot="head">
    <title>About JaZeR - The Story</title>
    <meta name="title" content="About JaZeR - The Story" />
    <meta
      name="description"
      content="JaZeR is a creative project exploring the intersection of cinematic music, visual storytelling, and digital identity."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
  </Fragment>

  <section class="hero home-hero about-hero">
    <div class="hero-content home-hero-content" data-animate="fade-up">
      <div class="hero-status">
        <span class="status-chip">Established 2026</span>
      </div>
      <h1 class="jazer-h1 hero-title">
        The signal behind the sound.
      </h1>
      <p class="jazer-body-lg hero-subhead">
        JaZeR is a creative project exploring the intersection of cinematic music, visual storytelling, and digital identity.
      </p>
    </div>
  </section>

  <section class="section about-mission">
    <div class="container">
      <div class="brand-banner-inner" data-animate="fade-up" style="max-width: 900px; margin: 0 auto;">
        <p class="jazer-eyebrow">Mission</p>
        <h2 class="jazer-h2">A sonic escape hatch.</h2>
        <p class="jazer-body-lg text-muted" style="max-width: 60ch; margin: 0 auto;">
          To create a focused beam of energy designed to cut through the noise, light up the dark, and remind people of what's possible.
        </p>
        <div class="brand-banner-tags">
            <span class="tag-chip">Cinematic</span>
            <span class="tag-chip">Emotive</span>
            <span class="tag-chip">Futuristic</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-story">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">The Narrative</h2>
        <p class="section-subtitle">Origins and evolution</p>
      </div>

      <div class="premium-card" data-animate="fade-up" style="max-width: 800px; margin: 0 auto;">
        <h3 class="jazer-h3">Digital Roots</h3>
        <p class="text-muted jazer-body-lg" style="margin-top: 1rem;">
          Born from a desire to merge sound and vision, JaZeR represents the evolution of digital artistry. In a world of infinite noise, this project aims to be a clear, resonant frequency.
        </p>
        <p class="text-muted jazer-body-lg" style="margin-top: 1rem;">
          What began as an experiment in sound design is growing into a full-spectrum media experience. The journey is just beginning.
        </p>
      </div>
    </div>
  </section>

  <section class="section about-status">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Status</h2>
        <p class="section-subtitle">Current transmission state</p>
      </div>

      <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 0;">
        <div class="premium-card" data-animate="fade-up" data-animate-delay="100">
          <span class="status-chip is-muted">Now</span>
          <h3 class="jazer-h4">Production Mode</h3>
          <p class="text-muted">
            Currently in the studio crafting the sonic palette for the debut collection. Focusing on sound design and visual identity.
          </p>
        </div>
        <div class="premium-card" data-animate="fade-up" data-animate-delay="200">
          <span class="status-chip">Next</span>
          <h3 class="jazer-h4">The Debut</h3>
          <p class="text-muted">
            The first major release is in development. Expect a fusion of audio and visual art. Coming in 2026.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-pathways">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">Explore</h2>
        <p class="section-subtitle">Discover the ecosystem</p>
      </div>

      <div class="pathways-grid">
        {pathways.map((pathway, index) => (
          <a
            href={pathway.href}
            class="pathway-card premium-card"
            data-animate="fade-up"
            data-animate-delay={index * 80}
          >
            <div class="pathway-icon" aria-hidden="true">
              <img src={pathway.icon} alt="" loading="lazy" decoding="async" />
            </div>
            <h3 class="jazer-h4">{pathway.title}</h3>
            <p class="text-muted text-sm">{pathway.desc}</p>
            <span class="pathway-cta">{pathway.cta}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-faq">
    <div class="container">
      <div class="section-header" data-animate="fade-up">
        <h2 class="section-title text-center gradient-text">FAQ</h2>
        <p class="section-subtitle">Common questions</p>
      </div>

      <div style="max-width: 700px; margin: 0 auto; display: grid; gap: 1rem;">
        {faqs.map((faq, index) => (
          <div class="premium-card" data-animate="fade-up" data-animate-delay={index * 50} style="padding: 1.5rem;">
            <h3 class="jazer-h5" style="margin-bottom: 0.5rem; color: var(--text-light);">{faq.q}</h3>
            <p class="text-muted">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <JoinBeamCTA
    id="updates"
    sectionClass="section home-updates"
    sectionStyle="padding: var(--section-spacing) 0;"
    captureStyle="max-width: 720px; margin: 0 auto;"
    subtitleStyle="font-size: 1.125rem; max-width: 520px; margin: 1.5rem auto;"
    subject="New subscriber from JaZeR About page"
    buttonLabel="Get updates"
    proofText="Updates: <strong>Expected in 2026</strong>"
  >
    <Fragment slot="subtitle">
      Stay connected with the journey. New drops expected in <strong>2026</strong>.
    </Fragment>
  </JoinBeamCTA>

</BaseLayout>
