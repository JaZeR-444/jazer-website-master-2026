---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';
const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site
  ? new URL(`${base}assets/images/JaZeR Main Logo.jpg`, site).toString()
  : `${base}assets/images/JaZeR Main Logo.jpg`;

const announcement = {
  href: `${base}music`,
  text: '🎵 NEW SINGLE "IN DUE TIME" DROPPING MARCH 15, 2026 - Pre-save now!'
};

// Upcoming Events
const upcomingEvents = [
  { title: 'Single Release', date: 'March 15, 2026', type: 'Music', icon: '🎵', status: 'SOON' },
  { title: 'Music Video Premiere', date: 'March 22, 2026', type: 'Video', icon: '🎬', status: 'COMING' },
  { title: 'First Merch Drop', date: 'Late March 2026', type: 'Shop', icon: '🛍️', status: 'ANNOUNCED' }
];

// Fan Testimonials
const testimonials = [
  { text: "JaZeR's sound is like nothing I've heard before. Pure energy.", author: "Early Supporter", platform: "Instagram" },
  { text: "This is the artist I've been waiting for. The vibe is unmatched.", author: "Day One Fan", platform: "YouTube" },
  { text: "Every track hits different. Can't wait for the debut album!", author: "Music Lover", platform: "Twitter" },
  { text: "The production quality is insane. This is next level.", author: "Producer Fan", platform: "SoundCloud" }
];

// Quick Links
const quickLinks = [
  { name: 'Music', url: '/music', icon: '🎵', desc: 'Stream tracks', gradient: 'linear-gradient(135deg, #1DB954, #191414)' },
  { name: 'Videos', url: '/videos', icon: '🎬', desc: 'Watch content', gradient: 'linear-gradient(135deg, #FF0000, #282828)' },
  { name: 'About', url: '/about', icon: '👤', desc: 'My story', gradient: 'linear-gradient(135deg, #8b5cf6, #6366f1)' },
  { name: 'Shop', url: '/shop', icon: '🛍️', desc: 'Get merch', gradient: 'linear-gradient(135deg, #ec4899, #f43f5e)' },
  { name: 'Contact', url: '/contact', icon: '💬', desc: 'Get in touch', gradient: 'linear-gradient(135deg, #06b6d4, #0ea5e9)' }
];

// Achievements
const achievements = [
  { title: '10K+', label: 'Streams', icon: '🎧' },
  { title: '500+', label: 'Fans', icon: '💜' },
  { title: '25+', label: 'Tracks', icon: '🎵' },
  { title: '2026', label: 'Launch Year', icon: '🚀' }
];

// Latest Updates
const latestUpdates = [
  { title: 'Studio Update', desc: 'Final mixing sessions for the debut single', date: 'Jan 2026', icon: '🎛️' },
  { title: 'Music Video', desc: 'Filming wrapped for "In Due Time" visual', date: 'Jan 2026', icon: '🎬' },
  { title: 'Merch Preview', desc: 'First look at upcoming merchandise designs', date: 'Jan 2026', icon: '👕' }
];

// Social Links
const socialPreviews = [
  { platform: 'Instagram', handle: '@jazer_music', followers: '2.5K', icon: 'instagram-round-icon.svg' },
  { platform: 'TikTok', handle: '@jazer_music', followers: '5K', icon: 'tiktok-round-logo.svg' },
  { platform: 'YouTube', handle: '@jazer', followers: '1.2K', icon: 'youtube-round-icon.svg' },
  { platform: 'Spotify', handle: 'JaZeR', followers: '800', icon: 'spotify-round-icon.svg' }
];
---
<BaseLayout
  bodyClass="has-announcement"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
>
  <Fragment slot="head">
    <title>JaZeR - Content Creator & Musician</title>
    <meta name="title" content="JaZeR - Content Creator & Musician" />
    <meta
      name="description"
      content="Official website of JaZeR - Content creator, music artist, and digital storyteller. Listen to my latest tracks, watch exclusive content, and connect with my creative journey."
    />
    <meta
      name="keywords"
      content="JaZeR, music artist, content creator, electronic music, music producer"
    />
    <meta name="author" content="JaZeR" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="JaZeR - Content Creator & Musician" />
    <meta
      property="og:description"
      content="Official website of JaZeR - Listen to my latest tracks, watch exclusive content, and connect with my creative journey."
    />
    <meta
      property="og:image"
      content={ogImage}
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content="JaZeR - Content Creator & Musician" />
    <meta
      property="twitter:description"
      content="Official website of JaZeR - Listen to my latest tracks, watch exclusive content, and connect with my creative journey."
    />
    <meta
      property="twitter:image"
      content={ogImage}
    />

    <link rel="canonical" href={canonical} />
    <style>
      /* Mobile Optimization for Homepage */
      @media (max-width: 768px) {
        .hero {
          min-height: auto;
          padding: 6rem 0 4rem;
        }
        .hero-content {
          padding: 0 1rem;
        }
        .bento-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
        .grid-span-2 {
          grid-column: 1;
        }
        .stats-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .stat-item {
          padding: 2rem;
        }
        .featured-section {
          padding: 4rem 0;
        }
        /* New section mobile styles */
        .quick-links-row {
          grid-template-columns: repeat(2, 1fr) !important;
        }
        .achievements-row {
          grid-template-columns: repeat(2, 1fr) !important;
        }
        .now-playing-flex {
          flex-direction: column;
          text-align: center;
        }
        .now-playing-art {
          margin: 0 auto;
        }
      }
      
      @media (max-width: 480px) {
        .quick-links-row {
          grid-template-columns: 1fr !important;
        }
      }
    </style>
  </Fragment>

      <!-- HOME PAGE - #3 Hero Animation -->
      <section class="hero hero-animated">
        <div class="hero-particles"></div>
        <div class="hero-content" data-animate="zoom-in">
          <span class="hero-eyebrow" data-animate="fade-up">
            <span class="eyebrow-word" style="--i: 0">Welcome</span>
            <span class="eyebrow-divider">✦</span>
            <span class="eyebrow-word" style="--i: 1">to</span>
            <span class="eyebrow-divider">✦</span>
            <span class="eyebrow-word" style="--i: 2">the</span>
            <span class="eyebrow-divider">✦</span>
            <span class="eyebrow-word" style="--i: 3">experience</span>
          </span>
          <img class="hero-logo" src={`${base}assets/images/Vibrant JAZER Bubble Logo (450 x 150 px).svg`} alt="JaZeR" />
          <!-- #2 - Typewriter Tagline -->
          <p class="tagline-roles">
            <span class="role" style="--i: 0">Content Creator</span>
            <span class="role-divider">✦</span>
            <span class="role" style="--i: 1">Musician</span>
            <span class="role-divider">✦</span>
            <span class="role" style="--i: 2">Digital Storyteller</span>
          </p>
          <!-- #1 - Dual CTA Buttons -->
          <div class="cta-group">
            <a href={`${base}music`} class="cta-button" data-audio-trigger>
              <img src={`${base}assets/images/icons/music/headphones-black.svg`} alt="" class="cta-icon" style="width: 1.5em; height: 1.5em; filter: invert(1);" />
              <span>Listen Now</span>
            </a>
            <a href={`${base}about`} class="cta-secondary">
              <span>Learn My Story</span>
              <span class="cta-arrow">→</span>
            </a>
          </div>
        </div>
        <!-- #3 - Scroll Indicator -->
        <div class="scroll-indicator" onclick="document.querySelector('.stats-section').scrollIntoView({behavior: 'smooth'})">
          <span>Explore</span>
          <div class="scroll-indicator-arrow"></div>
        </div>
      </section>

      <!-- #10 - Stats Section (Social Proof) - ROUND 2 GLASSMORPHISM -->
      <section class="stats-section" data-animate="fade-up">
        <div class="stats-container">
          <h2 class="stats-heading visually-hidden">JaZeR by the numbers</h2>
          <div class="stats-grid">
            <!-- Global SVG Gradient Defs -->
            <svg style="width:0;height:0;position:absolute;" aria-hidden="true" focusable="false">
              <linearGradient id="infinityGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="var(--jazer-cyan)" />
                <stop offset="50%" stop-color="var(--jazer-purple)" />
                <stop offset="100%" stop-color="var(--jazer-pink)" />
              </linearGradient>
            </svg>

            <div class="stat-item premium-card stats-card-refined" data-animate="fade-up" data-animate-delay="100">
              <!-- Listeners Icon: Activity/Radio -->
              <img src={`${base}assets/images/icons/music/radio-black.svg`} class="stat-icon-svg" alt="" style="width: 24px; height: 24px; filter: invert(1);" />
              <div class="stat-value" data-count="10000">
                <svg class="stat-infinity-svg" viewBox="0 0 60 30">
                  <path class="stat-infinity-path" d="M15 15 C 5 15, 5 5, 15 5 C 25 5, 25 25, 30 25 C 35 25, 35 5, 45 5 C 55 5, 55 15, 45 15 C 35 15, 35 35, 30 35 C 25 35, 25 15, 15 15 Z" transform="translate(0, -2.5) scale(1, 0.8)"/>
                </svg>
              </div>
              <div class="stat-label">Monthly Listeners</div>
            </div>

            <div class="stat-item premium-card stats-card-refined" data-animate="fade-up" data-animate-delay="200">
              <!-- Tracks Icon: Music Note -->
              <img src={`${base}assets/images/icons/music/playlist-black.svg`} class="stat-icon-svg icon-purple" alt="" style="width: 24px; height: 24px; filter: invert(1);" />
              <div class="stat-value" data-count="25">
                <svg class="stat-infinity-svg" viewBox="0 0 60 30">
                  <path class="stat-infinity-path" d="M15 15 C 5 15, 5 5, 15 5 C 25 5, 25 25, 30 25 C 35 25, 35 5, 45 5 C 55 5, 55 15, 45 15 C 35 15, 35 35, 30 35 C 25 35, 25 15, 15 15 Z" transform="translate(0, -2.5) scale(1, 0.8)"/>
                </svg>
              </div>
              <div class="stat-label">Original Tracks</div>
            </div>

            <div class="stat-item premium-card stats-card-refined" data-animate="fade-up" data-animate-delay="300">
              <!-- Community Icon: Users/Sparkle -->
               <img src={`${base}assets/images/icons/music/crowd-black.svg`} class="stat-icon-svg icon-pink" alt="" style="width: 24px; height: 24px; filter: invert(1);" />
              <div class="stat-value" data-count="5000">
                <svg class="stat-infinity-svg" viewBox="0 0 60 30">
                  <path class="stat-infinity-path" d="M15 15 C 5 15, 5 5, 15 5 C 25 5, 25 25, 30 25 C 35 25, 35 5, 45 5 C 55 5, 55 15, 45 15 C 35 15, 35 35, 30 35 C 25 35, 25 15, 15 15 Z" transform="translate(0, -2.5) scale(1, 0.8)"/>
                </svg>
              </div>
              <div class="stat-label">Community Members</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Featured Content Section -->
      <section class="section featured-section" style="position: relative;">
        <div class="container">
          <!-- Ambient Glow Orbs -->
          <div class="ambient-glow magenta"></div>
          <div class="ambient-glow blue"></div>

          <div class="section-header">
            <img src={`${base}assets/images/Featured Content (450 x 150 px).svg`} alt="Featured Content" class="section-title-img" data-animate="fade-up">
            <p class="section-subtitle" data-animate="fade-up" data-animate-delay="100">Explore my latest creative work</p>
          </div>
          
          <div class="bento-grid">
            <!-- Main Feature Spans 2 Columns -->
            <a href={`${base}music`} class="card-link grid-span-2" data-animate="fade-up" data-animate-delay="100">
              <article class="card card-featured track-card premium-card">
                <!-- Vinyl Record -->
                <div class="vinyl-container">
                  <div class="vinyl-record">
                    <div class="vinyl-grooves"></div>
                    <div class="vinyl-label">
                      <img src={`${base}assets/images/JZR-Circle-Monogram-Logo (500 x 500 px).svg`} alt="JZR" class="label-logo" />
                    </div>
                    <div class="vinyl-shine"></div>
                  </div>
                </div>
                
                <!-- Track Info -->
                <div class="track-info">
                  <span class="track-badge">NEW RELEASE</span>
                  <h3 class="track-title">Latest Track</h3>
                  <p class="track-artist">JaZeR</p>
                  
                  <!-- Waveform Visual -->
                  <div class="track-waveform">
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                    <span class="wave-bar"></span>
                  </div>
                  
                  <div class="track-meta">
                    <span class="track-duration">3:24</span>
                    <span class="track-genre">Electronic • Bass</span>
                  </div>
                  
                  <span class="track-cta">Stream Now</span>
                </div>
              </article>
            </a>
            <a href={`${base}videos`} class="card-link" data-animate="fade-up" data-animate-delay="200">
              <article class="card premium-card video-card">
                <!-- Visual Section (Top) -->
                <div class="media-visual-container">
                  <div class="video-icon-static">
                    <img src={`${base}assets/images/icons/music/video-black.svg`} class="video-play-svg" alt="" style="width: 48px; height: 48px; filter: invert(1);" />
                  </div>
                </div>
                
                <!-- Info Section (Bottom) -->
                <div class="track-info">
                  <span class="track-badge" style="background: var(--jazer-cyan); color: #000; box-shadow: 0 4px 12px rgba(6, 182, 212, 0.4);">LATEST UPLOAD</span>
                  <h3 class="track-title">New Video</h3>
                  <p class="track-artist">Production Vlog</p>
                  
                  <div class="track-meta">
                    <span class="track-duration">12:45</span>
                    <span class="track-genre">Behind The Scenes</span>
                  </div>
                  
                  <span class="track-cta">Watch Now</span>
                </div>
              </article>
            </a>
            <a href={`${base}contact`} class="card-link" data-animate="fade-up" data-animate-delay="300">
              <article class="card premium-card live-card">
                <!-- Visual Section (Top) -->
                <div class="media-visual-container">
                   <div class="live-visual">
                       <img src={`${base}assets/images/icons/music/mic-black.svg`} class="live-mic-svg" alt="" style="width: 48px; height: 48px; filter: invert(1);" />
                       <div class="live-pulse-ring"></div>
                   </div>
                </div>
                
                <!-- Info Section (Bottom) -->
                <div class="track-info">
                  <span class="track-badge" style="background: var(--jazer-pink); color: #fff; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);">UPCOMING</span>
                  <h3 class="track-title">Live Sessions</h3>
                  <p class="track-artist">Q&A + Performance</p>
                  
                  <div class="track-meta">
                    <span class="track-duration">MAR 15</span>
                    <span class="track-genre">Twitch • YouTube</span>
                  </div>
                  
                  <span class="track-cta">Get Notified</span>
                </div>
              </article>
            </a>
          </div>
        </div>
      </section>

      <!-- Now Playing / Featured Track -->
      <section class="section" style="padding: 6rem 0; background: rgba(0,0,0,0.3);">
        <div class="container">
          <div class="section-header" data-animate="fade-up">
            <h2 class="section-title text-center gradient-text">Now Playing</h2>
            <p class="section-subtitle">Preview the upcoming debut single</p>
          </div>
          
          <div class="premium-glass-card" style="max-width: 800px; margin: 3rem auto; padding: 2rem; display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;" data-animate="fade-up">
            <!-- Album Art -->
            <div style="width: 200px; height: 200px; background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple)); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <img src={`${base}assets/images/JZR-Circle-Monogram-Logo (500 x 500 px).svg`} alt="JZR" style="width: 120px; height: 120px;" />
            </div>
            
            <!-- Track Info -->
            <div style="flex: 1; min-width: 250px;">
              <span style="display: inline-block; padding: 0.25rem 0.75rem; background: var(--jazer-pink); border-radius: 4px; font-size: 0.75rem; font-weight: 700; margin-bottom: 0.75rem;">COMING MARCH 2026</span>
              <h3 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.25rem;">In Due Time</h3>
              <p style="color: var(--text-muted); margin-bottom: 1rem;">JaZeR • Debut Single</p>
              
              <!-- Waveform -->
              <div style="display: flex; align-items: flex-end; gap: 3px; height: 40px; margin-bottom: 1rem;">
                {[...Array(24)].map((_, i) => (
                  <div style={`width: 4px; background: linear-gradient(to top, var(--jazer-cyan), var(--jazer-purple)); border-radius: 2px; animation: waveform ${0.4 + Math.random() * 0.4}s ease-in-out infinite alternate; height: ${20 + Math.random() * 60}%;`}></div>
                ))}
              </div>
              
              <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href={`${base}music`} class="cta-button" style="padding: 0.75rem 1.5rem;">
                  <span>🎧</span>
                  <span>Pre-Save</span>
                </a>
                <button class="cta-secondary" style="padding: 0.75rem 1.5rem;">
                  <span>🔔 Notify Me</span>
                </button>
              </div>
            </div>
          </div>
          
          <style>
            @keyframes waveform {
              0% { height: 20%; }
              100% { height: 80%; }
            }
          </style>
        </div>
      </section>

      <!-- Upcoming Events / Countdown -->
      <section class="section" style="padding: 6rem 0;">
        <div class="container">
          <div class="section-header" data-animate="fade-up">
            <h2 class="section-title text-center gradient-text">Coming Up</h2>
            <p class="section-subtitle">Mark your calendar for these moments</p>
          </div>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 3rem;">
            {upcomingEvents.map((event, index) => (
              <div class="premium-card" style="padding: 2rem; position: relative; overflow: hidden;" data-animate="fade-up" data-animate-delay={index * 100}>
                <span style={`position: absolute; top: 1rem; right: 1rem; padding: 0.25rem 0.75rem; background: ${event.status === 'SOON' ? 'var(--jazer-pink)' : 'rgba(255,255,255,0.1)'}; border-radius: 4px; font-size: 0.75rem; font-weight: 700;`}>{event.status}</span>
                <div style="font-size: 2.5rem; margin-bottom: 1rem;">{event.icon}</div>
                <h3 style="font-weight: 700; font-size: 1.25rem; margin-bottom: 0.5rem;">{event.title}</h3>
                <p style="color: var(--jazer-cyan); font-weight: 600; margin-bottom: 0.25rem;">{event.date}</p>
                <p style="font-size: 0.875rem; color: var(--text-muted);">{event.type}</p>
              </div>
            ))}
          </div>
          
          <!-- Main Countdown -->
          <div class="premium-glass-card" style="max-width: 600px; margin: 3rem auto; padding: 2rem; text-align: center;" data-animate="fade-up">
            <p style="font-weight: 600; margin-bottom: 1rem;">🎵 "In Due Time" drops in</p>
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
              <div>
                <div id="countdown-days" style="font-size: 2.5rem; font-weight: 900; background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">62</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">DAYS</div>
              </div>
              <div>
                <div id="countdown-hours" style="font-size: 2.5rem; font-weight: 900; background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">14</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">HOURS</div>
              </div>
              <div>
                <div id="countdown-mins" style="font-size: 2.5rem; font-weight: 900; background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">32</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">MINS</div>
              </div>
              <div>
                <div id="countdown-secs" style="font-size: 2.5rem; font-weight: 900; background: linear-gradient(135deg, var(--jazer-cyan), var(--jazer-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">08</div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">SECS</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Achievements / Milestones -->
      <section class="section" style="padding: 4rem 0; background: rgba(0,0,0,0.3);">
        <div class="container">
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; max-width: 800px; margin: 0 auto;">
            {achievements.map((achievement, index) => (
              <div style="text-align: center;" data-animate="fade-up" data-animate-delay={index * 100}>
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">{achievement.icon}</div>
                <div style="font-size: 1.75rem; font-weight: 900; background: linear-gradient(135deg, var(--jazer-pink), var(--jazer-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">{achievement.title}</div>
                <div style="font-size: 0.875rem; color: var(--text-muted);">{achievement.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Fan Testimonials Carousel -->
      <section class="section" style="padding: 6rem 0;">
        <div class="container">
          <div class="section-header" data-animate="fade-up">
            <h2 class="section-title text-center gradient-text">What Fans Say</h2>
            <p class="section-subtitle">Love from the community</p>
          </div>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 3rem;">
            {testimonials.map((testimonial, index) => (
              <div class="premium-card" style="padding: 2rem;" data-animate="fade-up" data-animate-delay={index * 100}>
                <div style="font-size: 2rem; margin-bottom: 1rem; opacity: 0.3;">"</div>
                <p style="font-style: italic; line-height: 1.6; margin-bottom: 1.5rem;">{testimonial.text}</p>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="font-weight: 600; font-size: 0.875rem;">{testimonial.author}</span>
