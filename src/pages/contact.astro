---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ContactFAQ from '../components/contact/ContactFAQ.astro';
import JoinBeamCTA from '../components/JoinBeamCTA.astro';

const base = import.meta.env.BASE_URL;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;

const announcement = {
  href: `${base}videos`,
  text: '🎬 VISUAL CONTENT COMING 2026 — Join updates for early access'
};
---

<BaseLayout
  bodyClass="contact-page"
  showAnnouncement={true}
  announcement={announcement}
  showNoiseOverlay={true}
  showPreloader={true}
  showNavEnhancements={true}
  showFooter={true}
  showAudioPlayer={true}
  showBackToTop={true}
  includeGsap={true}
>
  <Fragment slot="head">
    <title>Contact - JaZeR</title>
    <meta 
      name="description" 
      content="Get in touch with JaZeR. Send messages, collaboration requests, press inquiries, or just say hello. We typically respond within 3-5 business days." 
    />
    <link rel="canonical" href={canonical} />
  </Fragment>

  <main>
    <ContactHero />
    
    <ContactForm />

    <ContactFAQ />

    <JoinBeamCTA
      sectionStyle="padding: 6rem 0;"
      captureStyle="max-width: 600px; margin: 0 auto;"
      subject="New subscriber from Contact page"
      buttonLabel="Join the Community"
      proofText="Join fans waiting for the launch"
    >
      <Fragment slot="subtitle">
        Stay connected. Be the first to hear new music and get exclusive <strong>behind-the-scenes content</strong>.
      </Fragment>
    </JoinBeamCTA>
  </main>

</BaseLayout>