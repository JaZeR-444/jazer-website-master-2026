  { title: 'Midnight Sessions', type: 'EP', year: '2026', status: 'upcoming', cover: 'gradient-2' },
  { title: 'First Light', type: 'Album', year: '2026', status: 'announced', cover: 'gradient-3' },
  { title: 'Demo Collection', type: 'Compilation', year: '2025', status: 'unreleased', cover: 'gradient-4' }
